<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.mszymanski</groupId>
        <artifactId>orknux-server</artifactId>
        <version>1.1.5</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>orknux-connection</artifactId>

    <!-- Connections, MCP servers and the credentials behind them. Knows nothing
         about teams beyond an id, and nothing about who is asking. -->

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- Building and reading a model provider's request and answer. -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!--
            Talking to a model provider.

            The official OpenAI SDK rather than a hand-built client. Every
            provider this application speaks to answers one of two shapes, and
            the OpenAI one is the shape all but Anthropic use - including Azure,
            which serves it two different ways from one resource and moves the
            details every few months. A URL assembled here encodes whichever way
            was true when it was written and 404s when a resource serves the
            other, which reads as a wrong configuration field and sends whoever
            is debugging to look at something that was never wrong. The SDK is
            updated by the people who change the API; see AGENTS.md.
        -->
        <dependency>
            <groupId>com.openai</groupId>
            <artifactId>openai-java</artifactId>
            <version>${openai.version}</version>
        </dependency>
        <!--
            Talking to a decision model (issue #577).

            TypeSafe publishes SDKs for Python and JavaScript only, and Laya's
            own client is Python, so there is no library to hand the protocol
            to. Spring's RestClient over the documented POST /v1/systemone is
            the next best thing: the request and the status handling are the
            framework's, and the transport is ProxyRouter's own client, so the
            call goes where an administrator allowed it like every other one.
        -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <!--
            Which replica runs what must run once (#597): the timers, the Slack
            sockets. ShedLock's JDBC provider rather than a lock written here,
            because a lease is a protocol with corners - two writers racing for
            an expired row, a holder extending a row it has already lost, whose
            clock the expiry is measured on - and this library has had them
            pointed out for years. ClusterLeader is the only caller, and only of
            lock, extend and unlock.
        -->
        <dependency>
            <groupId>net.javacrumbs.shedlock</groupId>
            <artifactId>shedlock-provider-jdbc-template</artifactId>
            <version>${shedlock.version}</version>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Sending mail. Spring's JavaMailSender is built one server at a
             time here rather than auto-configured from application.yml, because
             the SMTP details belong to a workspace's connection and not to the
             deployment. The starter is on the path for jakarta.mail and
             MimeMessageHelper; no `spring.mail.*` property is set, so Boot
             configures no sender of its own. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- Slack over Socket Mode: an outbound websocket, so no public URL and
             no inbound firewall rule for a development machine to arrange. -->
        <dependency>
            <groupId>com.slack.api</groupId>
            <artifactId>bolt</artifactId>
            <version>${slack.version}</version>
        </dependency>
        <dependency>
            <groupId>com.slack.api</groupId>
            <artifactId>bolt-socket-mode</artifactId>
            <version>${slack.version}</version>
        </dependency>
        <dependency>
            <groupId>javax.websocket</groupId>
            <artifactId>javax.websocket-api</artifactId>
            <version>1.1</version>
        </dependency>
        <dependency>
            <groupId>org.glassfish.tyrus.bundles</groupId>
            <artifactId>tyrus-standalone-client</artifactId>
            <version>1.21</version>
        </dependency>
    </dependencies>

</project>
