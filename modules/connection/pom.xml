<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.mszymanski</groupId>
        <artifactId>orknux-server</artifactId>
        <version>0.9.9.6</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>orknux-connection</artifactId>

    <!-- Connections, MCP servers and the credentials behind them. Knows nothing
         about teams beyond an id, and nothing about who is asking. -->

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- Building and reading a model provider's request and answer. -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!--
            Talking to a model provider.

            The official OpenAI SDK rather than a hand-built client. Every
            provider this application speaks to answers one of two shapes, and
            the OpenAI one is the shape all but Anthropic use - including Azure,
            which serves it two different ways from one resource and moves the
            details every few months. A URL assembled here encodes whichever way
            was true when it was written and 404s when a resource serves the
            other, which reads as a wrong configuration field and sends whoever
            is debugging to look at something that was never wrong. The SDK is
            updated by the people who change the API; see AGENTS.md.
        -->
        <dependency>
            <groupId>com.openai</groupId>
            <artifactId>openai-java</artifactId>
            <version>${openai.version}</version>
        </dependency>
        <!--
            Talking to a decision model (issue #577).

            TypeSafe publishes SDKs for Python and JavaScript only, and Laya's
            own client is Python, so there is no library to hand the protocol
            to. Spring's RestClient over the documented POST /v1/systemone is
            the next best thing: the request and the status handling are the
            framework's, and the transport is ProxyRouter's own client, so the
            call goes where an administrator allowed it like every other one.
        -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Sending mail. Spring's JavaMailSender is built one server at a
             time here rather than auto-configured from application.yml, because
             the SMTP details belong to a workspace's connection and not to the
             deployment. The starter is on the path for jakarta.mail and
             MimeMessageHelper; no `spring.mail.*` property is set, so Boot
             configures no sender of its own. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!--
            Running a command on a machine over SSH.

            Apache MINA SSHD rather than sshj: an Apache Software Foundation
            project under the same licence this is, released regularly, and what
            Gerrit and Jenkins talk SSH with. What decided it is the dependency
            list - sshd-core brings sshd-common and slf4j and nothing else,
            where sshj brings a BouncyCastle requirement, and this application
            has no other reason to put a second cryptography provider on the
            classpath.
        -->
        <dependency>
            <groupId>org.apache.sshd</groupId>
            <artifactId>sshd-core</artifactId>
            <version>${sshd.version}</version>
            <exclusions>
                <!--
                    The one thing it brings that is worth refusing. Spring's own
                    spring-jcl already publishes org.apache.commons.logging, and
                    commons-logging itself is on the path behind another
                    dependency; a third jar carrying those same classes means the
                    logging this application does depends on classpath order,
                    which is the kind of thing that behaves one way here and
                    another way in a container. sshd logs through slf4j directly
                    and needs none of it.
                -->
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>jcl-over-slf4j</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!--
            Ed25519 keys, which is most of the keys anybody has.

            MINA SSHD reads RSA and ECDSA with the JDK's own providers and needs
            help for Ed25519: it will use either this or BouncyCastle, and
            nothing else. That is a real choice rather than a formality. Ed25519
            has been ssh-keygen's default since OpenSSH 9.5, so without one of
            them an administrator pasting the key they actually have is told it
            cannot be read.

            This one over BouncyCastle because of what each costs. This is 85 KB
            with no dependencies of its own, public domain, and registers a JCE
            provider that does Ed25519 and nothing else. BouncyCastle is eight
            megabytes and a general-purpose provider, and putting one of those
            into a process that has none is a change to how every other piece of
            cryptography in this application resolves - for a feature that needs
            one curve. It is worth knowing that this library has not been
            released since 0.3.0 in 2018; it is stable, it does one thing, and it
            is the integration point the Apache project itself names.
        -->
        <dependency>
            <groupId>net.i2p.crypto</groupId>
            <artifactId>eddsa</artifactId>
            <version>${eddsa.version}</version>
        </dependency>

        <!-- Slack over Socket Mode: an outbound websocket, so no public URL and
             no inbound firewall rule for a development machine to arrange. -->
        <dependency>
            <groupId>com.slack.api</groupId>
            <artifactId>bolt</artifactId>
            <version>${slack.version}</version>
        </dependency>
        <dependency>
            <groupId>com.slack.api</groupId>
            <artifactId>bolt-socket-mode</artifactId>
            <version>${slack.version}</version>
        </dependency>
        <dependency>
            <groupId>javax.websocket</groupId>
            <artifactId>javax.websocket-api</artifactId>
            <version>1.1</version>
        </dependency>
        <dependency>
            <groupId>org.glassfish.tyrus.bundles</groupId>
            <artifactId>tyrus-standalone-client</artifactId>
            <version>1.21</version>
        </dependency>
    </dependencies>

</project>
