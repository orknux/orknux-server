<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.mszymanski</groupId>
        <artifactId>orknux-server</artifactId>
        <version>0.9.9.10</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>orknux-app</artifactId>

    <!--
        The deployable: teams, workflow definitions, agents, sign-in and the
        audit log, plus the GraphQL API the browser talks to. It owns the schema
        for every module, because one process means one database and one
        migration history.
    -->

    <properties>
        <start-class>io.mszymanski.orknux.server.OrknuxServerKt</start-class>
        <!-- Where -Pwith-ui takes the built interface from; the submodule's own build output.
             The parent's directory rather than `${project.basedir}/..`: on Linux the
             enforcer's requireFilesExist reports a path with `..` in it missing while
             the file is there, so the image build failed inside Docker. -->
        <orknux.ui.dist>${project.parent.basedir}/orknux-ui/dist</orknux.ui.dist>
        <!-- Which JUnit tags the suite leaves out; see the surefire configuration
             below for what is in `slow` and why. A property rather than a literal
             so that one command line switches it off. -->
        <orknux.test.excluded-groups>slow</orknux.test.excluded-groups>
    </properties>

    <dependencies>
        <!-- Scheduling that survives a restart and fires once across however
             many instances are running: what a scheduled trigger needs.

             The core library, not the Spring Boot starter: the starter's
             auto-configuration is @ConditionalOnBean(DataSource) ordered after
             Boot 3's DataSourceAutoConfiguration, which moved package in Boot
             4, so it evaluates before the datasource exists and never applies.
             TriggerSchedulerConfig builds the scheduler instead. -->
        <dependency>
            <groupId>com.github.kagkarlsson</groupId>
            <artifactId>db-scheduler</artifactId>
            <version>${db-scheduler.version}</version>
        </dependency>

        <dependency>
            <groupId>io.mszymanski</groupId>
            <artifactId>orknux-connection</artifactId>
        </dependency>
        <dependency>
            <groupId>io.mszymanski</groupId>
            <artifactId>orknux-execution</artifactId>
        </dependency>

        <!--
            The SVG renderer, for the RENDER_PNG capability.

            Here rather than in the execution module on purpose: that module is
            the sandbox and knows nothing about what the server can do for a
            plugin, exactly as it knows nothing about Slack. What it holds is
            the door; this is what stands behind it.

            Batik reads an untrusted document format that has a scripting model
            and an external-reference model of its own. Both are switched off
            explicitly where the transcoder is built - see SvgRenderer - rather
            than left to the library's defaults, which have moved between
            versions.
        -->
        <dependency>
            <groupId>org.apache.xmlgraphics</groupId>
            <artifactId>batik-transcoder</artifactId>
            <version>1.19</version>
        </dependency>
        <!--
            The PDF rasteriser, behind the same capability as the SVG one.

            An agent that made a document has no way to look at it: a PDF is
            bytes, and a model that can see reads pictures. This turns a page
            into one, so the thing that wrote the document can check what it
            actually produced rather than describing what it meant to produce.

            PDFBox parses an untrusted document format, so what it is allowed
            to do is pinned where the renderer is built - see PdfRenderer - and
            every document it is handed came from inside this installation.
        -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.5</version>
        </dependency>
        <dependency>
            <groupId>org.apache.xmlgraphics</groupId>
            <artifactId>batik-codec</artifactId>
            <version>1.19</version>
        </dependency>

        <!--
          What draws a diagram, and what lays a page out. Issues #487 and #506.

          Both used to be JavaScript in a sandbox, and both were heroics: the
          mermaid renderer is a hand-written parser that knows five diagram
          kinds, and the PlantUML plugin is PlantUML compiled to JavaScript by
          TeaVM, with an event loop turned by hand after the call returns and
          font metrics answered from Helvetica's advance widths because there is
          no canvas to measure with. Here PlantUML is simply PlantUML, measuring
          text with the JVM's own font stack, and openhtmltopdf lays out real
          CSS into the PDFBox document this build already carries.

          Licences, since both are copyleft and this matters: PlantUML is
          GPL-3.0 and openhtmltopdf is LGPL-2.1-or-later, and Orknux is
          AGPL-3.0, which is written to allow exactly this combination.
        -->
        <dependency>
            <groupId>net.sourceforge.plantuml</groupId>
            <artifactId>plantuml</artifactId>
            <version>1.2025.4</version>
        </dependency>
        <dependency>
            <groupId>io.github.openhtmltopdf</groupId>
            <artifactId>openhtmltopdf-pdfbox</artifactId>
            <version>1.1.28</version>
        </dependency>
        <dependency>
            <groupId>io.github.openhtmltopdf</groupId>
            <artifactId>openhtmltopdf-svg-support</artifactId>
            <version>1.1.28</version>
        </dependency>

        <!--
          What draws a chart. Issue #507.

          lets-plot is MIT and pure Kotlin, and `PlotSvgExportCommon` turns a
          plot specification straight into SVG - no AWT, no Batik, no display.
          That matters twice: this runs in a server with no screen, and the
          answer is vectors, which is what lets a chart go into a page and into
          a PDF rather than being pasted on as a picture.

          The `-jvm` artifacts rather than the multiplatform ones, because there
          is one platform here and the common ones drag a Kotlin/JS tree behind
          them.
        -->
        <dependency>
            <groupId>org.jetbrains.lets-plot</groupId>
            <artifactId>plot-stem-jvm</artifactId>
            <version>4.5.2</version>
        </dependency>
        <!--
          Everything lets-plot needs, named one by one, because its published
          poms declare no dependencies at all - nothing arrives transitively.
          commons carries the geometry and the encoder in the export signature,
          datamodel the SVG tree the export walks, plot-base and plot-builder
          the geometries and the font registry that lay a plot out, and
          kotlin-logging is what its own classes log through.

          Every one of them surfaced only when a test drew something, as a
          NoClassDefFound naming a class nobody asked for - so they are listed
          together rather than discovered one failure at a time. The refusal
          tests passed throughout, because a refusal returns before the library
          is touched, which is the shape that would have let this ship looking
          fine.

          `mu.KotlinLogging` is the microutils package, which is the 3.x line;
          the 5.x releases under io.github.oshai moved it.
        -->
        <dependency>
            <groupId>org.jetbrains.lets-plot</groupId>
            <artifactId>commons-jvm</artifactId>
            <version>4.5.2</version>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.lets-plot</groupId>
            <artifactId>datamodel-jvm</artifactId>
            <version>4.5.2</version>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.lets-plot</groupId>
            <artifactId>plot-base-jvm</artifactId>
            <version>4.5.2</version>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.lets-plot</groupId>
            <artifactId>plot-builder-jvm</artifactId>
            <version>4.5.2</version>
        </dependency>
        <dependency>
            <groupId>io.github.microutils</groupId>
            <artifactId>kotlin-logging-jvm</artifactId>
            <version>3.0.5</version>
        </dependency>

        <!--
          What `orknux.validate` reads a document with. Issue #416.

          Three parsers rather than three hand-written checks: a validator that
          disagrees with the parser everybody else uses is worse than none, and
          each of these is the one its format is actually read by. jsoup is MIT,
          commonmark-java is BSD, snakeyaml comes with Boot and is Apache.
        -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>1.19.1</version>
        </dependency>
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark</artifactId>
            <version>0.29.0</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!--
             The second database. SQLite is a file rather than a server, which is
             the whole of its appeal for somebody who wants to run this without
             also running Postgres. Its schema is a baseline of its own under
             db/migration/sqlite - see the note there for why.
        -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite.version}</version>
            <scope>runtime</scope>
        </dependency>
        <!--
             Hibernate keeps the SQLite dialect in its community module rather
             than the core: best effort, not covered by its own CI. That is worth
             knowing when something behaves oddly here and not on Postgres.

             Compiled against rather than merely present, because OrknuxSqliteDialect
             extends it.
        -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-community-dialects</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-graphql</artifactId>
        </dependency>
        <!--
            Chat history. The store is Spring AI's, keyed by conversation id, so
            the same history a chat keeps is the history a workflow run will hand
            to every agent in it. Flyway owns the table; see V31.
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-chat-memory-repository-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
            Metrics, for whoever is watching this installation from outside it.

            Actuator is what serves them and Micrometer's Prometheus registry is
            what renders them; neither carries a version here, since the BOM
            imported by the parent manages both. Only `/actuator/prometheus` is
            exposed - see the `management` block in application.yml - and it is
            behind the same authentication as everything else unless an operator
            says otherwise. Micrometer's registry bean is also what the counters
            in orknux-execution are registered against.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-ldap</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-ldap</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!--
            OIDC, both ways in: the browser flow that ends in this server's own
            session cookie, and bearer tokens validated per request for callers that
            hold one already. Which of the two an installation uses — or whether it
            uses LDAP instead — is orknux.security.auth-method; the beans are only
            created for OIDC, but the code has to be on the classpath either way.
        -->
        <!--
            Sessions in the database rather than in this process's memory.

            Without it a sign-in lasts exactly as long as the JVM does: every
            restart — a deployment, a config change, a crash — signs everybody out,
            which is a strange thing for a server that already has a database
            attached. It is also what makes more than one instance possible later,
            since a session then belongs to the installation rather than to whichever
            node happened to answer.
        -->
        <dependency>
            <groupId>org.springframework.session</groupId>
            <artifactId>spring-session-jdbc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-graphql-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            The suite gets its own Postgres, thrown away afterwards.

            The fixtures start from a known state by deleting everything, and
            deleteAll() cannot tell whose rows are whose: pointed at the
            development database it takes the workspaces, models and chat
            history somebody was looking at. A container per run cannot reach
            anything but itself. Versions come from Boot's BOM, which is on
            Testcontainers 2 — where the module is `testcontainers-postgresql`
            rather than the `postgresql` of every 1.x example.
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            TestDatabase is a LauncherSessionListener, and surefire only puts
            the launcher on the classpath to run with — compiling against it
            needs it declared.
        -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- For the one test that waits on a scheduler doing its own timing. -->
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The Temporal path is tested here, where there is an application to start. -->
        <dependency>
            <groupId>io.temporal</groupId>
            <artifactId>temporal-testing</artifactId>
            <version>${temporal.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- application.yml carries @project.version@, so it is filtered; the
             delimiter is @ because ${...} is Spring's own placeholder syntax. -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>**/application*.yml</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>**/application*.yml</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <configuration>
                    <delimiters>
                        <delimiter>@</delimiter>
                    </delimiters>
                    <useDefaultDelimiters>false</useDefaultDelimiters>
                </configuration>
            </plugin>
            <!--
                Implementation-Version in the manifest. An update (#584) reads a
                jar's version off the jar itself rather than off whatever name
                it arrived under, and the launcher reads the image's own the
                same way; repackage keeps what this writes.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!--
                        Without spring-boot-starter-parent, surefire passes the
                        classpath in a manifest-only jar, and Spring's config
                        data loader does not see application.yml through it.
                    -->
                    <useManifestOnlyJar>false</useManifestOnlyJar>
                    <!--
                        Tests tagged `slow` are left out of the ordinary run.

                        There is one so far - ShellCodingTaskTest - and what
                        makes it slow is not a sleep to be tuned away: it builds
                        a JDK image, brings up three containers and asks a real
                        model to write an application, which is minutes even
                        when everything goes right. A suite that takes that long
                        is a suite people stop running, and the whole reason
                        this one is worth having is that everybody runs it.

                        Cleared to run them: `./mvnw test -Dorknux.test.excluded-groups=`.
                        Every such test also refuses to run without whatever it
                        needs, so clearing this on a machine that has no model
                        key skips it rather than failing.
                    -->
                    <excludedGroups>${orknux.test.excluded-groups}</excludedGroups>
                    <systemPropertyVariables>
                        <!--
                            The suite runs workflows on the calling thread: a run
                            has finished by the time the call answers, and nothing
                            needs a Temporal server to be up. The Temporal path has
                            its own test, which brings up an in-process environment.
                        -->
                        <orknux.temporal.enabled>false</orknux.temporal.enabled>
                        <!--
                            Credentials are encrypted with this, and the suite
                            stores some. A fixed value rather than the deployment's:
                            the test database is thrown away, nothing it holds
                            outlives the run, and a real key has no business in a
                            build file.
                        -->
                        <orknux.security.secret-key>b3JrbnV4LXRlc3Qta2V5LTMyLWJ5dGVzLWV4YWN0bHk=</orknux.security.secret-key>
                        <!-- No websockets out to Slack from a test run. -->
                        <orknux.slack.enabled>false</orknux.slack.enabled>
                        <!-- No sweep calls a provider while a suite is running. -->
                        <orknux.model.check.enabled>false</orknux.model.check.enabled>
                        <orknux.connection.check.enabled>false</orknux.connection.check.enabled>
                        <!-- No clock re-reads the log levels; LogLevelAPITest calls refresh itself. -->
                        <orknux.logging.levels.follow-enabled>false</orknux.logging.levels.follow-enabled>
                        <!-- No clock deletes a revision mid-suite; RevisionRetentionTest
                             calls the sweep itself. The bean is still built, which is
                             what lets it. -->
                        <orknux.revision.sweep-enabled>false</orknux.revision.sweep-enabled>
                        <!-- And run history, for the same reason: no clock may
                             delete a row while a test is looking at it. The
                             sweeper is still built, so a test can call it. -->
                        <orknux.execution.retention.sweep-enabled>false</orknux.execution.retention.sweep-enabled>
                        <!-- And no clock hands a task to a worker mid-suite;
                             TaskSweepTest calls the sweep itself. Same bargain:
                             the bean is still built, which is what lets it. -->
                        <orknux.task.sweep.enabled>false</orknux.task.sweep.enabled>
                        <!-- The tick is called directly by the test that wants it. -->
                        <db-scheduler.enabled>false</db-scheduler.enabled>
                        <!-- No reminder is announced on a clock; SessionDueSweeperTest calls the sweep itself. -->
                        <orknux.sessions.due-sweep-enabled>false</orknux.sessions.due-sweep-enabled>
                        <!--
                            No test reaches the real npm registry. A host that can
                            never resolve rather than an empty value: empty would
                            switch the feature off, and the tests that matter are
                            the ones that drive it - LibraryRegistryTest points
                            this at a stub of its own on loopback.
                        -->
                        <orknux.library.registry.url>https://registry.invalid</orknux.library.registry.url>
                        <!-- Each distinct set of test properties builds its own
                             context, and each context holds a pool. Ten apiece
                             exhausts Postgres once a development server is up
                             as well, so a test context takes what it needs. -->
                        <spring.datasource.hikari.maximum-pool-size>4</spring.datasource.hikari.maximum-pool-size>
                        <spring.datasource.hikari.minimum-idle>0</spring.datasource.hikari.minimum-idle>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <configuration>
                    <mainClass>${start-class}</mainClass>
                    <!-- The parent skips this goal for every module; this is the one that runs. -->
                    <skip>false</skip>
                </configuration>
                <!--
                    Without spring-boot-starter-parent nothing binds `repackage`
                    for us, so `package` produced a plain library jar with no
                    Main-Class: runnable through spring-boot:run and by nothing
                    else. This is what makes `java -jar` work, which is what the
                    container image runs.
                -->
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            The interface, carried in the jar and served by the server. Issue #585.
            The images build orknux-ui first and package with -Pwith-ui; without it
            the jar serves no interface, which is what tests and spring-boot:run
            want - development has Vite in front of the server. A profile rather
            than always, so a stale orknux-ui/dist left on a machine never ends up
            in a jar nobody asked to carry one.
        -->
        <profile>
            <id>with-ui</id>
            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>interface-bundle</id>
                                <phase>process-resources</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${orknux.ui.dist}</directory>
                                            <filtering>false</filtering>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- A jar that promises the interface and has none is refused here, not in production. -->
                    <plugin>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>interface-bundle-present</id>
                                <phase>validate</phase>
                                <goals>
                                    <goal>enforce</goal>
                                </goals>
                                <configuration>
                                    <rules>
                                        <requireFilesExist>
                                            <files>
                                                <file>${orknux.ui.dist}/index.html</file>
                                            </files>
                                            <message>-Pwith-ui needs the built interface at ${orknux.ui.dist}: run npm run build in orknux-ui first.</message>
                                        </requireFilesExist>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
