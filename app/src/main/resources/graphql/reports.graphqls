# Admin > Reports: how many tokens each person who prompted a model used, across
# the installation. Recorded only while an administrator has usage tracking on;
# what was recorded stays readable after it is switched off.

extend type Query {
    "Whether usage is being tracked, and when that last changed. Administrators."
    usageTracking: UsageTracking!
    """
    Tokens by person over a period, a page at a time; the totals cover every
    person the filter matches, not only the page. `order` is one of NAME,
    SOURCE, SESSIONS, INPUT, CACHED, OUTPUT, COST, LAST_ACTIVE, or left out for
    tokens, biggest first. Administrators.
    """
    usageReport(filter: UsageReportFilter, page: Int, size: Int, order: String, ascending: Boolean): UsageReport!
    """
    One person's sessions over the same period, a page at a time: what they used
    in each, out of what everybody used there. `order` is one of SESSION,
    WORKSPACE, SHARE, COST, LAST_ACTIVE, or left out for their tokens, biggest
    first. Administrators.
    """
    usagePersonSessions(person: String!, filter: UsageReportFilter, page: Int, size: Int, order: String, ascending: Boolean): UsagePersonSessions!
    """
    The same report day by day, every day of the period - a day with nothing
    recorded is there with zeros. The search narrows it to the people it
    matches, as it does the totals. Administrators.
    """
    usageSeries(filter: UsageReportFilter): [UsageDay!]!
}

extend type Mutation {
    "Starts or stops recording who prompted each model call. Off writes nothing at all. Administrators."
    setUsageTracking(enabled: Boolean!): UsageTracking!
}

"Where the person who prompted a model call is known from."
enum PromptSource {
    "A Slack member, on the connection their message came through."
    SLACK
    "A person signed in to Orknux: their chat, or a task they started."
    ORKNUX
    "Nobody: a schedule, a webhook, an API run, a run started by hand."
    NONE
}

type UsageTracking {
    enabled: Boolean!
    "When the switch was last pressed; null if it never was."
    changedAt: String
    changedBy: String
}

input UsageReportFilter {
    "The first day counted, as YYYY-MM-DD; the last 30 days when left out."
    from: String
    "The last day counted, as YYYY-MM-DD, inclusive; today when left out."
    to: String
    workspaceId: ID
    source: PromptSource
    "Over the person alone - their name or id - and the totals follow it."
    search: String
}

type UsageReport {
    inputTokens: Float!
    cachedInputTokens: Float!
    outputTokens: Float!
    "From the prices on each model called, as a decimal; null where none was priced."
    cost: String
    "Whether some call's model had no price, so cost is part of the whole."
    partlyUnpriced: Boolean!
    "How many people the filter matches, Unattributed not counted."
    people: Int!
    sessions: Int!
    "Input and output tokens nobody prompted."
    unattributedTokens: Float!
    "How many rows there are across every page."
    total: Int!
    rows: [UsagePerson!]!
}

"One person's use over the period."
type UsagePerson {
    "What usagePersonSessions takes to name them."
    key: String!
    source: PromptSource!
    "Slack's id for them, or their Orknux username; empty for Unattributed."
    personKey: String!
    "What they were last called, or what Slack calls them now; null where neither is known."
    name: String
    "The connections a Slack member came through, by name, comma separated."
    connectionName: String
    sessions: Int!
    inputTokens: Float!
    cachedInputTokens: Float!
    outputTokens: Float!
    cost: String
    partlyUnpriced: Boolean!
    lastActiveAt: String!
}

"One day of the report, in the server's zone."
type UsageDay {
    "YYYY-MM-DD."
    day: String!
    inputTokens: Float!
    "The part of inputTokens the provider served from its prompt cache."
    cachedInputTokens: Float!
    outputTokens: Float!
    "What the day's calls cost, where any was priced; null where none was."
    cost: String
    "Whether some call that day was on a model with no price."
    partlyUnpriced: Boolean!
    "How many sessions made a model call that day."
    sessions: Int!
    "How many model calls were made that day - every round of every turn."
    calls: Int!
}

type UsagePersonSessions {
    total: Int!
    items: [UsageSessionShare!]!
}

"What one person used in one session, beside what everybody used there."
type UsageSessionShare {
    sessionId: ID!
    "Its title, else its key; null only once the session was removed."
    title: String
    workspaceId: ID!
    "Null once the workspace was removed."
    workspaceName: String
    "Their input and output tokens here."
    tokens: Float!
    "Everybody's, over the same period."
    sessionTokens: Float!
    "What their calls here cost, where any was priced; null where none was."
    cost: String
    "Whether some of their calls here were on a model with no price."
    partlyUnpriced: Boolean!
    "When they last prompted it, in the period."
    lastActiveAt: String
    "Who else prompted it in the period, by name."
    others: [String!]!
}
