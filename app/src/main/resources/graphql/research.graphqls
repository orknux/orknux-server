# Explore > Research: a question researched by one of the workspace's own
# workflows, and the modes that say which. Issue #659.

extend type Query {
    "The workspace's research modes, the three every workspace has first."
    researchModes(workspaceId: ID!): [ResearchMode!]!
    "The workspace's research, newest first."
    researches(workspaceId: ID!, page: Int = 0, size: Int = 20): ResearchPage!
    "One research, with its report; null where it is not there or not the caller's to see."
    research(id: ID!): Research
    "The workspace's documents a research can be pointed at: the readable files on the Artifacts page."
    researchDocuments(workspaceId: ID!, "Words in the name or what the file is; absent is every one." search: String, "How many, newest first; 20 when absent, at most 100." limit: Int): [ResearchDocument!]!
}

extend type Mutation {
    "Writes a research down and starts its mode's workflow; answers at once, with it running."
    startResearch(input: StartResearchInput!): Research!
    "Starts a research on one of a finished research's follow-up questions, with the same mode, model, language, output, sources, images and review, linked back to it."
    startFollowUpResearch(parentId: ID!, question: String!): Research!
    "Takes a research off the list. Its run and its file are kept."
    deleteResearch(id: ID!): Boolean!
    "Runs a finished, failed or stopped research again from one of its steps, the steps before it carried over from its run; the same research, running again. Without a stage, from the step that failed or was cut short."
    restartResearch(id: ID!, fromStage: ResearchStage): Research!
    "A mode of the workspace's own: a name and a workflow, picked or copied from another mode's."
    createResearchMode(input: CreateResearchModeInput!): ResearchMode!
    "Removes a mode somebody added; the three every workspace has are refused."
    deleteResearchMode(id: ID!): Boolean!
}

enum ResearchModeKind {
    SHALLOW
    MEDIUM
    DEEP
    "One somebody added."
    CUSTOM
}

enum ResearchLanguage {
    ACADEMIC
    COLLOQUIAL
    FORMAL
}

enum ResearchOutputFormat {
    PDF
    DOCUMENT
}

enum ResearchStatus {
    RUNNING
    COMPLETED
    FAILED
    STOPPED
}

"Which step of a mode's workflow a research is in: its nodes, left to right."
enum ResearchStage {
    PLAN
    GATHER
    FOLLOW_UP
    WRITE
    "Only where the research asked for a review."
    REVIEW
    SAVE
}

type ResearchMode {
    id: ID!
    kind: ResearchModeKind!
    name: String!
    "Null where the workflow it named is no longer in the workspace."
    workflowId: ID
    workflowName: String
}

type ResearchDocument {
    id: ID!
    name: String!
    description: String!
    contentType: String!
    sizeBytes: Float!
    savedAt: String!
}

type Research {
    id: ID!
    workspaceId: ID!
    question: String!
    modeId: ID
    "As the mode was called when it was started."
    modeName: String!
    workflowId: ID!
    workflowName: String!
    modelId: ID
    modelName: String
    language: ResearchLanguage!
    outputFormat: ResearchOutputFormat!
    websitesInclude: [String!]!
    websitesExclude: [String!]!
    "By name."
    documentsInclude: [String!]!
    documentsExclude: [String!]!
    "Whether it searches the web; off, it read only the documents and the websites to keep to."
    useWebSearch: Boolean!
    "Whether it looks for images to place in the report and keep beside it."
    includeImages: Boolean!
    "The images it kept, numbered as the report places them; each is an artifact of its own."
    images: [ResearchImage!]!
    status: ResearchStatus!
    "The run doing it; null for the moment before it starts."
    executionId: ID
    "The report in markdown, once it is finished."
    result: String
    "Where it has got to: the step, the sub-questions, what was searched; null before it has begun."
    progress: ResearchProgress
    "What it read, numbered as the report cites them."
    sources: [ResearchSource!]!
    "The file the report was saved as, on the Artifacts page; null where it could not be."
    fileName: String
    fileUrl: String
    "The row of the saved artifact the report was kept as; null where it could not be saved."
    artifactId: ID
    "The same artifact as the Artifacts page addresses it - SAVED-70 - for a link that opens it there; null where it could not be saved."
    artifactKey: String
    "Where the file is read rather than saved."
    previewUrl: String
    "Why it did not finish, or why the file could not be made."
    error: String
    startedBy: String!
    "ISO-8601."
    startedAt: String!
    finishedAt: String
    "The runs it was on before executionId, oldest first: a restart moves a research onto a new run."
    earlierExecutionIds: [ID!]!
    "While its writer is writing, the report so far, in markdown; null otherwise. The finished report is result."
    draft: String
    "About how many seconds it has left, measured from the workspace's finished research in the same mode; null when it is not running, there are too few of those, or the list is being read."
    estimatedSecondsLeft: Int
    "Whether a second model reviews the report before it is saved."
    review: Boolean!
    reviewerModelId: ID
    "As the reviewer's model was called when it started."
    reviewerModelName: String
    "What each round of review said, in order; empty where it is not reviewed, or not yet."
    reviewRounds: [ResearchReviewRound!]!
    "The questions it suggests asking next, once it has finished; each starts a research of its own."
    followUps: [String!]!
    "How many it was asked for when it started; null for one started before there were any."
    followUpCount: Int
    "The research it was started from as a follow-up; null where it was not."
    parentId: ID
    parentQuestion: String
    "The research started from it as follow-ups, oldest first; read only on the one opened."
    children: [ResearchChild!]!
}

"A research started from another as a follow-up, as the parent lists it."
type ResearchChild {
    id: ID!
    question: String!
    status: ResearchStatus!
}

"One round of review: the reviewer's verdict and what it found, and whether the writer revised the report for it."
type ResearchReviewRound {
    round: Int!
    "ACCEPT or REVISE."
    verdict: String!
    summary: String!
    issues: [ResearchReviewIssue!]!
    revised: Boolean!
    "How long the report was before the round, and after it where it was revised."
    charactersBefore: Int!
    charactersAfter: Int
}

type ResearchReviewIssue {
    "UNSUPPORTED, MISSING, CITATION, CONTRADICTION, FORMATTING or OTHER."
    kind: String!
    issue: String!
    fix: String!
}

type ResearchProgress {
    "What it is doing now, in a sentence."
    step: String!
    "The parts the question was broken into."
    subQuestions: [String!]!
    "Every query searched so far, in order."
    searched: [String!]!
    "How many levels down it is; 1 is the plan's own queries."
    level: Int!
    sourcesRead: Int!
    "The step doing it; null on a research that ran before the steps were nodes, or in one step of its own."
    stage: ResearchStage
    "The page or document being read this moment, before it is a source; null between reads."
    reading: ResearchReading
}

"A page or document on its way to being a source: one the model notes nothing in never becomes one."
type ResearchReading {
    title: String!
    "An address, or the Artifacts page's link to a document."
    url: String!
    "WEB or DOCUMENT."
    kind: String!
}

type ResearchSource {
    number: Int!
    title: String!
    "An address, or the Artifacts page's link to a document."
    url: String!
    "WEB or DOCUMENT."
    kind: String!
    "What was learnt from it."
    notes: String!
}

"A picture a research kept: fetched once, saved on the Artifacts page, and laid out in the report from there."
type ResearchImage {
    "As the report places it."
    number: Int!
    "Its alt text, its figure's caption, or what the picture search said of it."
    caption: String!
    "Where its bytes were fetched from: an address, or the Artifacts page's link to the document it was in."
    url: String!
    "The page it was found on or for, where that is known."
    page: String
    contentType: String!
    sizeBytes: Float!
    width: Int!
    height: Int!
    "The artifact it was saved as."
    artifactId: ID!
    "Where its bytes are downloaded, on this server."
    fileUrl: String!
    "Where it is shown rather than downloaded."
    previewUrl: String!
}

type ResearchPage {
    content: [Research!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

input StartResearchInput {
    workspaceId: ID!
    question: String!
    modeId: ID!
    "The chat model that plans, reads and writes; a start without one is refused."
    modelId: ID
    language: ResearchLanguage!
    outputFormat: ResearchOutputFormat!
    "Domains or addresses to keep to."
    websitesInclude: [String!]
    "Domains or addresses never to use."
    websitesExclude: [String!]
    "Documents, by id, to read as sources."
    documentsInclude: [ID!]
    "Documents, by id, never to use."
    documentsExclude: [ID!]
    "Whether to search the web; off reads only the documents and the websites to keep to. On when absent."
    useWebSearch: Boolean
    "Whether to look for images, place them in the report and keep each as an artifact. On when absent."
    includeImages: Boolean
    "Whether a second model reviews the report before it is saved. Off when absent; on, reviewerModelId is required."
    review: Boolean
    reviewerModelId: ID
    "How many follow-up questions it suggests once finished, 0 to 10; absent is the workspace's number."
    followUps: Int
    "The research this one follows up, in the same workspace."
    parentId: ID
}

input CreateResearchModeInput {
    workspaceId: ID!
    name: String!
    "The workflow the mode runs."
    workflowId: ID
    "Or another mode, whose workflow is copied for this one."
    copyOfModeId: ID
}
