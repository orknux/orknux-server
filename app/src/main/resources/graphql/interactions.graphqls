# Questions put to a person in a conversation on behalf of something that needs
# a decision before it goes on: an agent asking to expose a port, and whatever
# asks next. A request carries its own options, so a client draws any kind
# from what it is given; `kind` says which server-side handler acts on the
# answer.

extend type Query {
    "The questions asked in a conversation, oldest first."
    sessionRequests(sessionId: ID!): [InteractionRequest!]!
}

extend type Mutation {
    """
    Answers a question with one of its options - `option`, or several in
    `options` where it is `multiple` - and `text` where it `allowsText`.
    Refused with InteractionAlreadyAnswered once it has been,
    InteractionOptionUnknown for an option it does not offer, and
    InteractionAnswerInvalid for an answer of a shape it does not take.
    """
    answerRequest(id: ID!, option: String, options: [String!], text: String): InteractionRequest!
}

type InteractionRequest {
    id: ID!
    "Which handler acts on the answer, such as box.port."
    kind: String!
    "Who is asking: the agent's name."
    askedBy: String
    question: String!
    options: [InteractionOption!]!
    "What it is about, item by item - the tools an agent asks for - drawn as a list under the question; empty for none."
    items: [InteractionItem!]!
    "The id of the option chosen; `settled` when it was decided somewhere else; null while open."
    chosen: String
    chosenBy: String
    chosenAt: String
    "What became of it, in a line, kept up to date when it changes elsewhere."
    outcome: String
    createdAt: String!
    "Whether more than one option may be chosen; `chosen` is then their ids joined by commas."
    multiple: Boolean!
    "Whether the person may answer in their own words; `chosen` is own-words where they chose no option."
    allowsText: Boolean!
    "What the person wrote, where they wrote anything."
    text: String
}

type InteractionOption {
    id: ID!
    label: String!
    "A hint for drawing it: primary, danger, or null."
    style: String
    "What choosing it means, in a line; null for none."
    description: String
}

"One thing a request is about: a tool asked for, with what sort of tool it is and what it does."
type InteractionItem {
    name: String!
    "What sort of thing it is, such as \"plugin tool\"."
    kind: String
    description: String
}
