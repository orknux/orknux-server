type Query {
    """
    Whether this installation is configured correctly, which is a different question
    from whether it can reach things. Administrators only.
    """
    doctor: [DoctorCheck!]!
    "The roles this installation defines. Administrators only, reading included."
    roles: [Role!]!
    role(id: ID!): Role
    "Everybody this installation knows, by name. Administrators only."
    users(search: String): [AppUser!]!
    "The tokens you hold. Never their secrets - those are shown once, when made."
    myTokens: [UserToken!]!
    "One user's tokens. Administrators only."
    userTokens(id: ID!): [UserToken!]!
    user(id: ID!): AppUser
    "One workspace's issues, newest first."
    workspaceIssues(
        workspaceId: ID!,
        status: IssueStatus,
        """
        Which type: absent is every issue, an empty string is the untyped ones,
        an id is that type. One argument with three states, because "nobody has
        said what this is" is a thing a tracker gets asked for and a null
        already means "never mind".
        """
        typeId: ID,
        search: String,
        page: Int,
        size: Int,
        "Newest first when absent."
        order: IssueOrder,
        "Descending when absent."
        ascending: Boolean
    ): IssuePage!
    "One issue, by the number people say - not by its row id."
    workspaceIssue(workspaceId: ID!, number: Int!): Issue
    "Every label in use in this workspace, so a filter can offer what exists."
    workspaceIssueLabels(workspaceId: ID!): [String!]!
    """
    The kinds of thing this workspace files, alphabetically, with how many
    issues carry each.

    Not the same shape as the labels beside it, and deliberately: a label exists
    because an issue holds it, and a type exists because the workspace decided
    it does. That is why this answers rows with ids and that one answers strings.
    """
    workspaceIssueTypes(workspaceId: ID!): [IssueType!]!
    """
    What has happened to one issue, oldest first.

    Its own query rather than a field on the issue: the issue page loads on
    every visit and the history is read only by somebody who opens the tab.
    """
    issueHistory(
        workspaceId: ID!,
        number: Int!,
        "How many of the most recent entries to return. 200 by default, 1000 at most."
        limit: Int
    ): IssueHistory

    "What has happened that concerns you, newest first, across every workspace you can see."
    myNotifications(limit: Int): [Notification!]!
    "How many are waiting, which is all the bell needs to know."
    myNotificationCount: Int!
    "What an issue can be assigned to here: people, agents and models together."
    issueAssignees(workspaceId: ID!, search: String): [Assignee!]!
    """
    What this issue could be linked to, narrowed by what was typed.

    The number first, with or without the hash - issues are referred to by number
    here - and the title search behind it. Nothing already linked is offered, and
    neither is the issue itself.
    """
    issuesToLink(id: ID!, search: String): [IssueRef!]!
    """
    The workspaces, by name.

    `order` is a column of the admin list - NAME, DESCRIPTION - and anything else
    is read as by name. See `workspaceActions`.
    """
    workspaces(page: Int = 0, size: Int = 20, order: String, ascending: Boolean): WorkspacePage!
    workspace(id: ID!): Workspace
    "Audit entries, newest first. Without a workspaceId every visible workspace is included."
    workspaceAudit(
        workspaceId: ID,
        page: Int = 0,
        size: Int = 20,
        search: String,
        category: WorkspaceAuditCategory,
        userId: String,
        "Only entries from the last N days; omit for all time."
        days: Int,
        "A column of the feed - ACTION, USER, AT. Newest first when absent."
        order: String,
        ascending: Boolean
    ): WorkspaceAuditPage!
    "The users who appear in the admin audit log, for the filter."
    auditUsers: [String!]!
    "The health of the service and what it depends on. Administrators only."
    components: [Component!]!
    "The switches that belong to the installation rather than to a workspace."
    installationSettings: InstallationSettings!
    "The plugins loaded into this installation, by name. Administrators only."
    plugins: [Plugin!]!
    """
    What the marketplace offers, as this installation can see it.

    Read through from the marketplace service — this server holds no catalog
    of its own — and answered with `installed` folded in, so one query fills
    the catalog screen. A marketplace that cannot be reached is an error
    rather than an empty list: "nothing is offered" is not something a network
    failure may claim. Administrators only.
    """
    marketplacePlugins: [MarketplaceListing!]!

    """
    Every tool the loaded plugins offer to agents, under their granted names.

    Not an administrator's query, unlike `plugins`: granting a tool to an agent
    is workspace work, so whoever edits an agent can be shown what exists
    without being allowed to see what is loaded.
    """
    pluginTools: [PluginAgentTool!]!
    """
    The libraries loaded into this installation, by name, with what imports them.

    Administrators only, and `usedBy` is why: it names functions and tools across
    every workspace, which is exactly what an administrator deciding whether to
    replace or remove a library needs, and exactly what nobody else should see.
    """
    scriptLibraries: [ScriptLibrary!]!
    """
    Whether a package can be installed here, and where one would come from.

    Administrators only. Asked by the Libraries screen so that an installation
    configured without a registry offers the upload alone: a field offering to
    fetch from a registry that is not there is a field that fails on being used.
    """
    libraryRegistry: LibraryRegistryStatus!
    """
    The libraries a workspace may import, for the editors' picker.

    The same rows without `usedBy`. Not an administrator's query, unlike
    `scriptLibraries`: choosing to import a library belongs to whoever is writing
    the function, and they should not have to be told who else uses it.
    """
    workspaceLibraries(workspaceId: ID!): [ScriptLibrary!]!
    """
    Every loaded plugin, with what this workspace has told it.

    Not an administrator's query, unlike `plugins`: loading a plugin is an
    installation-wide decision, while answering what one needs is a decision
    about the workspace it will run for.
    """
    workspacePlugins(workspaceId: ID!): [WorkspacePlugin!]!
    "What was attached to one chat, oldest first."
    chatAttachments(chatId: ID!): [ChatAttachment!]!
    """
    The admin default connections, by name. Administrators only.

    `order` is a column of the list - NAME, TYPE, URL - and anything else is read
    as by name. See `workspaceActions`.
    """
    connections(page: Int = 0, size: Int = 20, order: String, ascending: Boolean): ConnectionPage!
    """
    The proxy rules, in the order they are consulted. Administrators only.

    Never carries a proxy password; `passwordSet` is all that is said about one.
    """
    proxyRules: [ProxyRule!]!
    """
    The certificate authorities this installation trusts, beyond the JVM's own.

    Administrators only. Trusting an authority changes what every outbound
    connection in the installation will accept, which is not a workspace's
    decision to make on everybody else's behalf.

    Added to what the JVM already trusts, never instead of it, and everything
    else about TLS is unchanged: the hostname is still checked, the chain still
    has to build, and an expired certificate is still expired. There is no
    a trust-everything switch here.
    """
    trustedCertificates: [TrustedCertificate!]!
    "One of them, for the page that edits it. Administrators only."
    trustedCertificate(id: ID!): TrustedCertificate
    """
    Which rule one URL would go through, and which rules it beat to it.

    Answered by the thing that actually routes requests rather than worked out
    beside the screen, so it cannot drift from what a real call would do.
    """
    proxyRoute(url: String!): ProxyRoute!
    """
    The machines this installation can run commands on, by name. Administrators
    only.

    Never carries a private key or its passphrase; `privateKeySet` and
    `passphraseSet` are all that is said about either.
    """
    shells: [Shell!]!
    "One shell. Administrators only, and still without its key."
    shell(id: ID!): Shell
    connection(id: ID!): Connection
    "The connections one workspace holds, ordered by name."
    workspaceConnections(workspaceId: ID!): [WorkspaceConnection!]!
    workspaceConnection(id: ID!): WorkspaceConnection
    """
    Whether a Slack connection can see the user or channel somebody has typed
    into an action's target field.

    It never fails. A name that is wrong, a token that cannot look anything up,
    a Slack that will not answer: each comes back as an `outcome` and a sentence
    to show, so a form can say something useful beside a field without the field
    itself being able to break. `NOT_FOUND` is advice and `UNCHECKED` is not an
    error - read `SlackTargetOutcome` before deciding what a screen does with
    either.

    **It does not gate the save.** `createAction` and `updateAction` do not ask
    this and are not affected by it. `targetName` stays free text, because the
    answers this can give are wrong about a real member often enough that
    refusing on them would cost more than the typos it catches.

    **`target` narrows the question; it is not needed to ask it.** Slack does not
    differentiate when sending - one `chat.postMessage` takes a channel id or a
    user id, because a direct message is a conversation - and the split here only
    ever described which endpoint does the looking up. Omitted, both are asked
    and the answers merged, and `target` on the result says which kind the name
    turned out to be. A caller whose field has no kind set yet asks without one
    rather than asking nothing.

    A merged answer never turns half a search into a verdict: found in either is
    `FOUND`, absent from both is `NOT_FOUND`, and absent from the half that could
    be read while the other was refused is `UNCHECKED` with the refusal's reason.

    One lookup per question, live, with no page after the first and nothing
    cached, so a workspace larger than a single lookup reads comes back
    `UNCHECKED` rather than being ruled on. `slackSuggestions` is the same two
    endpoints read the other way round, and it is cached; this one is not,
    because a name being checked is a name that has just been typed.
    """
    slackTarget(
        "The connection the action sends through."
        connectionId: ID!,
        """
        Which of the two fields is being asked about, or omitted to ask about
        both and be told which it was.

        Omitting it costs a second lookup only for a bare name that could be
        either: a leading "#" or "@", an address, and an id's own first letter
        all settle it for free.
        """
        target: MessageTarget,
        "Exactly what is in the field: \"#general\", \"@alice\", an address, or an id pasted out of Slack."
        name: String!
    ): SlackTargetCheck!
    """
    The users or channels a Slack connection can see that match what somebody
    has typed into an action's target field so far.

    Cheap enough to call on a keystroke: each connection's list is read from
    Slack once and filtered in memory, so this is a lookup in a map and not a
    call to Slack. Neither endpoint takes a search term, which is why the
    filtering is here rather than there.

    It never fails, and it answers in `slackTarget`'s vocabulary. `FOUND` is at
    least one match. `NOT_FOUND` is a list read to the end with nothing in it
    that matches. `UNCHECKED` is no suggestions and the one-line reason -
    usually a bot token with no read scope, sometimes a Slack that is
    rate-limiting, briefly a list still being read - and it is what a picker has
    to draw rather than emptying itself in silence, because a picker with
    nothing in it and nothing said under it reads as a broken connection.

    **It suggests and never gates.** `targetName` is free text and stays free
    text; `createAction` and `updateAction` do not ask this. Anything typed has
    to remain usable whether or not it appears here, and plenty of correct
    values never will: an id pasted out of somebody else's message, a member who
    joined a minute ago, a private channel this bot was never invited to, and an
    archived channel, which is deliberately not offered and still exists.

    **`target` narrows the list; it is not needed to ask for one.** Omitted, one
    list comes back holding channels and members together, each row saying which
    it is in its own `target`, so picking a row settles the kind as well as the
    name. Ordering across the two is unchanged - exact, then what starts with the
    typing, then what contains it - with channels before members where those tie,
    because a channel name means one thing in a Slack and a display name need
    not.
    """
    slackSuggestions(
        "The connection the action sends through."
        connectionId: ID!,
        """
        Which of the two lists to read, or omitted to read both and offer one
        list.

        Omitting it does not read a third list: the two per-connection lists are
        the ones already cached, so a merged question reuses whichever of them
        has been read. A leading "#" or "@" narrows it to that half anyway.
        """
        target: MessageTarget,
        """
        What is in the field so far, with or without its "#" or "@". Empty or
        omitted asks for the first few of everything, which is what a picker
        shows when it opens.
        """
        typed: String
    ): SlackSuggestions!
    "The MCP servers a workspace's agents may connect to, ordered by name."
    mcpServers(workspaceId: ID!): [McpServer!]!
    mcpServer(id: ID!): McpServer
    "The workspace's LLM providers, ordered by name."
    modelProviders(workspaceId: ID!): [ModelProvider!]!
    modelProvider(id: ID!): ModelProvider
    "Every model the workspace may reach, provider first and then name."
    models(workspaceId: ID!): [Model!]!
    model(id: ID!): Model
    """
    What a model has been used for, over a window and against the one before it.

    `days` counts back from today and is what the page opens on. `from` and `to`
    are a range, and win where either is given: `from` alone runs to now, `to`
    alone is the window of `days` ending there, and the two together are the days
    between them - in whichever order they were picked. A range running past
    today is cut off at today. Both are `YYYY-MM-DD`.
    """
    modelUsage(id: ID!, days: Int = 30, from: String, to: String): ModelUsage!
    """
    What the provider itself says it can run, against what has already been added.
    Asks the provider, so it fails the way a connection check fails.
    """
    discoveredModels(providerId: ID!): [DiscoveredModel!]!
    "Workflows assigned to a workspace, by name unless another order is asked for."
    workspaceWorkflows(
        workspaceId: ID!,
        page: Int = 0,
        size: Int = 20,
        "By name when absent."
        order: WorkflowOrder,
        "Ascending when absent, so a column of names reads A to Z."
        ascending: Boolean,
        "Only workflows whose name or description holds this. Absent is all of them."
        search: String
    ): WorkspaceWorkflowPage!
    """
    The workspace's action catalogue: the blocks its workflows are built from.

    `order` is a column of the list - NAME, TYPE, SUBTYPE - and anything else is
    read as the list's usual order rather than refused: a table that will not
    load over an order nobody can see, because it was stored months ago and the
    column has gone, is worse than a table in the wrong order.
    The parameter counts are not orders; they are read off the settings, so
    there is no stored number to sort by.
    """
    workspaceActions(
        workspaceId: ID!,
        page: Int = 0,
        size: Int = 20,
        search: String,
        order: String,
        ascending: Boolean
    ): ActionPage!

    """
    Everything this workspace's runs have produced, newest first.

    A picture an image node drew was reachable only from the run that drew it,
    which is no way to find one afterwards and no way to see what is taking up
    the disk. Listed here instead, with a copy and a delete beside each.
    """
    workspaceArtifacts(workspaceId: ID!, page: Int = 0, size: Int = 20, search: String): ArtifactPage!
    """
    One artifact, by the id the list gave it, or null for one that is not here
    or not yours to see.

    So a link to an artifact is a link: the page opens at one rather than
    opening at the list and being clicked through to it.
    """
    workspaceArtifact(workspaceId: ID!, id: ID!): Artifact

    """
    The "Custom" actions one workflow owns - exactly what workspaceActions
    leaves out. Its editor asks for both.
    """
    workflowOwnedActions(workspaceId: ID!, workflowId: ID!): [Action!]!
    action(id: ID!): Action
    """
    The workspace's conditions: the questions its workflows ask. The shared ones
    only, like the actions above.

    `order` is a column of the list - NAME, TYPE - and anything else is read as
    the list's usual order rather than refused, which is by name. See
    `workspaceActions`.
    """
    workspaceConditions(
        workspaceId: ID!,
        page: Int = 0,
        size: Int = 20,
        search: String,
        order: String,
        ascending: Boolean
    ): ConditionPage!

    """ The "Custom" conditions one workflow owns; see workflowOwnedActions. """
    workflowOwnedConditions(workspaceId: ID!, workflowId: ID!): [Condition!]!
    condition(id: ID!): Condition
    """
    The workspace's JavaScript functions, callable from an action.

    `scope` narrows the list to one origin - the workspace's own rows, or the
    ones the plugins brought - and absent means both, which is what the list
    always showed. `pluginId` narrows further to what one plugin brought, and
    wins over scope.
    """
    workspaceFunctions(
        workspaceId: ID!,
        page: Int = 0,
        size: Int = 20,
        scope: FunctionScope,
        pluginId: ID,
        search: String,
        "A column of the list - NAME, RETURN_TYPE, LAST_MODIFIED. See `workspaceActions`."
        order: String,
        ascending: Boolean
    ): FunctionPage!
    function(id: ID!): Function
    """
    What starts a workspace's workflows.

    `order` is a column of the list - NAME, TYPE, ACTION, STATUS - and anything
    else is read as the list's usual order rather than refused, which is by name.
    Source and Last fired are not orders: one is resolved row by row and the
    other lives in the firing log. See `workspaceActions`.
    """
    workspaceTriggers(
        workspaceId: ID!,
        page: Int = 0,
        size: Int = 20,
        search: String,
        order: String,
        ascending: Boolean
    ): TriggerPage!

    "The \"Custom\" triggers one workflow owns; see workflowOwnedActions."
    workflowOwnedTriggers(workspaceId: ID!, workflowId: ID!): [Trigger!]!
    trigger(id: ID!): Trigger
    "The events this installation can actually deliver; the picker offers these."
    supportedTriggerActions: [TriggerAction!]!
    """
    Which Slack user each of a workspace's Slack connections posts as.

    What the "whose messages does this watch" picker draws: a reply is matched by
    `parent_user_id` against these ids, because a bot token is a Slack user. Two
    connections sharing a token come back as one user twice, and say so.

    It never fails. A connection whose token could not be asked is `UNCHECKED`
    with one line saying why, rather than being left out of the list.
    """
    slackBotUsers(workspaceId: ID!): [SlackBotUser!]!
    "What a trigger has done, newest first — including the firings no run came of."
    triggerFirings(triggerId: ID!, page: Int = 0, size: Int = 20): TriggerFiringPage!
    "What every trigger in one workspace has done, newest first."
    workspaceTriggerFirings(workspaceId: ID!, page: Int = 0, size: Int = 20): TriggerFiringPage!
    """
    Agents configured by a workspace.

    `order` is a column of the list - NAME, DESCRIPTION, STATUS - and anything
    else is read as the list's usual order rather than refused, which is by
    name. See `workspaceActions`.
    """
    workspaceAgents(
        workspaceId: ID!,
        page: Int = 0,
        size: Int = 20,
        search: String,
        order: String,
        ascending: Boolean
    ): AgentPage!
    """
    The JavaScript tools a workspace's agents may call.

    `order` is a column of the list - NAME, DESCRIPTION, STATUS, LAST_MODIFIED -
    and anything else is read as the list's usual order rather than refused,
    which is by name. See `workspaceActions`.
    """
    workspaceTools(
        workspaceId: ID!,
        page: Int = 0,
        size: Int = 20,
        search: String,
        order: String,
        ascending: Boolean
    ): ToolPage!
    tool(id: ID!): Tool
    "The chats the caller holds in this workspace: pinned first, then most recent."
    chatSessions(workspaceId: ID!): [ChatSession!]!
    """
    What can be typed instead of said, for the menu the slash opens.

    Answered by the server rather than written in the interface, because the chat
    is not the only place people type: Slack's own slash commands arrive here with
    nothing of the browser about them. The chat adds its own on top - a new chat,
    the find box - since a Slack message cannot ask for either.
    """
    chatCommands(workspaceId: ID!): [ChatCommand!]!
    "Which of the caller's chats said this; for searching inside them rather than by name."
    chatsMentioning(workspaceId: ID!, text: String!): [ID!]!
    chatSession(id: ID!): ChatSession
    "Everything said in one chat, oldest first, as Spring AI's store kept it."
    chatMessages(id: ID!): [ChatMessage!]!
    "The instruction sets a workspace's agents are guided by; one catalog's when `catalogId` names one."
    workspaceSkills(workspaceId: ID!, catalogId: ID, page: Int = 0, size: Int = 20): SkillPage!
    "The workspace's skill catalogs, by name, each with what it holds."
    skillCatalogs(workspaceId: ID!): [SkillCatalog!]!
    """
    The skill catalogs the loaded plugins bring, one each, named `<key>_plugin`.

    Beside `skillCatalogs` rather than folded into it: these are not rows, so
    there is nothing to rename, delete or add a skill to. What they share with
    a workspace's own is the part an agent's settings page needs — a name to
    grant. A plugin that is switched off, or that declares no skills, offers
    none. Installation-wide, so the workspace is not an argument.
    """
    pluginSkillCatalogs: [PluginSkillCatalog!]!
    skill(id: ID!): Skill
    "The workspace's memory catalogs, by name, each with what it holds."
    memoryCatalogs(workspaceId: ID!): [MemoryCatalog!]!
    memoryCatalog(id: ID!): MemoryCatalog
    "One memory, by id: what the editor opens, whichever page of its catalog it is on."
    memory(id: ID!): Memory
    """
    One page of a catalog. A blank `search` or `author` is no filter rather than
    a search for nothing, so the screen can send what is in its boxes.
    """
    memories(
        catalogId: ID!,
        search: String,
        author: String,
        sort: MemorySort = LAST_MODIFIED,
        page: Int = 0,
        size: Int = 20
    ): MemoryPage!
    "Who has written in this catalog, which is what the author filter offers."
    memoryAuthors(catalogId: ID!): [String!]!
    """
    The workspace's objects: the shapes its workflows pass around.

    `order` is a column of the list - NAME, DESCRIPTION, SOURCE, LAST_MODIFIED -
    and anything else is read as the list's usual order rather than refused,
    which is by name. The field count is the size of a collection, so there is
    nothing to order by and it stays a heading. See `workspaceActions`.
    """
    workspaceObjects(
        workspaceId: ID!,
        page: Int = 0,
        size: Int = 20,
        search: String,
        order: String,
        ascending: Boolean
    ): ObjectPage!
    """
    The shapes the loaded plugins export, available in every workspace.

    Beside `workspaceObjects` rather than among them: a workspace's object is
    something somebody drew and can edit, and a plugin's is replaced the next
    time the plugin is loaded. What they share is the part a reference needs —
    an id to point at, which is why both are rows in the same table.

    A plugin that is switched off still exports its shapes: a property
    pointing at one describes something whether or not the code behind it can
    run, and taking the shape away would break the workflows that named it.
    Installation-wide, so the workspace is not an argument.
    """
    pluginObjects: [WorkflowObject!]!
    """
    One component as the JSON somebody downloads.

    `DEEP` carries everything it reaches — the objects a function is typed
    against, the conditions a composite combines — so the file lands somewhere it
    can be opened. `SHALLOW` carries the one thing, for a workspace that already
    has the rest.

    No ids travel, and no secrets: a variable a function is handed appears under
    `requires` by name and shape, and the target workspace supplies its own. The
    same goes for what an agent thinks with and what an action sends through — a
    model, a connection, an MCP server is written as a name and a type, and what
    it means in the workspace the file lands in is bound there.
    """
    exportComponent(workspaceId: ID!, kind: ComponentKind!, id: ID!, depth: ExportDepth = DEEP): ComponentExport!
    """
    What importing this file into this workspace would do, before it is done.

    Writes nothing. Checked against the workspace exactly as the mutation is, so
    it cannot be used to find out what a workspace one cannot see already holds.

    This is also the binding step, and there is no other: what the file names but
    could never carry comes back as an entry with `external` set and `MISSING`
    against it, and answering means asking again with those answers in
    `bindings`. Ask with none to find out what is wanted; ask with them to find
    out whether anything still is.

    `exclude` leaves components out, and works the same way: name one the file
    carries and ask again. Only what the file carries can be named — an entry
    with `carried` false is a reference, something that has to exist here or be
    bound, and there is nothing in the envelope to leave out. Asking to leave out
    a component something else in the file needs, where this workspace has
    nothing by that name, leaves that one out too, and the one after it: each
    comes back as `EXCLUDE` saying which loss took it, so what it costs is
    visible before anything is written.
    """
    componentImportPlan(
        workspaceId: ID!,
        envelope: String!,
        bindings: [ComponentBindingInput!] = [],
        exclude: [ComponentExclusionInput!] = []
    ): ComponentImportPlan!
    """
    The templates this installation publishes, by name.

    Signed in, and nothing more: a template is published installation-wide on
    purpose, so that one workspace's work is offered to every workspace. Narrow
    it with `holding` to the ones that carry a kind, which is what the Use
    template button on a page of functions asks for.
    """
    componentTemplates(holding: ComponentKind): [ComponentTemplate!]!
    componentTemplate(id: ID!): ComponentTemplate
    """
    The stored file itself. Administrators only.

    Everybody else gets what is inside a template by using it, which creates the
    components in a workspace they may already write to. Handing over the file is
    how a template leaves for another installation.
    """
    componentTemplateEnvelope(id: ID!): String!
    """
    What using this template on this workspace would do, before it is done.

    The same plan an upload shows, from the same reader, because it is the same
    file — a template is a stored envelope and Use template is Import.
    """
    componentTemplatePlan(
        workspaceId: ID!,
        templateId: ID!,
        bindings: [ComponentBindingInput!] = [],
        exclude: [ComponentExclusionInput!] = []
    ): ComponentImportPlan!
    "The workspace's catalogs, by name, each with what it holds."
    variableCatalogs(workspaceId: ID!): [VariableCatalog!]!
    """
    The workspace's variables: named values its functions are handed. A catalogId
    narrows it to one catalog; a blank search is no filter rather than a search for
    nothing. Values are never returned.

    `order` is a column of the list - NAME, DESCRIPTION, TYPE - and anything else
    is read as the list's usual order rather than refused, which is by name. The
    value is not an order: it is a secret more often than not, stored encrypted
    and never handed back. See `workspaceActions`.
    """
    workspaceVariables(
        workspaceId: ID!,
        catalogId: ID,
        search: String,
        page: Int = 0,
        size: Int = 20,
        order: String,
        ascending: Boolean
    ): VariablePage!
    variable(id: ID!): Variable
    workflowObject(id: ID!): WorkflowObject
    agent(id: ID!): Agent
    """
    What a share of a model's context window would work out to, before it is saved.

    Asked of a workspace and a model rather than of an agent, because the form
    setting this may have changed the model in the same edit and a preview read
    off the stored agent would answer for the model it used to have. A null
    share falls through to the workspace's `defaultMemoryShare` and then to the
    built-in allowance, which is what an agent that sets nothing gets; a null
    model is what an agent with none chosen gets.

    It never fails. A share that could not be saved comes back with `refusal`
    set to the sentence `updateAgent` would raise, so a slider can say why
    while it is being dragged.

    `workspaceDefault: true` asks the other question about the same setting:
    what the *workspace's* default would be, for the workspace settings form.
    It is judged on the bounds alone and nothing else, because a workspace
    default is not tied to one model - see `setWorkspaceDefaultMemoryShare` -
    so `modelId` is ignored and the numbers come back as the built-in
    allowance with `derived: false`. To show what that default would mean
    against one particular model, ask this query again without the flag and
    with that model: it is the same question an agent asks, and it comes back
    with the same answer.
    """
    memoryBudget(
        workspaceId: ID!,
        modelId: ID,
        share: Int,
        workspaceDefault: Boolean = false
    ): SessionMemoryBudget!
    """
    One workspace's LLM sessions, most recently spoken in first.

    There is no mutation beside this. A session appears the first time an agent
    records into it and is found by its key afterwards, so what a person does
    with the list is find one and read it.
    """
    llmSessions(
        workspaceId: ID!,
        "Matches the key or the prefix. Absent or empty matches everything."
        search: String,
        page: Int = 0,
        size: Int = 20,
        "Most recently spoken in when absent."
        order: LlmSessionOrder,
        "Descending when absent."
        ascending: Boolean
    ): LlmSessionPage!
    "One session, by the id the list handed over. Null when it is not one you can see."
    llmSession(id: ID!): LlmSession
    """
    One session's transcript, oldest first.

    Its own query rather than a field on the session: a fortnight of conversation
    is more than a page can draw, and the search, the kind filter and the sort
    all belong to the reading rather than to the session.
    """
    llmSessionEvents(
        sessionId: ID!,
        "Matches what was said and who said it. Absent or empty matches everything."
        search: String,
        "Only these kinds. Absent or empty is every kind, not none."
        kinds: [LlmSessionEventKind!],
        page: Int = 0,
        size: Int = 20,
        "By time when absent."
        order: LlmSessionEventOrder,
        "Descending when absent: newest first, which is what a transcript is opened for."
        ascending: Boolean
    ): LlmSessionEventPage!
    """
    A workspace's tasks, newest first.

    What each one has *done* is not here: a task's event log is an LLM session,
    so it is read with `llmSessionEvents` off the session id the task carries.

    `order` is a column of the list - TASK, DOING, STATE, TURNS, STARTED - and
    anything else is read as newest first, which is what this list has always
    been. See `workspaceActions`.
    """
    workspaceTasks(
        workspaceId: ID!,
        "Only tasks in this state. Absent is every state, not none."
        status: TaskStatus,
        page: Int = 0,
        size: Int = 20,
        "Only tasks whose title holds this. Absent is every title."
        search: String,
        order: String,
        ascending: Boolean
    ): TaskPage!
    "One task, by its id. Null when it is not one you can see."
    task(id: ID!): Task
    """
    Everything one issue has started, newest first.

    The link back from an issue to the work being done on it. A field on `Issue`
    instead would be read for every row of a list of twenty in order to draw one
    control on the page showing one. Empty where the issue is not one you can
    see, which reads the same as an issue nothing has been started on - the
    tracker answers that way everywhere.
    """
    issueTasks(issueId: ID!): [Task!]!
    "Everything that happened inside one workspace, newest first."
    workspaceActivity(
        workspaceId: ID!,
        page: Int = 0,
        size: Int = 20,
        search: String,
        category: WorkspaceAuditCategory,
        userId: String,
        "Only entries from the last N days; omit for all time."
        days: Int,
        "A column of the feed - ACTION, USER, AT. Newest first when absent."
        order: String,
        ascending: Boolean
    ): WorkspaceAuditPage!
    "The users who appear in a workspace's audit log, for the filter."
    workspaceActivityUsers(workspaceId: ID!): [String!]!
    "The editable graph of a workflow the workspace has assigned."
    workflowGraph(workspaceId: ID!, workflowId: ID!): WorkflowGraph!
    "What a node would pass if pointed at this action: the seed the editor shows."
    actionParameterDefaults(workspaceId: ID!, actionId: ID!): [NodeMapping!]!
    "What the graph on screen needs, gives and is wrong about, without saving it."
    workflowGraphPreview(workspaceId: ID!, workflowId: ID!, input: WorkflowGraphInput!): WorkflowGraph!
    """
    Every publication of a workflow, newest first: its version history.

    A workflow's versions are what was published, not what was saved - a draft
    is a draft. Without the graphs, which are whole and are fetched one at a
    time by `workflowPublicationGraph`.
    """
    workflowPublications(workspaceId: ID!, workflowId: ID!, limit: Int): [WorkflowPublication!]!
    "One publication's graph, as JSON, as it was published."
    workflowPublicationGraph(workspaceId: ID!, publicationId: ID!): String!
    """
    What a component has been, newest first.

    For the kinds with no draft, where every save is a version. A workflow has
    one, so its history is `workflowPublications` instead.
    """
    componentRevisions(kind: ComponentRevisionKind!, componentId: ID!, limit: Int): [ComponentRevision!]!
    "One revision, with what it held."
    componentRevision(id: ID!): ComponentRevisionDetail!
    """
    Where a component is used: everything that would break if it went away.

    The same set the delete guard refuses on, so a list saying nothing uses this
    and a refusal naming three things cannot both be true. Every row carries an
    id, because being told a name and left to go and find it is what this is for.
    """
    componentDependants(kind: DependencyKind!, componentId: ID!): Dependants!
    "What one run did: the graph as it ran, per-node outcome, and its log."
    execution(id: ID!): ExecutionDetail
    """
    Runs of a workspace's workflows, newest first.

    `order` is a column of the list - RUN, WORKFLOW, STATUS, STARTED, TRIGGER -
    and anything else is read as newest first, which is what this list has always
    been. Duration is not an order: it is the distance between two columns and a
    run still going has only one of them. See `workspaceActions`.
    """
    workspaceExecutions(
        workspaceId: ID!,
        page: Int = 0,
        size: Int = 20,
        status: ExecutionStatus,
        workflowId: ID,
        "Only runs started in the last N days; omit for all time."
        days: Int,
        search: String,
        order: String,
        ascending: Boolean
    ): ExecutionPage!
    """
    Every workflow this workspace has runs of, for the executions filter.

    Read off the runs, not off the workspace's workflow list, so a run of a
    workflow that has since been removed can still be singled out. Each says
    whether the workspace still lists it, because the filter has to show the
    difference rather than hide it.
    """
    executionWorkflows(workspaceId: ID!): [ExecutionWorkflow!]!
}

type Mutation {
    """
    Creates everything an export holds, or nothing at all.

    One transaction. A name already taken here is renamed rather than replaced,
    and everything else in the same file that pointed at it points at the new
    name. A reference the file does not carry and this workspace does not have —
    a variable especially, since values never travel — refuses the whole import,
    saying which. Answers the same plan `componentImportPlan` showed.

    `bindings` says what the file's models, connections and MCP servers mean
    here. One of this workspace's own under the same name needs no binding; a
    name it does not have refuses the import until it is given one. A binding
    naming a row this workspace does not hold is refused rather than ignored,
    and nothing is written.

    `exclude` names components the file carries that this import is not to
    create — and, with them, whatever in the file cannot do without them. Send
    exactly what `componentImportPlan` was sent: the mutation reads the file
    again and reaches the same set, so what was confirmed is what happens.
    Naming something the file does not carry is refused rather than ignored.
    """
    importComponents(
        workspaceId: ID!,
        envelope: String!,
        bindings: [ComponentBindingInput!] = [],
        exclude: [ComponentExclusionInput!] = []
    ): ComponentImportPlan!
    """
    Publishes an exported file as a template. Administrators only.

    A template is installation-wide, so publishing one offers a workspace's work
    to workspaces its author may never see. `envelope` is required here, and is
    read before the row is written: a file this installation cannot read is
    refused at the form rather than at the button somebody presses later.
    """
    createComponentTemplate(input: ComponentTemplateInput!): ComponentTemplate!
    """
    Publishes a component the caller is looking at, exporting it here rather
    than round the browser. Administrator, and the workspace must be visible.

    `input.envelope` is ignored: what is stored is what `exportComponent` would
    have written for the same id and depth.
    """
    saveComponentAsTemplate(
        workspaceId: ID!,
        kind: ComponentKind!,
        id: ID!,
        depth: ExportDepth = DEEP,
        input: ComponentTemplateInput!
    ): ComponentTemplate!
    """
    Renames it, rewords it, or replaces the file. Administrators only.

    Leaving `envelope` out keeps the stored one, so fixing a description cannot
    rewrite what is inside. Replacing it is the only way a template is brought up
    to date: it holds a copy taken when it was published and follows nothing.
    """
    updateComponentTemplate(id: ID!, input: ComponentTemplateInput!): ComponentTemplate!
    """
    Takes it off the list. Administrators only.

    What it already created in the workspaces that used it stays where it is — a
    template is a copy, and removing the thing somebody copied from removes
    nothing they have.
    """
    deleteComponentTemplate(id: ID!): Boolean!
    """
    Creates everything a template holds in this workspace, or nothing at all.

    Checked exactly as an upload is, and it is an upload: the stored envelope
    goes to the same importer, with the same renaming on collision and the same
    refusal for a variable this workspace does not have. Anybody who may write to
    the workspace may use a template.
    """
    useComponentTemplate(
        workspaceId: ID!,
        templateId: ID!,
        bindings: [ComponentBindingInput!] = [],
        exclude: [ComponentExclusionInput!] = []
    ): ComponentImportPlan!
    """
    Takes a plugin out of the installation. Administrators only.

    Loading one is not here: a plugin arrives as a file, so it is uploaded to
    `POST /api/plugins` rather than described as a mutation.
    """
    unloadPlugin(id: ID!): Boolean!
    """
    Switches a plugin off, or back on. Administrators only.

    Off keeps everything and offers nothing — the rows, the edits and every
    workspace's parameter answers stay, while the functions stop being
    callable and the tools leave the agents' menus. It is the reversible half
    of unloading, for a plugin that is misbehaving or not wanted this month.
    """
    setPluginEnabled(id: ID!, enabled: Boolean!): Plugin!
    """
    Installs a plugin from the marketplace, or updates one already installed.

    One mutation for both, because they are one act: the catalog entry is
    fetched and loaded exactly as a load-from-URL is — its libraries fetched
    from beside it, its declaration read from the code — and a plugin already
    loaded under that key is replaced, keeping its edits, its parameter
    answers and its enabled state.

    `accept` is the same comma-separated names-and-paths the upload takes. A
    first install, or one whose demands have grown, comes back with nothing
    installed and the lists to accept; sending them back is the permission.
    Administrators only.
    """
    installMarketplacePlugin(key: String!, accept: String): MarketplaceInstall!
    """
    Takes a library out of the installation. Administrators only.

    Refused while anything imports it, naming what does. Loading one is not here:
    a library arrives as a file, so it is uploaded to `POST /api/libraries`.
    """
    deleteScriptLibrary(id: ID!): Boolean!
    """
    Fetches an npm package and loads what is inside it. Administrators only.

    `spec` is a package and an exact version — `random@4.1.0`. A range and
    `latest` are refused, because a specification that resolves differently
    tomorrow is not an answer to what code is running here.

    The fetch happens once, on the server, into the database, and the file it
    brought back is what is stored and what runs — exactly as an uploaded one is.
    The sandbox gains no network, and an installation configured without a
    registry refuses this and keeps the upload.

    Either spelling. An ES module is run as it stands; a CommonJS entry — `main`,
    the `require` condition of `exports`, a UMD bundle — is given its `module` and
    `exports` as it runs, and the file is stored as the registry served it so the
    hash on the row stays a claim anybody can check.

    A package that is more than one file is neither installed nor refused: it
    comes back as `proposed`, saying what bundling it would mean and which
    packages would go in, and the same call with `bundle: true` does it. The
    permission is not about safety - the archives are fetched and verified either
    way - it is about what the row would be: a bundle is an artefact this server
    assembled, which no registry published and nobody else can hash to the same
    thing.

    Refused, with a sentence saying why, when: nothing the package's `exports`,
    `module` or `main` names is actually in it; a file in it is an ES module,
    which cannot be bundled without transpiling it; two packages in the graph need
    different versions of a third; the file does not hash to what the registry
    said it would; or the registry cannot be reached.
    """
    installScriptLibrary(spec: String!, bundle: Boolean): ScriptLibraryInstall!
    """
    Answers one of a plugin's parameters, for one workspace.

    Exactly one of `literal` and `variableId`: a value typed in, or one of the
    workspace's variables read when the plugin runs. A parameter the plugin
    declared as a secret refuses a literal, because a literal is stored as typed
    and shown back on the page.

    Answers with the whole plugin, so the marks on it and on its parameters come
    from the server rather than from a screen working them out again.
    """
    setPluginParameter(
        workspaceId: ID!,
        pluginId: ID!,
        name: String!,
        literal: String,
        variableId: ID
    ): WorkspacePlugin!
    "Unsets one parameter. A required one is marked as missing again."
    clearPluginParameter(workspaceId: ID!, pluginId: ID!, name: String!): WorkspacePlugin!
    "Turns attachments on or off for the whole installation. Administrators only."
    setAttachmentsEnabled(enabled: Boolean!): InstallationSettings!
    "Turns the chat on or off for the whole installation. Administrators only."
    setChatEnabled(enabled: Boolean!): InstallationSettings!
    """
    Opens the metrics endpoint to callers who have not signed in, or closes it
    again. Administrators only, and recorded in the audit log.

    Turning this on publishes `/actuator/prometheus` to anybody who can reach
    this server's port: how many workspaces exist, how often workflows run and
    how often they fail. Only do it where the scrape crosses a network the
    scraper alone is on. A Prometheus that can send an Authorization header
    should carry an API token instead and leave this off.
    """
    setMetricsAnonymous(enabled: Boolean!): InstallationSettings!
    """
    How many days of component history are kept before the sweep takes it.

    Between 1 and 3650. A version is a whole copy of what a component was, so
    this is the number that decides how much disk the history takes.
    """
    setRevisionRetentionDays(days: Int!): InstallationSettings!
    setExecutionRetentionDays(days: Int!): InstallationSettings!
    """
    How long a task may sit queued before something hands it over again.

    Between 1 and 1440 minutes. Administrators only, and refused outright on an
    installation running Temporal, where this is not set here.
    """
    setTaskSweepMinutes(minutes: Int!): InstallationSettings!
    "How large one of a plugin's source files may be, in KB. Administrators only."
    setPluginMaxSourceKb(kb: Int!): InstallationSettings!
    "How long a plugin may take to load; 1 to 300 seconds."
    setPluginTimeoutSeconds(seconds: Int!): InstallationSettings!
    """
    How many rounds of tool calls an agent gets before it must answer; 2 to 100.

    The installation's number, which every agent follows unless it carries one of
    its own - see `maxRounds` on an agent. Administrators only.
    """
    setChatMaxRounds(rounds: Int!): InstallationSettings!
    """
    The longest an agent may put itself to sleep for; 1 to 86400 seconds.

    An agent ending its turn with a wake-up parks the step, so this says how long
    this installation will hold a run open. Administrators only.
    """
    setAgentSleepSeconds(seconds: Int!): InstallationSettings!
    """
    How many times in a row an agent may do that on one step; 0 to 100.

    Zero takes the wake-up off the tool altogether. Administrators only.
    """
    setAgentSleepTimes(times: Int!): InstallationSettings!
    """
    Whether a conversation may be thrown away. Administrators only.

    False closes the door: `removeLlmSession` refuses in words rather than
    answering false, because false already means there was no such session.
    """
    setSessionsRemovable(removable: Boolean!): InstallationSettings!
    """
    Says which chat uploaded files belong to. Sent when the message is, since a
    first message is what makes the chat.
    """
    attachToChat(chatId: ID!, attachmentIds: [ID!]!): [ChatAttachment!]!
    "Says the notifications waiting have been seen, and answers how many that was."
    readMyNotifications: Int!

    """
    Adds a kind of thing this workspace files. Whoever administers it may.

    Case-insensitively unique: `Bug` and `bug` are one type, since two rows a
    reader cannot tell apart would collect issues between them by accident.
    """
    createIssueType(workspaceId: ID!, name: String!): IssueType!
    """
    Changes what a type is called. Every issue carrying it reads the new word at
    once - which is the point of it being a row - while the history keeps what
    it was called at the time.
    """
    renameIssueType(id: ID!, name: String!): IssueType!
    """
    Takes a type out of the catalogue.

    Refused while issues carry it, and the refusal says how many. Untyping two
    hundred issues on the way is a change nobody asked for and nobody can see
    happen; the way out is to filter for that type, retype what it finds, and
    delete it then.
    """
    deleteIssueType(id: ID!): Boolean!
    createIssue(input: IssueInput!): Issue!
    updateIssue(id: ID!, input: IssueInput!): Issue!
    deleteIssue(id: ID!): Boolean!
    """
    Moves an issue to another workspace, comments, labels, type, links, observers and
    files with it. Needs a role that administers both workspaces, which an
    installation administrator holds everywhere: administering only the source
    would be leave to push an issue into somebody else's tracker, and only the
    destination, leave to pull one out of it.

    Its number changes: numbers are per workspace, so it is given one that is
    free where it is going, and the one it had is free for the next issue filed
    where it came from. References written as `#4` elsewhere are left alone -
    nothing can tell which of them meant this issue - so the move is recorded as
    a comment on the issue saying where it came from, and in the audit of both
    workspaces. Refused rather than fudged where something on it could not exist
    in the destination: an assignee or an observer that is an agent or a model
    of the workspace it is leaving.
    """
    moveIssue(id: ID!, workspaceId: ID!): Issue!
    """
    Adds a comment, and answers with the issue it was added to. Any files given
    were uploaded beforehand and are put on the comment here.
    """
    commentOnIssue(id: ID!, content: String!, attachmentIds: [ID!]): Issue!
    "Changes a comment. Only whoever wrote it may."
    editIssueComment(id: ID!, content: String!): Issue!
    """
    Takes a comment off an issue. Whoever wrote it may, and so may an
    administrator of the workspace - wider than editing, because a removal
    cannot put words in anybody's mouth and this one is written down.

    Really removed, not marked removed: the row goes, its files go with it,
    rows and bytes, and so does the copy of what was said that the bell was
    given. What is left is one line in the issue's history saying a comment by
    somebody was removed, by somebody, and never what it said.
    """
    removeIssueComment(id: ID!): Issue!
    """
    Puts uploaded files on an issue. Sent after it is filed, since a new issue
    has no id while it is still being written.
    """
    attachToIssue(id: ID!, attachmentIds: [ID!]!): Issue!
    "Takes a file off an issue. Only whoever attached it may, administrators included."
    removeIssueAttachment(id: ID!): Boolean!
    """
    Hangs a web address on an issue. Only http and https are kept: a link is
    rendered as an anchor on a page other people click.
    """
    addIssueLink(id: ID!, url: String!, title: String): Issue!
    "Takes a link off an issue. Only whoever added it may, administrators included."
    removeIssueLink(id: ID!): Boolean!
    """
    Says that one issue has something to do with another, in the same workspace.

    The relation is given as the issue named by `id` reads it, and one row is
    stored for the pair however it was said - so it cannot be half made, and
    both issues show it from their own side. Twice the same way does nothing;
    twice a different way is refused, since two issues are connected in one way
    or not at all.
    """
    relateIssue(id: ID!, otherId: ID!, kind: IssueRelationKind!): Issue!
    """
    Takes a link between two issues off, from either end.

    Anybody who can see them, unlike an address or a file: a link is a claim
    about both issues rather than something one person said, and the team at the
    far end never made it.
    """
    unrelateIssue(id: ID!): Boolean!
    """
    Adds an observer, who then hears everything the reporter and the assignee
    hear. Naming nobody means yourself, which anybody in the workspace may do;
    naming somebody else needs a role that administers this workspace. A model
    cannot observe - there is nowhere for a model to read its news.
    """
    observeIssue(id: ID!, observerKind: AssigneeKind, observerId: ID): Issue!
    """
    Takes an observer off again, under the same two rules: yourself always, and
    somebody else with a role that administers this workspace.
    """
    unobserveIssue(id: ID!, observerKind: AssigneeKind, observerId: ID): Issue!
    "Gives an internal user a password. Administrators only."
    setUserPassword(id: ID!, password: String!): AppUser!
    "Changes your own, which needs the current one."
    changeMyPassword(currentPassword: String!, newPassword: String!): Boolean!
    """
    Sets an address. Yours when id is absent; anybody's, for an administrator.
    An empty one clears it and lets the provider seed it again at the next sign-in.
    Allowed for an external user, which is the point: sign-in stops overwriting an
    address somebody has typed.
    """
    setUserEmail(id: ID, email: String): AppUser!
    """
    Turns issue mail on or off. Yours when id is absent; anybody's, for an
    administrator. It only decides whether what the bell already shows is posted
    as well - who hears about an issue is not changed by it.
    """
    setUserEmailNotifications(id: ID, enabled: Boolean!): AppUser!
    """
    Sets the language you read the product in. Yours only - nobody sets somebody
    else's. A BCP-47 tag such as `en` or `pl`; null puts you back to having
    chosen nothing, so the browser's own locale decides again. A tag no
    catalogue was shipped for reads as English.
    """
    setMyLanguage(language: String): AppUser!
    """
    Turns the cost line in your chats on or off. Yours only - it decides what is
    drawn on one person's own screen, on chats nobody else can open, so there is
    no id to pass.
    """
    setChatCostShown(shown: Boolean!): AppUser!
    "Mints a token. Yours when id is absent; anybody's, for an administrator."
    createUserToken(id: ID, name: String!): NewUserToken!
    deleteUserToken(id: ID!): Boolean!
    "Creates an INTERNAL user: an identity managed here. Administrators only."
    createUser(input: UserInput!): AppUser!
    "Edits an INTERNAL user's display name and roles. Administrators only."
    updateUser(id: ID!, input: UserInput!): AppUser!
    createRole(input: RoleInput!): Role!
    "Refused for the built-in administrator role."
    updateRole(id: ID!, input: RoleInput!): Role!
    "Refused for the built-in administrator role, and while a workspace still uses it."
    deleteRole(id: ID!): Boolean!
    createWorkspace(input: CreateWorkspaceInput!): Workspace!
    """
    Saves the workspace settings form. Name and description for anybody who
    administers this workspace; the two role lists for an installation
    administrator only, since whoever edits them decides who else gets in.
    """
    updateWorkspace(id: ID!, input: UpdateWorkspaceInput!): Workspace!
    deleteWorkspace(id: ID!): Boolean!
    "Creates the workflow definition and assigns it to the workspace."
    createWorkflow(input: CreateWorkflowInput!): WorkspaceWorkflow!
    """
    The same workflow again under another name, in the same workspace.

    The graph comes with it: every node with its settings, its mappings and
    where it sits, and every edge with the branch it leaves by. The triggers are
    pointed at rather than copied - two workflows may name one trigger, and a
    duplicated trigger would be a second webhook path nobody asked for.

    **The copy is a draft**, whatever the original was, which is what makes it
    safe to copy a workflow that has triggers on it: an event runs the published
    copy and this has never been published, so nothing starts it until somebody
    publishes it.

    `name` is optional. Left out, it is the original's with *(copy)* after it,
    and a number after that if it is taken - names are unique across the
    installation, so a duplicate that refused on the name would refuse on
    exactly the press somebody makes twice.

    Neither the publications nor the runs are carried: one belongs to the
    workflow that was published, and the other happened to the original.
    """
    duplicateWorkflow(id: ID!, name: String): WorkspaceWorkflow!
    setWorkflowEnabled(id: ID!, enabled: Boolean!): WorkspaceWorkflow!
    "Saves the workflow settings form; the definition is shared by every workspace using it."
    updateWorkflow(id: ID!, input: UpdateWorkflowInput!): WorkspaceWorkflow!
    "Unassigns the workflow from the workspace; the definition is kept."
    removeWorkflow(id: ID!): Boolean!

    """
    Throws a whole conversation away, with everything said in it.

    Nothing creates a session - one appears because a run computed its key - so
    this is not the other half of a create. It is how somebody is rid of a
    conversation that should not have been kept: a mistyped key, or a run they
    were only trying out. False when there was no such session to remove, or
    none this caller can see.
    """
    removeLlmSession(id: ID!): Boolean!
    """
    Sets an agent to work on a problem, on its own, until it is done.

    The same call anything else that starts a task makes - "Start by AI" on an
    issue, and whatever a Designer module turns out to be - which is why it takes
    a link back rather than only a prompt.
    """
    startTask(input: StartTaskInput!): Task!
    """
    "Start by AI": sets the agent an issue is assigned to work on that issue.

    `startTask` underneath, with a prompt composed from the issue - its number,
    title, kind, labels, description and thread - and the issue's id carried
    along, so the task links back and the issue's observers hear what becomes of
    it.

    The issue moves to IN_PROGRESS if it was OPEN, which is written to its
    history and to the workspace's audit log. Nothing moves it back afterwards: a
    task that fails or is stopped leaves the issue where the person who pressed
    this put it, because a machine quietly reopening somebody's issue hours later
    is worse than leaving it.

    Refused where the issue is assigned to a person, a model or nobody, where it
    is closed, and where it already has a task that has not finished - pressing
    it twice must not set two agents on one issue.
    """
    startIssueTask(issueId: ID!): Task!
    """
    Gives a parked task the one thing it asked for, and lets it carry on.

    The grant is written against the task and not against its agent: it lasts as
    long as this task does, it is exactly what was asked for, and it records who
    said yes. There is no way to approve everything.
    """
    approveTaskRequest(id: ID!): Task!
    "Says no. The task carries on without it, or stops and says what it could not do."
    refuseTaskRequest(id: ID!): Task!
    "Answers the question a parked task stopped to ask."
    answerTaskRequest(id: ID!, said: String!): Task!
    """
    Says something to a task, working or finished.

    The other direction from a request. A request is the agent stopping to ask
    and somebody answering; this is nobody having asked - somebody watching the
    work wants it shaped differently, and they say so without stopping the task
    and starting a new one with a better prompt.

    The agent picks it up between the tools it is running, as a turn from
    whoever typed it, and is told to treat it as the newest word on what is
    wanted - so a correction reaches it within seconds rather than at the end of
    a turn. It is still not instant, which is what `TaskMessage.readAt` says and
    why it is there, and a task cannot finish while something said to it is
    unread.

    **A task that has already ended is set working again on it.** Same task,
    same id, same session, so the agent carries on with everything it knew: a
    follow-up is this piece of work continued rather than a new one that has to
    be explained from nothing. The turn and time allowances are taken again from
    the settings as they stand and the counts start from zero, and the outcome
    is cleared - it described work done without knowing what was wanted, and the
    next `task_done` writes the next one. What it said is still in the session.

    Refused on an empty message.
    """
    sendTaskMessage(id: ID!, said: String!): Task!
    """
    Stops it where it stands.

    The turn in flight finishes and no other is taken. Nothing a turn already did
    is undone - a command that has run on a machine has run.
    """
    stopTask(id: ID!): Task!
    "Throws a finished task away, its event log with it. Stop it first."
    deleteTask(id: ID!): Boolean!
    "Replaces the whole graph and puts the workflow back into draft."
    saveWorkflowGraph(workspaceId: ID!, workflowId: ID!, input: WorkflowGraphInput!): WorkflowGraph!
    publishWorkflow(workspaceId: ID!, workflowId: ID!): WorkflowGraph!
    """
    Puts an older publication back into service, by publishing it again.

    The history is not rewritten: this adds an entry saying which older one it
    copied, the way reverting a commit adds one rather than removing it. It
    does not touch the draft, which is not versioned and would have nothing to
    be recovered from.
    """
    restoreWorkflowPublication(workspaceId: ID!, publicationId: ID!): WorkflowGraph!
    """
    Makes an older state of a component current again.

    What it displaces is recorded first, so this is undoable by the same
    button. Answers whether it was done; refetch the component for the rest.
    """
    restoreComponentRevision(id: ID!): Boolean!
    "Creates a catalog: a folder for the workspace's variables."
    createVariableCatalog(workspaceId: ID!, name: String!): VariableCatalog!
    renameVariableCatalog(id: ID!, name: String!): VariableCatalog!
    "Removes an empty catalog; what is in it is removed one variable at a time."
    deleteVariableCatalog(id: ID!): Boolean!
    "Creates a variable. The value is stored encrypted and never read back."
    createVariable(input: CreateVariableInput!): Variable!
    "Saves the variable form. A null value leaves what is stored alone."
    updateVariable(id: ID!, input: UpdateVariableInput!): Variable!
    """
    Answers with what a secret holds, and records that somebody asked. A value
    comes back with the list; a secret only ever comes back through here.
    """
    revealVariable(id: ID!): String
    deleteVariable(id: ID!): Boolean!
    createAgent(input: CreateAgentInput!): Agent!
    """
    Makes an agent out of a model, in one press, from the Models screen.

    Named after the model, and where that name is taken, the same with a number
    after it. Granted nothing at all: no tools, no skills, no MCP servers, no
    catalogues, no shell, no orknux access. Granting is what an agent's settings
    page is for, and this is the bare agent you then dress - which is not a bare
    model, because it has a name, a page, a prompt it can be given, memory, and
    somewhere for every grant to go.

    Refused for a model that does not answer questions, in the same words a task
    refuses one with.
    """
    createAgentForModel(modelId: ID!): Agent!
    "Saves the agent settings form."
    updateAgent(id: ID!, input: UpdateAgentInput!): Agent!
    setAgentEnabled(id: ID!, enabled: Boolean!): Agent!
    deleteAgent(id: ID!): Boolean!
    createTool(input: CreateToolInput!): Tool!
    "Backs the tool editor: the code on the left, the details on the right."
    updateTool(id: ID!, input: UpdateToolInput!): Tool!
    setToolEnabled(id: ID!, enabled: Boolean!): Tool!
    """
    How long one call of this tool may run. Null clears it, which puts the tool
    back on the workspace's number; between 1 and 600 seconds otherwise.
    """
    setToolTimeout(id: ID!, seconds: Int): Tool!
    "Parses the source and says where it broke; the editor's Validate."
    validateToolSource(workspaceId: ID!, source: String!): SourceValidation!
    deleteTool(id: ID!): Boolean!
    "Chooses the model for the workspace's own small jobs. Null clears it."
    setWorkspaceCompanionModel(workspaceId: ID!, modelId: ID): Workspace!
    "Chooses the model the workspace hears with; null takes the microphone away."
    setWorkspaceTranscriptionModel(workspaceId: ID!, modelId: ID): Workspace!
    "Chooses the model the workspace speaks with; null takes the speaker away."
    setWorkspaceSpeechModel(workspaceId: ID!, modelId: ID): Workspace!
    "Chooses the model the workspace draws with; null takes the picture button away."
    setWorkspaceImageModel(workspaceId: ID!, modelId: ID): Workspace!
    """
    When a chat is summarised, how short the summary has to be, and what writes it.

    One mutation for the three because they are one decision: a threshold with no
    summariser does nothing, and a summariser with no threshold is never called.
    `afterTokens` null turns compaction off, which is where every workspace
    starts.

    Refused if the summary is allowed to be as long as the conversation that
    triggers it, which would compact nothing, and refused if the model is not a
    chat model - an image model asked to summarise draws something, and finding
    that out is a compaction that has already thrown the older half away.
    """
    setWorkspaceCompaction(
        workspaceId: ID!,
        afterTokens: Int,
        summaryTokens: Int,
        modelId: ID
    ): Workspace!
    "Chooses the model behind the quick chat; null takes the button away."
    setWorkspaceQuickChatModel(workspaceId: ID!, modelId: ID): Workspace!
    "Whether the quick chat may start things, or only look them up."
    setWorkspaceQuickChatWrites(workspaceId: ID!, allowed: Boolean!): Workspace!
    setWorkspaceChatTimestamps(workspaceId: ID!, shown: Boolean!): Workspace!
    """
    What agents in this workspace are given when they set no share of their own.

    The middle step of three: an agent's own `memoryShare`, then this, then the
    built-in allowance. Null clears it, which puts every agent that sets nothing
    back on the built-in allowance.

    Only the bounds are checked - between 1% and 50% - and the sentence a
    refusal carries is the one `updateAgent` raises, from the same calculation.
    What is not checked here is anything that needs a model, because a default
    is not tied to one: a workspace runs several models whose windows differ by
    an order of magnitude, and refusing a default because the smallest of them
    could not give it would refuse a setting that is right for every other. The
    per-model refusals still apply, against the model an agent really uses,
    where its budget is worked out. Ask `memoryBudget` with `workspaceDefault:
    true` for what this mutation would accept.
    """
    setWorkspaceDefaultMemoryShare(workspaceId: ID!, share: Int): Workspace!
    setWorkspaceTaskMaxTurns(workspaceId: ID!, turns: Int): Workspace!
    """
    How long this workspace's tools and functions may run, where they have no
    timeout of their own. Null clears it, which puts the workspace back on the
    installation's own bound; between 1 and 600 seconds otherwise.
    """
    setWorkspaceFunctionTimeout(workspaceId: ID!, seconds: Int): Workspace!
    "The same, for a tool an agent called. See the fields on Workspace."
    setWorkspaceToolTimeout(workspaceId: ID!, seconds: Int): Workspace!
    """
    Sets how voice mode decides somebody has finished talking, for this
    workspace.

    All three are stated on every call and null clears one, which puts it back
    on voice mode's own value rather than leaving it on whatever was set last —
    the same rule `setWorkspaceDefaultMemoryShare` follows, and what lets a form
    offer "the default" as a thing to choose.

    Each is refused outside its bounds with a sentence naming what is allowed: a
    pause between 1.5 and 10 seconds, a sensitivity between 120% and 600% of the
    room, and an unattended microphone between 5 minutes and an hour.

    Whoever can see the workspace may set it — a workspace setting rather than
    an administrative one — and it is recorded either way.
    """
    setWorkspaceVoiceTurnTaking(
        workspaceId: ID!,
        pauseEndsTurnMs: Int,
        speechOverRoomPercent: Int,
        unattendedMicrophoneMs: Int,
        """
        How long somebody keeps talking over the answer before it stops; 250 to
        3000 ms, or 0 to leave the answer alone.
        """
        bargeInMs: Int
    ): Workspace!
    """
    Where an answer is cut for the speech model here.

    Its own call rather than a fourth argument above, although one card draws
    both: turn-taking is three numbers that are one decision about the half of a
    turn somebody else is talking, and this is about the half the model is.
    """
    setWorkspaceVoiceSpeechChunking(workspaceId: ID!, chunking: SpeechChunking!): Workspace!

    createObject(input: CreateObjectInput!): WorkflowObject!
    "Backs the object editor: the properties on the left, the details on the right."
    updateObject(id: ID!, input: UpdateObjectInput!): WorkflowObject!
    "Refused while another object still points at it."
    deleteObject(id: ID!): Boolean!
    "The editor's Validate: a report, not a failure."
    validateObject(workspaceId: ID!, properties: [ObjectPropertyInput!]!): ObjectValidation!

    createSkillCatalog(workspaceId: ID!, name: String!): SkillCatalog!
    renameSkillCatalog(id: ID!, name: String!): SkillCatalog!
    "Deletes the catalog and the skills in it."
    deleteSkillCatalog(id: ID!): Boolean!

    createMemoryCatalog(workspaceId: ID!, name: String!): MemoryCatalog!
    renameMemoryCatalog(id: ID!, name: String!): MemoryCatalog!
    "Deletes the catalog and the memories in it."
    deleteMemoryCatalog(id: ID!): Boolean!
    createMemory(input: CreateMemoryInput!): Memory!
    updateMemory(id: ID!, input: UpdateMemoryInput!): Memory!
    deleteMemory(id: ID!): Boolean!

    createSkill(input: CreateSkillInput!): Skill!
    "Backs the skill editor: the markdown on the left, the details on the right."
    updateSkill(id: ID!, input: UpdateSkillInput!): Skill!
    setSkillEnabled(id: ID!, enabled: Boolean!): Skill!
    "Checks the frontmatter shape and says where it broke; the editor's Validate."
    validateSkillContent(workspaceId: ID!, content: String!): SourceValidation!
    deleteSkill(id: ID!): Boolean!
    startChat(input: StartChatInput!): ChatSession!
    """
    Runs one of `chatCommands`, as the person who typed it.

    It really does it: `/workflow` starts the workflow, and if that workflow
    messages somebody it messages them. The answer is what the underlying tool
    said, as JSON - the surface that asked decides how to show it, because the
    chat and a Slack channel will not want it shown the same way.
    """
    runChatCommand(workspaceId: ID!, name: String!, argument: String): String!
    renameChat(id: ID!, title: String!): ChatSession!
    setChatPinned(id: ID!, pinned: Boolean!): ChatSession!
    """
    Hands the chat to one of the workspace's agents.

    There is no null, and there is no `chooseChatModel` beside this any more.
    Both said the same thing - take the agent off and leave the model - which is
    a chat on a bare model made in one press. A chat that already answers on a
    bare model is untouched: it still opens, still renders and still answers, and
    this is how it is handed to an agent when somebody wants it to be.
    """
    chooseChatAgent(id: ID!, agentId: ID!): ChatSession!
    "Deletes the chat and the history with it."
    deleteChat(id: ID!): Boolean!
    "Says something and answers it, with the whole thread as context."
    sendChatMessage(id: ID!, text: String!): ChatAnswer!
    "Defines a default connection, assigned to workspaces created from now on."
    createConnection(input: ConnectionInput!): Connection!
    "Also updates the copy held by every workspace provisioned with this default."
    updateConnection(id: ID!, input: ConnectionInput!): Connection!
    "Removes the default; workspaces keep the copy they hold, credentials included."
    deleteConnection(id: ID!): Boolean!
    "Adds a rule sending the URLs it matches through a proxy. Administrators only."
    createProxyRule(input: ProxyRuleInput!): ProxyRule!
    "A null password leaves the stored one alone; an empty one clears it."
    updateProxyRule(id: ID!, input: ProxyRuleInput!): ProxyRule!
    "Turns a rule on or off without opening it."
    setProxyRuleEnabled(id: ID!, enabled: Boolean!): ProxyRule!
    """
    Moves a rule one place in the order, and gives back the whole order.

    The whole order because moving one rule changes what the rules around it do,
    and a screen told only about the one it moved would be showing an order that
    is no longer true.
    """
    moveProxyRule(id: ID!, up: Boolean!): [ProxyRule!]!
    deleteProxyRule(id: ID!): Boolean!
    """
    Trusts a certificate authority across this whole installation.

    Refused if what was pasted is not a certificate this can read, which is
    checked here rather than at the first handshake: a paste that went wrong is
    the ordinary way this fails, and being told on the next connection - as one
    more failure among the ones being debugged - is the worst moment for it.

    `name` is what an administrator calls it. A list of PEM blocks is a list
    nobody can read, and the name is how one is told from another when it comes
    time to take one off.
    """
    trustCertificate(name: String!, pem: String!): TrustedCertificate!
    """
    Renames one, replaces the certificate on it, or both.

    The same row rather than a delete and an add: an authority whose certificate
    was rotated is the same authority, and removing it and adding it back would
    lose the name it was given and the record of who put it there.
    """
    updateTrustedCertificate(id: ID!, name: String!, pem: String!): TrustedCertificate!
    """
    Stops trusting one.

    Takes effect on the next connection rather than at the next restart:
    somebody who removes an authority has decided something, and a client kept
    for the life of the process would go on accepting it.
    """
    untrustCertificate(id: ID!): Boolean!
    "Adds a machine this installation can run commands on. Administrators only."
    createShell(input: ShellInput!): Shell!
    """
    A null private key leaves the stored one alone; an empty one clears it. The
    same rule holds for the passphrase.

    Changing the host or the port forgets the stored host key, since it is no
    longer about the machine this shell now names.
    """
    updateShell(id: ID!, input: ShellInput!): Shell!
    "Turns a shell on or off without opening it."
    setShellEnabled(id: ID!, enabled: Boolean!): Shell!
    """
    Asks a shell now whether it answers, rather than waiting for the sweep.

    The check is a real connection: the handshake, the key accepted, and a
    command actually run. A host that answers on port 22 and refuses every
    account is a failure, which is the case worth catching.
    """
    checkShell(id: ID!): Shell!
    """
    Removes a shell.

    Any sessions still open on it are closed first and their directories
    removed. A machine that will not answer is removed anyway - a page nobody
    can tidy up because the host is already gone would be worse.
    """
    deleteShell(id: ID!): Boolean!
    "Adds a connection that belongs to this workspace alone."
    createWorkspaceConnection(input: CreateWorkspaceConnectionInput!): WorkspaceConnection!
    "Saves the connection settings form; inherited fields are left to the default."
    updateWorkspaceConnection(id: ID!, input: UpdateWorkspaceConnectionInput!): WorkspaceConnection!
    "Clears the workspace's credentials; a workspace-owned connection is removed outright."
    disconnectWorkspaceConnection(id: ID!): Boolean!
    "Calls the service and records what came back, which is what status reports."
    testWorkspaceConnection(id: ID!): WorkspaceConnection!
    "Returns the stored credentials and records that they were revealed."
    revealWorkspaceConnectionSecret(id: ID!): String
    "Returns the stored app-level token and records that it was revealed."
    revealWorkspaceConnectionAppToken(id: ID!): String
    "Returns the stored user token and records that it was revealed."
    revealWorkspaceConnectionUserToken(id: ID!): String
    createMcpServer(input: CreateMcpServerInput!): McpServer!
    updateMcpServer(id: ID!, input: UpdateMcpServerInput!): McpServer!
    """
    Opens a handshake and asks the server for its tools, and says what happened.

    The same two calls an agent makes, so what this proves is what an agent will
    find. A mutation because it is an outbound call somebody asked for, not a
    fact about the workspace to be re-fetched at will.
    """
    checkMcpServer(id: ID!): McpServerCheck!
    """
    Removes the server and takes the grant off every agent that held it.

    The names of those agents come back, so somebody can see what just lost a
    capability; an empty list is a server nobody was granted, and null is a
    server that was not there to remove. Unlike a tool, a skill catalog or a
    memory catalog, this is not refused: what is named is an address somebody
    else runs, so removing the entry once the server is gone is housekeeping.
    Leaving the name on the agents is what is not allowed - register a server
    under it again and every agent still holding it would be handed whatever
    now answers there.
    """
    removeMcpServer(id: ID!): [String!]
    "Returns the stored credentials and records that they were revealed."
    revealMcpServerSecret(id: ID!): String
    createModelProvider(input: CreateModelProviderInput!): ModelProvider!
    updateModelProvider(id: ID!, input: UpdateModelProviderInput!): ModelProvider!
    "Takes the provider's models with it."
    removeModelProvider(id: ID!): Boolean!
    """
    Returns the stored key and records that it was revealed.

    Null for a provider reading a workspace variable: it holds no key, and
    revealing that variable is `revealVariable`, which records the reading
    against the variable rather than against the provider.
    """
    revealModelProviderSecret(id: ID!): String
    "Asks the provider whether it answers, and records what it said."
    testModelProvider(id: ID!): ModelProvider!
    "The model's own details. The form sends all of them, so a null is a cleared field."
    createModel(input: CreateModelInput!): Model!
    updateModel(id: ID!, input: UpdateModelInput!): Model!
    "The Quotas and Limits card, whose fields are saved together. Null is no limit."
    updateModelQuotas(id: ID!, input: ModelQuotasInput!): Model!
    "The Active toggle on the models list."
    setModelEnabled(id: ID!, enabled: Boolean!): Model!
    removeModel(id: ID!): Boolean!
    createFunction(input: CreateFunctionInput!): Function!
    "Saves the function editor: the code, the details and the parameters."
    updateFunction(id: ID!, input: UpdateFunctionInput!): Function!
    "Parses the source and says where it broke; the editor's Validate."
    validateFunctionSource(workspaceId: ID!, source: String!): FunctionValidation!
    """
    Runs the stored function with the arguments given, and says what came back.

    The editor's Run, and the same call an action node makes: the same sandbox,
    the same host-resolved imports and libraries, and the workspace's variables
    appended by the same code. There is no source in this input — what runs is a
    function already saved in the workspace, so this cannot execute anything that
    was not, and whoever may call it could already run it from a workflow.

    Recorded in the workspace's audit, because it is the one execution that
    leaves no run behind it and it reads the workspace's variables.
    """
    runFunction(input: RunFunctionInput!): FunctionRun!
    """
    How long one call of this function may run. Null clears it, which puts the
    function back on the workspace's number; between 1 and 600 seconds otherwise.
    """
    setFunctionTimeout(id: ID!, seconds: Int): Function!
    "Refused while an action still calls it."
    deleteFunction(id: ID!): Boolean!
    createCondition(input: CreateConditionInput!): Condition!
    "Saves the condition builder."
    updateCondition(id: ID!, input: UpdateConditionInput!): Condition!
    "Refused while an action, a node or another condition still uses it."
    deleteCondition(id: ID!): Boolean!
    createAction(input: CreateActionInput!): Action!
    "Saves the action settings form."
    updateAction(id: ID!, input: UpdateActionInput!): Action!
    deleteAction(id: ID!): Boolean!

    """ Gone from the list and gone from the disk. False if there was no such artifact. """
    deleteArtifact(id: ID!): Boolean!
    createTrigger(input: CreateTriggerInput!): Trigger!
    "Saves the trigger settings form."
    updateTrigger(id: ID!, input: UpdateTriggerInput!): Trigger!
    "The toggle in the list; a disabled trigger stays, and stops firing."
    setTriggerEnabled(id: ID!, enabled: Boolean!): Trigger!
    deleteTrigger(id: ID!): Boolean!
    "Runs a workflow the workspace has assigned, with the graph as it stands now."
    startExecution(workspaceId: ID!, workflowId: ID!, input: String): ExecutionDetail!
    "Runs the workflow of an earlier run again."
    rerunExecution(id: ID!): ExecutionDetail!
    """
    Runs the workflow again starting at one of an earlier run's steps, carrying
    what that run had produced by the time it reached it.

    The steps ahead of the chosen one are not performed again: they appear in
    the new run as what they were, marked `carriedOver`. Refused where it
    cannot honestly be done - a step that never ran, a node the graph no longer
    has, a branch the earlier run did not take.
    """
    rerunExecutionStep(id: ID!, nodeKey: String!): ExecutionDetail!
}

type Workspace {
    id: ID!
    name: String!
    description: String
    "The roles that open this workspace. Empty means administrators only."
    roles: [Role!]!
    """
    The roles that also administer it - name, description, observers on its issues
    and moving an issue in or out. A subset of `roles`; empty means installation
    administrators only, which is what every workspace starts as.
    """
    adminRoles: [Role!]!
    """
    Whether the caller administers this workspace. True for an installation
    administrator everywhere, and for anybody holding one of `adminRoles` here -
    so it can differ between two workspaces for the same person, which is the
    whole point of the role.
    """
    administered: Boolean!
    """
    The model used for the workspace's own small jobs — naming a chat from what
    was said. Null means those jobs do not happen.
    """
    companionModelId: ID
    """
    The model the microphone in a chat speaks to. Null means it is not offered,
    which is right where there is nothing to transcribe with.
    """
    transcriptionModelId: ID
    """
    The model that reads an answer aloud. Null means the speaker under one is
    not offered, which is right where there is nothing to read it with.
    """
    speechModelId: ID
    """
    Above how many tokens a chat in this workspace is summarised; null is off.

    A conversation that outgrows its model fails on the next turn, naming a limit
    rather than what to do about it. Above this, everything but the last few
    turns is replaced by one summary of itself - and those messages are gone,
    which is what compacting means and why it is off until somebody asks.
    """
    compactAfterTokens: Int
    "How long that summary may be, in tokens."
    compactionSummaryTokens: Int
    "Which model writes it; null uses the one the chat is held with."
    compactionModelId: ID
    """
    The model that draws a picture for the picture button in a chat. Null means
    the button is not offered, which is right where there is nothing to draw
    with.
    """
    imageModelId: ID
    """
    The model behind the quick chat beside the page. Null means the button is
    not offered.
    """
    quickChatModelId: ID
    """
    Whether the quick chat may start things, or only look them up. False by
    default, including for a workspace that has already chosen a model.
    """
    quickChatMayWrite: Boolean!
    chatShowTimestamps: Boolean!
    """
    What agents here are given when they set no share of their own, as a
    percentage of their model's context window.

    Null means the workspace has decided nothing, and those agents fall through
    to the built-in allowance - which is what every workspace does until
    somebody sets this. An agent with a share of its own never consults it.
    """
    defaultMemoryShare: Int
    """
    How many times a task started here may ask its model before it is stopped.

    One turn is one round of the agent's own tool loop, so this is the outer of
    two counts and not the only ceiling - a task is also stopped once its
    working time is spent.

    Null means the workspace has decided nothing and the installation's own
    number is used, which is where every workspace starts. Read when a task is
    created and copied onto it, so changing this decides what the next task gets
    and leaves the ones already running as they are.
    """
    taskMaxTurns: Int
    """
    What a task here gets when `taskMaxTurns` is null: the installation's own
    number. Sent so a field can show it rather than describe where it lives.
    """
    taskMaxTurnsDefault: Int!
    """
    How long one run of this workspace's functions may hold its thread, in
    seconds, where the function has no timeout of its own.

    A workflow's step, a condition being decided, a webhook answering — every
    place a function runs with nobody in particular waiting on it. A tool an
    agent called is bounded by `toolTimeoutSeconds` instead.

    Null means the workspace has decided nothing and the installation's own
    bound is used, which is where every workspace starts. Read per call, so
    changing this decides the next run and leaves one already going alone.
    """
    functionTimeoutSeconds: Int
    """
    What a run gets when `functionTimeoutSeconds` is null: the installation's
    own bound. Sent so a field can show it rather than describe where it lives.
    """
    functionTimeoutSecondsDefault: Int!
    """
    How long a tool an agent called may hold its thread, in seconds, where the
    tool has no timeout of its own.

    Its own setting because the wait belongs to somebody: a model is stopped
    mid-turn until the tool answers and, in a chat, a person is watching it
    happen. Twenty seconds is patience in a workflow and a failure in a
    conversation.

    Null means the installation's bound, as above.
    """
    toolTimeoutSeconds: Int
    """
    What a tool call gets when `toolTimeoutSeconds` is null: the installation's
    own bound.
    """
    toolTimeoutSecondsDefault: Int!
    """
    How long a pause has to run, after somebody has been talking, before their
    turn ends and what they said is sent.

    Null means the workspace has decided nothing and voice mode uses its own
    pause, which is where every workspace starts. This is the setting that ends
    a turn; the other two decide who counts as talking and when an open
    microphone gives up.
    """
    voicePauseEndsTurnMs: Int
    """
    How far above the room's own noise a sound has to stand to count as a voice,
    as a percentage — 300 is three times the room.

    Lower is more sensitive, and the number to lower for somebody who talks
    quietly or sits far from the microphone. A room is measured as it is heard,
    so this travels between microphones in a way a fixed loudness does not.
    Null means the workspace has decided nothing.
    """
    voiceSpeechOverRoomPercent: Int
    """
    How long an open microphone stays open when nothing else has ended the turn.

    A fuse, not a limit on how much anybody may say: the pause above is what
    ends a turn, and this only fires when no pause ever came — a microphone left
    open in an empty room, or a room noisy enough to read as somebody talking.
    Every value this has held that looked like a reasonable limit turned out to
    cut somebody off mid-sentence, which is why the floor is where it is.
    Null means the workspace has decided nothing.
    """
    voiceUnattendedMicrophoneMs: Int
    """
    How long somebody has to keep talking over the answer before it stops.

    The microphone is held open while an answer is read aloud, so what is said
    over it is already heard - this is whether the answer also stops. A hold
    rather than a level, because what has to be kept out is a short noise: a
    cough, a door, or this application's own voice getting past the echo
    cancellation. Somebody interrupting keeps talking; none of those do.

    Null means the workspace has decided nothing. Zero turns it off.
    """
    voiceBargeInMs: Int
    """
    Where an answer is cut before it is handed to the speech model.

    A value rather than a null, unlike the three above: those store a departure
    from a number the interface owns, and this stores one of three named things
    a listener can ask for. `SENTENCE` unless somebody says otherwise, which is
    what every workspace was doing before this could be said.
    """
    voiceSpeechChunking: SpeechChunking!
}

"""
Where an answer being read aloud is cut for the speech provider.

Reading is pipelined - a piece is asked for, played, and the next made while it
is in the air - and where the cuts fall trades the wait before the first word
against the number of requests and the joins between clips. There is no right
answer to that, which is why a workspace states one.
"""
enum SpeechChunking {
    """
    No cutting: one request for the finished answer, spoken when it is ready.

    The silence before the first word is however long the whole answer takes to
    synthesise. What it buys is one clip with no joins in it, from one request.
    """
    NONE
    """
    Whole sentences, gathered up to about a breath each.

    An answer begins at roughly the speed a person would begin one, because the
    first sentence is in the air while the second is being made.
    """
    SENTENCE
    """
    Paragraph boundaries, and nothing shorter.

    Fewer and longer requests than `SENTENCE`, so fewer joins to hear and less
    pressure on the provider, at the cost of a later first word.
    """
    PARAGRAPH
}

input CreateWorkspaceInput {
    name: String!
    description: String
}

input UpdateWorkspaceInput {
    name: String!
    description: String
    "The roles that open this workspace. Null leaves them alone; empty means administrators only."
    roleIds: [ID!]
    """
    The roles that also administer it, which has to be a subset of `roleIds`. Null
    leaves them alone; empty means installation administrators only. Only an
    installation administrator may change either list - a workspace administrator
    editing the name sends back what they were shown, and that is not a change.
    """
    adminRoleIds: [ID!]
}

"A slice of workspaces, ordered by name."
type WorkspacePage {
    content: [Workspace!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

input CreateWorkflowInput {
    workspaceId: ID!
    name: String!
    description: String
}

input UpdateWorkflowInput {
    name: String!
    description: String
}

enum WorkflowStatus {
    DRAFT
    PUBLISHED
}

"Which side of a node its input and output sit on. Layout only; it changes nothing about what runs."
enum NodeOrientation {
    LEFT_TO_RIGHT
    TOP_TO_BOTTOM
    RIGHT_TO_LEFT
    BOTTOM_TO_TOP
}

enum NodeKind {
    TRIGGER
    AGENT
    "An instance of one of the workspace's actions."
    ACTION
    "Asks one of the workspace's conditions; the run stops when it does not hold."
    CONDITION
    "Makes an object out of what the run is carrying, and hands it on."
    OBJECT
    "Draws a picture from a prompt, with one of the workspace's image models."
    IMAGE
    """
    Names an LLM session the agent nodes wired to it talk into.

    A declaration rather than a step: nothing runs it, and it produces nothing a
    later node can read. It carries `sessionKey` and the optional
    `sessionKeyPrefix`, and an edge from it to an agent is what says that agent
    writes into that conversation.
    """
    SESSION
}

type WorkflowNode {
    "Stable within a workflow; what edges refer to."
    key: String!
    kind: NodeKind!
    name: String!
    description: String
    "The agent an agent node instances."
    agentId: ID
    "The trigger definition a TRIGGER node instances, if it names one."
    triggerId: ID
    "The action an ACTION node instances, if it names one."
    actionId: ID
    "The condition a CONDITION node asks, if it names one."
    conditionId: ID
    "The saved shape an OBJECT node makes; null is a shape of the node's own."
    objectId: ID
    """
    The shape an AGENT node's answer is held to; null is prose.

    Chosen, the model is asked for a JSON object matching that shape, the
    runner checks the answer against it, and an answer that does not comply is
    retried under the node's own policy - so what a later node reads is the
    object, fields and all.
    """
    outputObjectId: ID
    """
    The object node this agent's answer is saved into, by that node's key.

    The other way to shape an answer: the shape above is then derived from the
    target at every save, and the target's unmapped fields are filled from the
    answer when the run reaches it. The editor draws it as a dependency line.
    """
    outputNodeKey: String
    "The image model an IMAGE node draws with, if it names one."
    imageModelId: ID
    """
    What this node calls what it produces, so a later node can point a
    reference at it. Null hands the output on unchanged.
    """
    outputName: String
    "Which icon the canvas draws on this node; a name from the interface's own set."
    icon: String
    "Which way round the node faces on the canvas; null is left to right."
    orientation: NodeOrientation
    """
    What a node's two ways out are called; null leaves it to the interface,
    which says Yes and No for a condition and "If works" / "If fails" for a node
    that handles its own failure.
    """
    yesLabel: String
    noLabel: String
    """
    Whether this node has a second way out for the case where it fails.

    On, the node has a FAILURE handle to draw from, and a run that could not do
    the work follows that edge instead of stopping. Off — and on every kind but
    ACTION and AGENT — a failure ends the run exactly as it always has.
    """
    fallbackEnabled: Boolean!
    "How many times in all a run may attempt this node; null is once."
    retryAttempts: Int
    "The wait before the second attempt, in seconds; null is none."
    retryBackoffSeconds: Int
    "What that wait is multiplied by after each attempt; null is a wait that does not grow."
    retryMultiplier: Float
    "The most any one wait may come to, in seconds; null is the engine's own hour."
    retryMaxWaitSeconds: Int
    "The fraction of a wait that may be taken off it at random; null is none."
    retryJitter: Float
    "The longest this node may go on being attempted for, in seconds; null is no limit."
    retryBudgetSeconds: Int
    x: Float!
    y: Float!
    "What the node needs, read off whatever it points at."
    inputs: [ActionParam!]!
    "What it hands on."
    outputs: [ActionParam!]!
    """
    What this node passes to its action, one entry per parameter that action
    has. Seeded from the action when the node first points at one and owned by
    the node afterwards: editing these never changes the definition.
    """
    mappings: [NodeMapping!]!
}

"Whether a parameter holds something written or something read from the run."
enum MappingMode {
    VALUE
    REFERENCE
}

"One parameter of a node, and what fills it."
type NodeMapping {
    name: String!
    "The written value, or the field a reference reads — `reply`, `trigger.channel`."
    expression: String!
    mode: MappingMode!
    "Which node produces the referenced field; what the canvas draws a line from."
    sourceNodeKey: String
    """
    What this field holds, where the node is the one naming it.

    An Object node with no saved shape carries fields of its own, and this is
    what one of them is - the same three parts a saved object's property has,
    because it is the same question asked in the other place a field is named.
    Null everywhere else: a parameter belonging to a function or a condition is
    typed by the definition it belongs to.
    """
    fieldKind: PropertyKind
    "What a list holds, where the kind is ARRAY and it holds scalars."
    fieldElementKind: PropertyKind
    "The object it points at, where it is one of those or a list of them."
    fieldRefObjectId: ID
}

"Which way out of a node an edge leaves by."
enum EdgeBranch {
    "A condition's two answers."
    YES
    NO
    """
    The way out an action or an agent takes when it could not do its work.

    Only the exception is marked: the happy path stays the unmarked edge it has
    always been, so switching a fallback on adds an edge rather than rewriting
    the one already drawn.
    """
    FAILURE
}

type WorkflowEdge {
    source: String!
    target: String!
    "The answer this edge carries; null for every edge that is not leaving a condition or handling a failure."
    branch: EdgeBranch
}

"""
Which kinds of component have a history, and where it is kept.

The rule behind the split: a kind with a draft is versioned by publishing, and
a kind without one by saving. WORKFLOW is the only one with a draft today, so
it is the only one whose history is its publications - it appears here so that
the vocabulary is one vocabulary, and never in `componentRevisions`.
"""
enum ComponentRevisionKind {
    FUNCTION
    TOOL
    SKILL
    AGENT
    WORKFLOW
}

"One line of a component's history: what it was, and when it stopped being it."
type ComponentRevision {
    id: ID!
    kind: ComponentRevisionKind!
    componentId: ID!
    "What it was called then, so a rename reads as one."
    name: String!
    "When this state was saved - the component's own stamp, not this row's."
    savedAt: String!
    savedBy: String!
    "When it stopped being current, which is what retention counts from."
    recordedAt: String!
}

"One revision with what it held."
type ComponentRevisionDetail {
    id: ID!
    kind: ComponentRevisionKind!
    componentId: ID!
    name: String!
    savedAt: String!
    savedBy: String!
    recordedAt: String!
    """
    The part somebody reads: a function's or a tool's TypeScript, a skill's
    markdown, an agent's system prompt. Null where this kind has none.
    """
    content: String
    "`typescript`, `markdown` or `json`: what to colour `content` as."
    contentLanguage: String!
    "The whole component as it was, as JSON."
    snapshot: String!
}

"""
What a dependency question is asked about, and what an answer may name.

One vocabulary for both ends of the arrow: a function is asked about, and a
function is also an answer, because a function imports another one.

Not `ComponentKind`. That one is what an envelope can carry, and it is short for
a reason - a variable, a library and a connection all hold something that cannot
travel. This one is what can point at what, and those three are exactly the
interesting cases.

`WORKFLOW`, `CONNECTION` and `MODEL_PROVIDER` are only ever answers: nothing in
this product points at one, so asking about them is refused rather than answered
with an empty list, which would read as "nothing uses it".

`MCP_SERVER` was among them and is not any more. An agent names a server in its
grants, and removing the server takes that capability away from every agent
holding it, so there is a real answer to give and it was worth giving.
"""
enum DependencyKind {
    OBJECT
    FUNCTION
    CONDITION
    TOOL
    "The folder, because the folder is what an agent is granted."
    SKILL_CATALOG
    "The folder, for the same reason."
    MEMORY_CATALOG
    ACTION
    TRIGGER
    AGENT
    WORKFLOW
    VARIABLE
    LIBRARY
    CONNECTION
    "An agent is granted one by name, which is what asking about it answers."
    MCP_SERVER
    MODEL_PROVIDER
}

"One thing that depends on a component, and where to open it."
type Dependant {
    kind: DependencyKind!
    id: ID!
    name: String!
    "Null for a function the organisation owns, which belongs to no workspace."
    workspaceId: ID
    workspaceName: String
    """
    Whether this names the published copy rather than the drawn one.

    Only a workflow ever sets it, and it changes what has to be done about it: a
    draft is redrawn, a publication is republished.
    """
    published: Boolean!
}

"""
Where a component is used, as far as this reader may be told.

`hidden` is the half that is neither a leak nor a lie. A library belongs to the
installation and the functions importing it live in workspaces the reader may
not be able to open; naming one of those says that a workspace exists and what
is in it, and dropping it silently answers the question with rows missing. So it
is counted instead. Every workspace-scoped component answers zero - the reader
had to be able to see the workspace to ask at all.
"""
type Dependants {
    entries: [Dependant!]!
    hidden: Int!
}

"""
One publication of a workflow: a version of it, and possibly the live one.

Without the graph. A history is a list somebody scrolls, and every row carrying
a serialised graph would be a page measured in megabytes.
"""
type WorkflowPublication {
    id: ID!
    workflowId: ID!
    publishedAt: String!
    publishedBy: String!
    "The one the runner reads. Exactly one publication of each workflow is."
    current: Boolean!
    "The publication this one copied, when it was made by restoring one."
    restoredFrom: ID
}

type WorkflowGraph {
    workflowId: ID!
    name: String!
    description: String
    status: WorkflowStatus!
    "Whether the workspace has it switched on. Off means nothing starts it by itself; Run still does."
    enabled: Boolean!
    assignmentId: ID
    nodes: [WorkflowNode!]!
    edges: [WorkflowEdge!]!
    "What the graph is missing, worst first; empty when it holds together."
    problems: [GraphProblem!]!
}

"How much a problem matters: an error is refused on save, a warning is advice."
enum GraphProblemSeverity {
    ERROR
    WARNING
}

type GraphProblem {
    severity: GraphProblemSeverity!
    "The node it is about; an edge is reported against the node it reaches."
    nodeKey: String!
    message: String!
}

input WorkflowNodeInput {
    key: String!
    kind: NodeKind!
    name: String!
    description: String
    "The agent an agent node instances."
    agentId: ID
    "The trigger definition a TRIGGER node instances; ignored on any other kind."
    triggerId: ID
    "The action an ACTION node instances; ignored on any other kind."
    actionId: ID
    "The condition a CONDITION node asks; ignored on any other kind."
    conditionId: ID
    "The saved shape an OBJECT node makes; null is a shape of the node's own."
    objectId: ID
    "The shape an AGENT node's answer is held to; null is prose. Ignored on any other kind."
    outputObjectId: ID
    """
    The object node this agent's answer is saved into, by key. The shape is
    then derived from the target, overriding outputObjectId sent beside it.
    Ignored on any other kind.
    """
    outputNodeKey: String
    "The image model an IMAGE node draws with; ignored on any other kind."
    imageModelId: ID
    "What this node calls what it produces; a later node points a reference at it."
    outputName: String
    "Which icon the canvas draws on this node; a name from the interface's own set."
    icon: String
    "Which way round the node faces on the canvas; null is left to right."
    orientation: NodeOrientation
    """
    What a node's two ways out are called; null leaves it to the interface.
    Kept on a condition, and on an action or agent with `fallbackEnabled`;
    dropped on the rest, which have only one way out to name.
    """
    yesLabel: String
    noLabel: String
    """
    Whether this node has a second way out for the case where it fails; kept on
    an ACTION and on an AGENT, ignored on every other kind.

    Sending true is the whole of "fallback enabled": the node grows a FAILURE
    handle, and an edge sent with `branch: FAILURE` is what a run follows when
    the node could not do its work. A FAILURE edge out of a node that does not
    have this set is refused — nothing would ever leave by it.
    """
    fallbackEnabled: Boolean = false
    """
    How many times in all a run may attempt this node; null or 1 is once.
    Held between 1 and 10, and kept on an ACTION and on an AGENT only.

    A failure the runner has already settled — a channel that does not exist, a
    request refused for what it said, a model that answered 400 — is never
    attempted again whatever this says. A model that timed out, was rate
    limited, or answered 5xx is not settled, and is asked again.
    """
    retryAttempts: Int
    """
    The wait before the second attempt, in seconds; null is none. Held between 0
    and 3600. At a multiplier of one it is the whole wait, before every retry.
    """
    retryBackoffSeconds: Int
    """
    What that wait is multiplied by after each attempt; null or 1 is a wait that
    does not grow. Held between 1 and 10, and kept only where there is a second
    attempt for it to sit between, on an ACTION or an AGENT.

    One is what a fixed wait always was and 2 is the doubling that used to be a
    word; 1.5 is the curve neither could say. However steep it is, one wait is
    capped at an hour where it is spent — ten attempts at ×2 off the largest
    first wait this takes would otherwise be three weeks of run.
    """
    retryMultiplier: Float
    """
    The most any one wait may come to, in seconds; null is the engine's own hour,
    which no wait passes whatever this says. Held between 1 and 3600, and kept
    only where the multiplier is above 1 — under a wait that never grows a
    ceiling does not bound it, it shortens it.
    """
    retryMaxWaitSeconds: Int
    """
    The fraction of a wait that may be taken off it at random; null or 0 is none,
    and 1 draws each wait uniformly from nothing up to what the curve asked for.
    Held between 0 and 1.

    Downward only, so every other number here stays the upper bound it reads as.
    What it is for is the many runs that failed on one outage and would otherwise
    all come back at the same instant.
    """
    retryJitter: Float
    """
    The longest this node may go on being attempted for, in seconds, work
    included; null is no limit beyond the attempts. Held between 1 and 86400.

    The bound the waits cannot express between them: what happens between two of
    them is a call to something outside this installation, and how long that
    takes is in none of the other numbers. A node that reaches it stops there,
    with the attempts it had left unspent.
    """
    retryBudgetSeconds: Int
    """
    What this node passes to its action. Omitted leaves it to the action's own
    suggestions, which is what a node freshly pointed at one wants. Names the
    action does not have are dropped; ones it has and this omits are seeded.
    """
    mappings: [NodeMappingInput!]
    x: Float!
    y: Float!
}

input NodeMappingInput {
    name: String!
    expression: String!
    mode: MappingMode = VALUE
    sourceNodeKey: String
    "What the field holds, where the node names its own. See `NodeMapping`."
    fieldKind: PropertyKind
    fieldElementKind: PropertyKind
    fieldRefObjectId: ID
}

input WorkflowEdgeInput {
    source: String!
    target: String!
    """
    Which way out of its source this edge leaves by. YES or NO out of a
    condition, FAILURE out of an action or agent with `fallbackEnabled`, and
    null for everything else — including the happy path, which stays unmarked.
    """
    branch: EdgeBranch
}

input WorkflowGraphInput {
    nodes: [WorkflowNodeInput!]!
    edges: [WorkflowEdgeInput!]!
}

enum ExecutionStatus {
    RUNNING
    COMPLETED
    FAILED
}

enum ExecutionTrigger {
    WEBHOOK
    MANUAL
    SCHEDULE
    API
}

type Execution {
    id: ID!
    workflowId: ID!
    workflowName: String!
    status: ExecutionStatus!
    "Set when a condition ended the run early; null for an ordinary finish."
    stoppedReason: String
    trigger: ExecutionTrigger!
    "ISO-8601 offset date-time."
    startedAt: String!
    finishedAt: String
    "Null while the run is still going."
    durationSeconds: Int
    """
    Whether this workspace still lists the workflow this run named.

    False for a run whose workflow has been removed: the run is kept and still
    opens, but there is no workflow page to send anybody to.
    """
    workflowAssigned: Boolean!
}

"A workflow the executions list can be filtered by: one this workspace has runs of."
type ExecutionWorkflow {
    workflowId: ID!
    "The name its most recent run recorded, which for a removed one is all there is."
    name: String!
    "False for one this workspace has removed."
    assigned: Boolean!
}

type ExecutionPage {
    content: [Execution!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

"The most recent run of a workflow, so the list shows where it got to."
type LastRun {
    executionId: ID!
    status: ExecutionStatus!
    "ISO-8601 offset date-time."
    startedAt: String!
    durationSeconds: Int
}

"A workflow as it appears for one workspace."
type WorkspaceWorkflow {
    "Identifies the assignment, not the definition."
    id: ID!
    workflowId: ID!
    name: String!
    description: String
    "Off means no trigger, schedule or tool call starts it. Run still does."
    enabled: Boolean!
    "Where it last got to; null until it has run."
    lastRun: LastRun
    "When a scheduled trigger will start it next, ISO-8601; null when nothing schedules it or it is switched off."
    nextRun: String
}

"What a list of workflows is ordered by."
enum WorkflowOrder {
    "By name, which is how a catalogue is read."
    NAME
    """
    By when it last started a run. A workflow nobody has ever run has no answer
    here and sorts last, whichever way round.
    """
    LAST_RUN
    "By whether the workspace has it switched on."
    ENABLED
}

type WorkspaceWorkflowPage {
    content: [WorkspaceWorkflow!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

"There is one kind of agent; every agent may call tools, and which ones is configured per agent."
enum AgentType {
    LLM
}

type Agent {
    id: ID!
    workspaceId: ID!
    name: String!
    type: AgentType!
    description: String
    systemPrompt: String
    enabled: Boolean!
    "The model this agent thinks with. Null when none has been chosen."
    modelId: ID
    "What that model is called, or null when it has been removed."
    modelName: String
    "MCP servers this agent may connect to."
    mcpServers: [String!]!
    """
    Whether it may ask orknux about orknux — the built-in server, which is not
    one of the workspace's own and never appears among them.
    """
    orknuxAccess: Boolean!
    """
    Whether it may open a shell on one of the installation's machines and run
    commands there.

    Plural and unnamed: an agent asks for a shell rather than for a particular
    host, and which one a session lands on is decided when it opens.
    """
    shellAccess: Boolean
    "Whether it may keep a file it made, on the workspace's Artifacts page. On by default."
    artifactAccess: Boolean!
    """
    Whether it may end its turn by saying so, rather than by writing prose.

    On by default. A round ends when the model answers instead of asking for
    another tool, which assumes the answer is the prose - and an agent that
    posted its reply itself has nothing left to write. Turning it off suits a
    workflow whose next node needs an answer to work with.
    """
    finishAccess: Boolean!
    """
    Whether it may ask for an address for a picture it has drawn.

    On by default. A drawing tool answers with a key, which is what a tool that
    uploads a file takes; this is the other case - markdown for placing the
    picture inside what the agent writes. Turning it off suits an agent whose
    answers are read somewhere this installation is not.
    """
    pictureLinkAccess: Boolean!
    "Memory catalogs this agent may read, by name."
    memoryCatalogs: [String!]!
    "Which skill catalogs it may draw on."
    skillCatalogs: [String!]!
    "Which of the workspace's tools it may call."
    tools: [String!]!
    """
    Which of the workspace's connections it may name when a tool takes one.

    A grant with a standing instruction attached: the briefing lists these and
    tells the agent to use one only when explicitly told to, so granting a
    connection widens what the agent may do without changing what it does
    unprompted.
    """
    connectionIds: [ID!]!
    """
    Which other agents this one may put a question to.

    A specialist asked one question answers in a conversation of its own, so what
    comes back is the answer rather than the twelve rounds of looking things up
    that produced it. An agent reached this way is granted no agents of its own,
    however many its row names: one level, as a rule rather than as a depth
    somebody has to choose.
    """
    agentIds: [ID!]!
    """
    How many tools this agent carries at once; null is the provider's ceiling.

    Tool search starts where this is reached. The provider's own limit is the
    number at which a request fails; this is the number at which somebody decided
    the agent was choosing badly, which is always smaller and is a judgement.
    """
    maxTools: Int
    "Which granted tools always travel rather than being found; read only where `maxTools` is set."
    requiredTools: [String!]!
    "Which icon a node drawn from this starts with; null draws the kind's own."
    icon: String
    """
    How much of its model's context window one of its sessions may take back,
    as a percentage of that window. Null follows the workspace's
    `defaultMemoryShare`, and where that is null too, the built-in allowance —
    so this being null does not mean the agent has no share, only that it set
    none. `memoryBudget.share` is the one that applies, and
    `memoryBudget.inherited` says which of the two it came from.

    One number rather than five. How many turns come back, how much of them,
    how much of what its tools returned and how much of any one result are all
    worked out from this, because somebody setting it is answering "how much
    conversation should it carry" and not five separate questions.

    A share rather than a count, and on the agent rather than the installation,
    because a budget is a share of a window: the window belongs to the model
    and is recorded on it, and how much of it is worth spending on remembering
    depends on what this agent's tools give back.
    """
    memoryShare: Int
    "What that share works out to against the model this agent uses now."
    memoryBudget: SessionMemoryBudget!
    """
    How many rounds of tool calls this agent gets before it must answer.

    A round is one call to the model: it answers, or it asks for tools and what
    it asks for is run and handed back. Null follows the installation's own
    number, which is where every agent starts; a number here is for the one
    agent whose work is longer than the rest.
    """
    maxRounds: Int
}

"""
What a session may put back in front of a model, worked out.

Every count is in tokens and every one of them is approximate: they are
measured in characters, which is the unit every model agrees on and the only
one that can be counted without the provider's own tokeniser, and reported here
at four characters to the token.
"""
type SessionMemoryBudget {
    """
    The share that applies. Null when neither the agent nor its workspace set
    one and the built-in allowance applies.
    """
    share: Int
    """
    True when `share` is the workspace's `defaultMemoryShare` rather than the
    agent's own.

    The one thing a form cannot work out for itself: an agent showing 10% has
    to say whether that is its own answer or the one it inherits, because
    clearing its own lands on the workspace's rather than on the built-in
    allowance. Always false for the preview asked with `workspaceDefault: true`,
    which is setting that default rather than inheriting it.
    """
    inherited: Boolean!
    """
    The context window of the model in question, in tokens.

    Null when that model has none recorded or none is chosen, in which case a
    share cannot be worked out and the built-in default is what applies.
    """
    contextWindow: Int
    "True when the share and the window produced the numbers below; false when the built-in default did."
    derived: Boolean!
    "What a session may add to one prompt altogether."
    totalTokens: Int!
    "Of that, what turns somebody said may take."
    conversationTokens: Int!
    """
    And what tool results may take.

    A separate allowance rather than a slice of the one above: a single listing
    of a workspace's issues measures ten thousand tokens against everything
    anybody ever said, so sharing one allowance it either takes all of it or is
    the first thing dropped.
    """
    toolResultTokens: Int!
    "The most any one tool result may take; a longer one is cut, and the cut says so."
    longestResultTokens: Int!
    "How many said turns come back at most."
    turns: Int!
    """
    How many tool lookups are considered.

    The one number that does not follow the share, because it is a ceiling on a
    query rather than an allowance: repeats are dropped after they are read, so
    it is deliberately more than can fit.
    """
    toolResults: Int!
    """
    Why this share cannot be saved, or null when it can.

    A share too large for the window is a request the provider refuses, on
    somebody's turn, after the tokens that did fit have been paid for. The
    preview reports the refusal so a form can say why before Save; the mutation
    raises it, from the same calculation.
    """
    refusal: String
}

type AgentPage {
    content: [Agent!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

"""
A conversation with an agent that no single run owns.

Keyed by something the caller computes rather than by a workflow or a chat,
which is the whole mechanism: two workflows that arrive at the same key are
writing into the same conversation, and that is how one survives the run that
opened it. Nobody creates one from a screen - it appears the first time an agent
records into it.
"""
type LlmSession {
    id: ID!
    workspaceId: ID!
    """
    The identity, composed. It is `prefix:key`, or the key alone where no prefix
    was given; the separator keeps prefix "issue-" with key "42" from being the
    same session as no prefix with key "issue-42".
    """
    key: String!
    "The prefix it was composed from, or null where there was none."
    keyPrefix: String
    "How many lines it holds, which is what a list of transcripts is scanned by."
    eventCount: Int!
    "ISO-8601 offset date-time."
    createdAt: String!
    "When anything was last said here, or null on one nothing has been recorded in yet."
    lastEventAt: String
    """
    What the agents in this conversation wrote down for themselves.

    The one part of a conversation an agent chose to keep rather than merely
    said: a transcript is what happened, and these are the few lines it decided
    it must not lose. Empty on a conversation where nothing was written.
    """
    notes: [LlmSessionNote!]!
}

"One thing an agent wrote down for itself, part-way through."
type LlmSessionNote {
    id: ID!
    note: String!
    "Which agent wrote it, since a conversation can be shared."
    writtenBy: String!
    "ISO-8601 offset date-time."
    writtenAt: String!
}

type LlmSessionPage {
    totalElements: Int!
    content: [LlmSession!]!
}

"What a list of LLM sessions is ordered by."
enum LlmSessionOrder {
    "By the composed key, so a session can be found by name without reading every row."
    KEY
    "By when it was first opened."
    CREATED
    """
    By when anything was last said in it, which is what \"what is happening\" means
    here. A session nothing has been recorded in yet sorts last, whichever way round.
    """
    LAST_EVENT
}

"""
What one line of a session is.

Four, taken from the four things there are to record. TOOL is the call and not
its result: what a tool returned can be a whole file, and what a reader wants to
know is that the agent went and looked, and what it asked for.
"""
enum LlmSessionEventKind {
    "The agent's answer, as the model finally gave it."
    AGENT
    "A tool the agent called, and the arguments it passed."
    TOOL
    "What was put to the agent - a question, or a node's prompt."
    USER
    """
    A note from the machinery about the conversation rather than in it. An agent
    that could not answer leaves one, so a transcript that goes quiet says why.
    """
    SYSTEM
    """
    What a reasoning model thought on its way to a turn.

    Not something the agent said, and never put in front of a model. Written
    while it is still arriving, so a page following a task draws it as it
    happens; `millis` is null until the model stops thinking.
    """
    THINKING
}

"What a transcript is ordered by."
enum LlmSessionEventOrder {
    "By time, which is what a transcript is."
    AT
    "By kind, for reading every tool call at once without losing the ones between."
    KIND
}

type LlmSessionEvent {
    id: ID!
    kind: LlmSessionEventKind!
    "The agent, the tool, whoever asked, or \"system\". Every line names somebody."
    actor: String!
    """
    The payload, and what it is depends on the kind: the words for what was said,
    the call's arguments exactly as the model sent them for a tool, the text of a
    note.
    """
    content: String
    """
    What a call gave back, and null on every line that is not one - or on a call
    whose tool has not answered, since the call is written before the tool runs.
    """
    result: String
    """
    How long a THINKING line's reasoning went on for, in milliseconds, and null
    on every other kind - or on a thinking line the model has not finished, since
    the duration is what settles it.
    """
    millis: Float
    "ISO-8601 offset date-time."
    at: String!
}

type LlmSessionEventPage {
    totalElements: Int!
    content: [LlmSessionEvent!]!
}

"""
Where a task has got to.

Six, and the interesting one is WAITING. A workflow run has three states because
a graph either walks or it does not; a task has a fourth thing it can be doing,
which is standing still because it asked somebody a question.
"""
enum TaskStatus {
    "Recorded and not yet picked up."
    QUEUED
    "An agent is working at it."
    RUNNING
    "Stopped, and waiting for a person. Exactly one request is open."
    WAITING
    "The agent said it had finished, and what it said is the outcome."
    DONE
    "Out of turns, out of time, nobody answered, or the model could not go on."
    FAILED
    "Somebody stopped it."
    STOPPED
}

"""
Something a task may be given that its agent was not.

The same six things an agent's own page grants, named the same way, because
approving one here is the same decision taken for one task instead of for ever.
There is deliberately no seventh meaning \"everything\".
"""
enum TaskCapability {
    "Asking orknux about orknux, and starting workflows, in this workspace."
    ORKNUX
    "Opening a shell on one of the installation's machines and running commands."
    SHELLS
    "One of the workspace's own tools, named in `subject`."
    TOOL
    MCP_SERVER
    SKILL_CATALOG
    MEMORY_CATALOG
}

"What the agent stopped for."
enum TaskRequestKind {
    "It wants something it was not granted."
    PERMISSION
    """
    It wants to be told something - most often how what it is producing should
    be delivered. The same parking and resuming as a permission, because it is
    the same mechanism.
    """
    QUESTION
}

"What a person decided about a request."
enum TaskDecision {
    GRANTED
    REFUSED
    ANSWERED
}

"""
A problem given to an agent, and the agent working at it until it is done.

What it did is not on this type. `sessionId` names an LLM session, and every
tool the agent called, everything it was told and everything it said is in that
session's events - the same transcript the Sessions screen draws.
"""
type Task {
    id: ID!
    workspaceId: ID!
    "A line to find it by: the first line of the prompt, unless one was given."
    title: String!
    "What was asked, in full."
    prompt: String!
    "The agent doing it, or null for a task given to a bare model."
    agentId: ID
    "Its name now, so a list need not look one up per row."
    agentName: String
    modelId: ID
    status: TaskStatus!
    "Where the event log is. Read it with `llmSessionEvents`."
    sessionId: ID
    "The issue it was started from, where something started it from one."
    issueId: ID
    createdBy: String!
    "ISO-8601 offset date-time."
    createdAt: String!
    startedAt: String
    finishedAt: String
    "How many times the model has been asked, and how many it may be."
    turnsSpent: Int!
    turnsAllowed: Int!
    """
    Seconds actually worked, and what it may work for.

    Not wall clock: a task parked for two days waiting to be approved has spent
    none of this.
    """
    workedSeconds: Int!
    secondsAllowed: Int!
    "When a parked task gives up on being answered. Null unless it is waiting."
    waitingUntil: String
    """
    What the agent finally said, in markdown, with whatever it drew.

    A task can call a text-to-image model, and a picture it drew is part of what
    it produced rather than something to go looking for: every one is shown here
    as a markdown image, beneath the summary, unless the summary already places
    it somewhere itself. A task that drew and then ran out of turns still has
    them, which is why this can be set on a task that never said anything.
    """
    outcome: String
    "Why it stopped, in the words the page shows. Null while it is still going."
    endedBecause: String
    "Everything it has stopped to ask, oldest first. An undecided one is what it is waiting for."
    requests: [TaskRequest!]!
    "What has been approved for it, and by whom."
    grants: [TaskGrant!]!
    "What people have said to it while it worked, oldest first."
    messages: [TaskMessage!]!
}

"""
Something a person said to a working task.

The other direction from TaskRequest, and the only way to reach a task that has
not stopped. What was said is written into the task's transcript under the name
of whoever said it once the agent reads it, so this type is the receipt rather
than the record.
"""
type TaskMessage {
    id: ID!
    "Whoever typed it, by username."
    saidBy: String!
    body: String!
    sentAt: String!
    """
    When the agent was shown it, and null while it has not been.

    A message is read at the top of the next turn, so one sent while the model
    is mid-turn sits unread for as long as that turn takes. A page that drew it
    as delivered would be saying a correction had landed when it had not - and a
    task that ends before its next turn never reads it at all, which this is the
    only thing that says.
    """
    readAt: String
}

type TaskRequest {
    id: ID!
    kind: TaskRequestKind!
    "Set on a permission, null on a question."
    capability: TaskCapability
    "Which one, for the capabilities that name something."
    subject: String
    "The question, or why the agent says it needs the thing. What a person reads before deciding."
    asks: String!
    askedAt: String!
    "Null while it is still waiting."
    decision: TaskDecision
    "What the person said, on a question."
    answer: String
    decidedBy: String
    decidedAt: String
}

type TaskGrant {
    id: ID!
    capability: TaskCapability!
    subject: String
    grantedBy: String!
    grantedAt: String!
}

type TaskPage {
    totalElements: Int!
    content: [Task!]!
}

"What starting a task needs."
input StartTaskInput {
    workspaceId: ID!
    "The problem, in words. The first line of it names the task unless `title` says otherwise."
    prompt: String!
    title: String
    """
    The agent to do it.

    Required. Absent used to mean a bare model - an agent with no tools, no
    skills, no grants, no memory and no instructions, set to a job that is
    defined by doing - and it was offered in the picker as though it were the
    other half of a real choice.
    """
    agentId: ID!
    "Absent takes the agent's own model, which is nearly always what is wanted."
    modelId: ID
    "What it came from. It is the link back, and it decides who else hears about it."
    issueId: ID
}

"""
A named piece of JavaScript an agent may call while it runs.

Not a workflow function: a function is called by an action node at a point the
graph fixed in advance, a tool is offered to an agent that calls it if it judges
that it should. Same sandbox, different caller.
"""
type Tool {
    id: ID!
    workspaceId: ID!
    name: String!
    "What the tool is for. An agent reads this to decide whether to call it."
    description: String
    "The JavaScript that runs."
    source: String!
    "The TypeScript it was compiled from, which is what the editor opens."
    typescript: String!
    """
    What it takes, in the order the sandbox passes it.

    The same list a function declares, and stored the same way. A tool used to
    take one hard-coded argument called `input`, which was not a signature
    anybody could read or change; existing tools were given that one parameter,
    so nothing about how they are called moved.
    """
    params: [ToolParam!]!
    """
    The workspace's variables it is handed, after the parameters it declares.

    The same arrangement a function has, for the same reason: the agent is never
    told they exist, so a tool reaches a credential without the credential
    passing through a conversation.
    """
    externals: [FunctionExternal!]!
    "How long one call may run, in seconds. Null means the workspace decides."
    timeoutSeconds: Int
    """
    The workspace's functions it calls, under the names it calls them.

    One direction only: a tool may import a function, and nothing imports a tool.
    A tool is what an agent decides to call, not a piece anybody builds out of.
    """
    imports: [ScriptImport!]!
    "The installation's libraries it uses, under the names it uses them by."
    libraries: [ScriptLibraryImport!]!
    "\"(city: string, days: number)\", ready for the list."
    signature: String!
    "Off leaves it defined but out of reach."
    enabled: Boolean!
    "ISO-8601 offset date-time, and the uid that saved it."
    lastModifiedAt: String!
    lastModifiedBy: String!
}

type ToolParam {
    name: String!
    type: ValueType!
    "Which object, when the type is OBJECT. Null otherwise."
    objectId: ID
    "What that object is called, resolved for the editor's annotations."
    objectName: String
}

type ToolPage {
    content: [Tool!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

"A reusable instruction set that guides how an agent goes about something."
type Skill {
    id: ID!
    workspaceId: ID!
    catalogId: ID!
    name: String!
    description: String
    "Markdown, opening with a frontmatter block naming and describing it."
    content: String!
    enabled: Boolean!
    lastModifiedAt: String!
    lastModifiedBy: String!
}

type SkillPage {
    content: [Skill!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

"""
One thing that can be typed instead of said.

Carried out by the same code the agents reach: running a workflow from a command
and running one from an agent are the same act with the same consequences, so
they are the same implementation with the same rules about what may be done.
"""
type ChatCommand {
    "What is typed after the slash."
    name: String!
    "One line, as the menu lists it."
    summary: String!
    "What to type after it, in words; null where it takes nothing."
    argument: String
    "What is worth knowing before pressing it, where anything is."
    warning: String
}

"""
One conversation. The messages are not here: they live in Spring AI's chat
memory store, keyed by a conversation id, which is what lets a workflow run
key one the same way and have every agent in it share a single thread.
"""
type ChatSession {
    id: ID!
    workspaceId: ID!
    title: String!
    pinned: Boolean!
    "Which model answers; null once the model it named has been removed."
    modelId: ID
    modelName: String
    "Set when an agent is answering rather than a bare model."
    agentId: ID
    "What that agent is called, or null once it has been deleted."
    agentName: String
    "The LLM session this chat is continuing, or null for one continuing none."
    llmSessionId: ID
    "ISO-8601 offset date-times. `lastMessageAt` is null until something is said."
    createdAt: String!
    lastMessageAt: String
    """
    What this whole chat has read and written, kept and added to as each turn
    lands - not the last answer's, which `ChatAnswer` carries and which is gone
    on reload.

    Every round of every turn, an agent's lookups included, and a regenerated
    answer counts on top of the one it replaced because both were paid for.
    Tokens rather than money: prices belong to the model, models are repriced,
    and a chat can be moved onto another model mid-conversation, so a stored
    total in currency is arithmetic nobody could check afterwards.

    Zero means nothing was recorded, not that nothing was spent - a chat nobody
    has spoken in, a provider that reported no counts, and a chat older than the
    column all read the same, and the screen draws nothing for all three.
    """
    spentInputTokens: Float!
    spentOutputTokens: Float!
    """
    How many pictures were drawn in this chat.

    Counted rather than costed in tokens, because an image model charges per
    picture and reports no counts at all. Folded into the token total it would
    add nought and read as free.
    """
    spentPictures: Int!
}

"""
One line of a chat, as it is read.

Role is user, assistant, system or tool. A `tool` line is a call the agent made
in the LLM session this chat continues, shown between the turns it was made
between so an answer is not read as something the agent simply knew - `content`
is the arguments as the model sent them, and `actor` is the tool. It is not part
of the conversation and was never in the thread: what goes to the model is what
was said, and only that.
"""
type ChatMessage {
    role: String!
    content: String!
    """
    When it was sent, ISO-8601, or null for a line carried in from the LLM
    session this chat continues - said before the chat existed.
    """
    at: String
    """
    Who said it - the agent, the tool or the person - for a line carried into
    this chat from the LLM session it continues.

    Null for everything the chat itself said, which the model or agent named on
    the chat answered. So it is also the boundary: lines with an actor were
    already there when the chat opened, turns without were said in it.
    """
    actor: String
    """
    What this answer said the earlier times it was given, oldest first.

    Empty for an answer nobody has asked for again, and for every other kind of
    line. Asking again takes the model's last turn off the thread before it is
    asked - a conversation holding two answers to one question was never had -
    and these are the turns that came off, kept so that the button is not a way
    of losing the answer somebody was about to keep. They are never put in front
    of a model.
    """
    takes: [String!]!
    """
    What the model thought on its way to this answer, for a reasoning model.

    Null where it thought nothing anybody kept, which is every ordinary model
    and every kind of line that is not an answer. Null rather than empty on
    purpose: the screen draws no container at all for a message with none,
    rather than an empty one asserting there was thinking to see.

    Never part of `content`, and that is the whole arrangement rather than a
    detail. The copy control, the speech model and the next turn's prompt all
    read the content, and they are correct because the string they read does
    not hold this - not because each of them remembers to strip it. It is never
    put in front of a model.
    """
    thinking: String
    """
    How long that thinking went on for, in milliseconds.

    Null where nobody measured it - a round read whole rather than as a stream
    hands the reasoning over complete and there is no duration in it. Never the
    turn's own time standing in: the turn is already reported on the answer's
    disclosure, and two numbers on one screen that look like the same
    measurement and are not is worse than one number missing.
    """
    thinkingMillis: Float
}

type ChatAnswer {
    session: ChatSession!
    answer: ChatMessage!
    "How long the model took, which the screen shows as what it thought for."
    millis: Float!
    """
    What the provider said it charged for, over the whole turn rather than the
    last call in it - an agent that looked three things up paid for four rounds,
    and `millis` beside these has meant the turn's total since agents could call
    tools at all.

    Zero means the provider reported no counts, not that nothing was spent, so
    the screen draws nothing where it finds one.
    """
    inputTokens: Float!
    outputTokens: Float!
    """
    What those tokens cost at the prices recorded on the model. Null when it
    carries none, which is not the same as free.
    """
    cost: Float
}

input StartChatInput {
    workspaceId: ID!
    title: String
    """
    The agent to talk to.

    Where a `modelId` used to be. A chat is opened on an agent or it is not
    opened: an agent carries the tools, the skills, the grants, the memory and
    the system prompt that make a conversation worth having, and a bare model is
    that same agent with every one of them taken off. It was offered beside
    agents as though it were a peer, and it never was.

    Absent does not mean a bare model. It means nobody was named, which is what
    the sidebar's "+ New" sends, and the answer is whichever agent this person
    last talked to in this workspace - or, where they have not, the first agent
    the workspace has that could answer. A workspace with no agent at all is
    refused with `ChatAgentMissing`, which is the screen's cue to say to add one.
    """
    agentId: ID
    """
    The LLM session this chat continues, when it was opened from one.

    What the person says goes into that session as USER and what answers goes
    in as AGENT, so the transcript keeps growing and a later run reading it
    finds what a person said. The session must belong to the same workspace;
    anything else is refused. Null - every chat started from the sidebar - is a
    chat continuing nothing, exactly as before.
    """
    llmSessionId: ID
}

"What Validate found, in the tool and skill editors. `column` is null for a skill."
type SourceValidation {
    valid: Boolean!
    message: String
    line: Int
    column: Int
}

input ToolParamInput {
    name: String!
    type: ValueType!
    "Required when the type is OBJECT, and ignored otherwise."
    objectId: ID
}

input CreateToolInput {
    workspaceId: ID!
    name: String!
    description: String
    """
    The compiled JavaScript. Given together with `typescript` or not at all: a
    tool whose halves were written separately is one whose editor and sandbox
    disagree. Left out with it starts the tool from a stub that parses.
    """
    source: String
    "The TypeScript it was compiled from."
    typescript: String
    "Left out means the one every tool used to take: an object called `input`."
    params: [ToolParamInput!]
    "The workspace's variables it is handed, after the parameters it declares."
    externalVariableIds: [ID!]
    "The workspace's functions it calls, under the names it calls them."
    imports: [ScriptImportInput!]
    "The installation's libraries it uses, under the names it uses them by."
    libraries: [ScriptLibraryImportInput!]
}

input UpdateToolInput {
    name: String
    description: String
    "The compiled JavaScript. Given together with `typescript` or not at all."
    source: String
    "The TypeScript it was compiled from."
    typescript: String
    "Null leaves them alone; an empty list takes them all off."
    params: [ToolParamInput!]
    "Null leaves them alone; an empty list takes them all off."
    externalVariableIds: [ID!]
    "Null leaves them alone; an empty list takes them all off."
    imports: [ScriptImportInput!]
    "Null leaves them alone; an empty list takes them all off."
    libraries: [ScriptLibraryImportInput!]
}

"""
A folder of skills. Its own thing rather than a label, because it exists — and
has a count worth showing — before anything is in it, and because it is the unit
an agent is granted.
"""
type SkillCatalog {
    id: ID!
    workspaceId: ID!
    name: String!
    skillCount: Int!
    createdAt: String!
    createdBy: String!
}

"""
A folder of skills a plugin brought, offered under the plugin's key.

Its own type rather than a `SkillCatalog` with a made-up id, because it is not
a row: there is nothing to rename, nothing to delete, and nothing to put a
skill into. A plugin's skills are the plugin's, replaced wholesale the next
time it is loaded. What it shares with a workspace's catalog is the only thing
that matters to an agent — it is granted by name, from the same field.
"""
type PluginSkillCatalog {
    """
    `jira_plugin` — the plugin's key, suffixed. What goes on an agent's grant
    list.

    Suffixed because the name is a grant string and has to be the plugin's
    alone: a bare key could be a folder a workspace already has, and one grant
    meaning two things is either a silent merge or a shadow rule.
    """
    name: String!
    "The plugin's key on its own, for a screen saying where this came from."
    key: String!
    "What the plugin is called on screen, so a picker can show both."
    plugin: String!
    skills: [PluginSkill!]!
}

"""
One shape a plugin exports, as it declared it.

The plugin's own spelling throughout: `of` names another of *this plugin's*
objects. What it becomes as a row — the prefix, the reference by id — is the
server's, and `pluginObjects` is where that is read.
"""
type PluginObject {
    name: String!
    description: String
    properties: [PluginObjectProperty!]!
}

"One field of a shape a plugin exports."
type PluginObjectProperty {
    name: String!
    kind: PropertyKind!
    "The object it points at, or what an array holds, by the plugin's own name."
    of: String
    "What an array holds when it holds scalars."
    elementKind: PropertyKind
    description: String
}

"One instruction set a plugin brings: markdown an agent reads, never code it runs."
type PluginSkill {
    name: String!
    description: String
    "The markdown in full, frontmatter and all."
    content: String!
}

"""
A folder of memories. Its own thing rather than a label, because it exists — and
is worth counting — before anything has been put in it.
"""
type MemoryCatalog {
    id: ID!
    workspaceId: ID!
    name: String!
    "What the count badge shows."
    memoryCount: Int!
    createdAt: String!
    createdBy: String!
    """
    The one catalog this workspace always has.

    A catalog is what an agent is granted and what a memory is filed into, so a
    workspace with none has nowhere for either. This one cannot be deleted, so
    that floor cannot be taken away; it can be renamed, which is what makes the
    name it starts with a starting point rather than one somebody is stuck with.
    """
    isDefault: Boolean!
}

"One thing the workspace wants remembered."
type Memory {
    id: ID!
    catalogId: ID!
    title: String!
    content: String!
    createdAt: String!
    "Who added it. An editor does not become the author."
    createdBy: String!
    lastModifiedAt: String!
    lastModifiedBy: String!
}

type MemoryPage {
    content: [Memory!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

enum MemorySort {
    LAST_MODIFIED
    CREATED
    TITLE
}

input CreateMemoryInput {
    catalogId: ID!
    title: String!
    content: String!
}

"A null `catalogId` leaves the memory in the catalog it is in."
input UpdateMemoryInput {
    title: String!
    content: String!
    catalogId: ID
}

input CreateSkillInput {
    workspaceId: ID!
    name: String!
    description: String
    "Left out for a new skill, which starts from the shape with its parts named."
    content: String
    "Which folder it goes in; the workspace's first when nobody says."
    catalogId: ID
}

input UpdateSkillInput {
    name: String
    description: String
    content: String
    "Moves it to another folder; null leaves it where it is."
    catalogId: ID
}

input CreateAgentInput {
    workspaceId: ID!
    name: String!
    type: AgentType!
    description: String
    systemPrompt: String
    "Which icon a node drawn from this starts with; null draws the kind's own."
    icon: String
}

input UpdateAgentInput {
    name: String!
    description: String
    systemPrompt: String
    type: AgentType
    "The model to think with. Null clears it."
    modelId: ID
    "Null leaves the list alone; an empty list clears it."
    mcpServers: [String!]
    "Whether it may ask orknux about orknux; null leaves the grant alone."
    orknuxAccess: Boolean
    "Whether it may open a shell on a machine; null leaves the grant alone."
    shellAccess: Boolean
    "Whether it may keep a file it made. On by default."
    artifactAccess: Boolean
    "Whether it may end its turn by saying so rather than writing prose. On by default."
    finishAccess: Boolean
    "Whether it may ask for an address for a picture it drew. On by default."
    pictureLinkAccess: Boolean
    "Same rule: null leaves it alone, an empty list clears it."
    memoryCatalogs: [String!]
    "Null leaves the grant alone."
    skillCatalogs: [String!]
    "Which tools it may call; null leaves the grant alone."
    tools: [String!]
    "Which of the workspace's connections it may name; null leaves the grant alone."
    connectionIds: [ID!]
    "Which other agents it may put a question to; null leaves the grant alone."
    agentIds: [ID!]
    "How many tools it carries at once, 5 to 100; null leaves it alone."
    maxTools: Int
    "Which granted tools always travel; null leaves them alone."
    requiredTools: [String!]
    "Which icon a node drawn from this starts with; null draws the kind's own."
    icon: String
    """
    How much of its model's context window a session may take back, as a
    percentage of it, between 1 and 50.

    Sent whenever the form saves, so null is "follow the workspace" rather than
    "leave it alone" — the rule the icon follows, and what lets a screen put it
    back to the default.

    A share the chosen model cannot give is refused here rather than at the
    provider: ask `memoryBudget` what it works out to and it will say why in
    the same words.
    """
    memoryShare: Int
    "Its own ceiling on tool rounds; null follows the installation's."
    maxRounds: Int
}

enum WorkspaceOperationType {
    ADD
    REMOVE
    RENAME
}

enum WorkspaceAuditCategory {
    WORKSPACE
    WORKFLOW
    AGENT
    INTEGRATION
    "LLM providers, the models reached through them, and their quotas."
    MODEL
    "Memory catalogs, and what the workspace has written down in them."
    MEMORY
    "The shapes a workspace's workflows pass around."
    OBJECT
    "What happens inside a chat: files attached to a message, and the like."
    CHAT
    """
    Commands run on a machine over SSH, and the shells they ran on.

    Its own category because this is the one thing on the platform that acts
    outside it, and "the administrator secures the machine" is only a fair
    bargain if they can afterwards read every command that was run on it.
    """
    SHELL
    """
    Tasks: one started, one stopped, and what a person let one of them do.

    Its own category for the reason SHELL is. Granting a capability to a task is
    the one decision that widens what an agent may reach without changing the
    agent, and somebody auditing that must be able to find those rows.
    """
    TASK
}

type WorkspaceAuditEntry {
    id: ID!
    "Null for admin-level entries, such as a default connection change."
    workspaceId: ID
    category: WorkspaceAuditCategory!
    "Ready to show: \"Agent Research Agent enabled\"."
    message: String!
    oldWorkspaceName: String
    newWorkspaceName: String
    "Only set for workspace lifecycle entries."
    operationType: WorkspaceOperationType
    "ISO-8601 offset date-time, e.g. 2026-08-14T17:04:11.123+02:00."
    date: String!
    "LDAP uid of the user who performed the operation."
    userId: String!
}

"A slice of audit entries, newest first."
type WorkspaceAuditPage {
    content: [WorkspaceAuditEntry!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

enum ConnectionType {
    """
    Slack: a bot token to call the API with, and optionally an app-level token.
    Given the app-level token orknux also listens on it; without one it only sends.
    """
    SLACK
    "A mail server to send through. Its url is a host name, not a URL."
    SMTP
    """
    An HTTP endpoint this installation sends requests to: the generic outbound
    target, and what every connection that is not Slack or a mail server already
    was. It was called WEBHOOK, which named the wrong end of the wire - a webhook
    is something this installation exposes, which is what TriggerType.WEBHOOK
    means and now means on its own.
    """
    HTTP
}

"How the session with a mail server is secured."
enum MailSecurity {
    NONE
    "Port 587: plain to begin with, encrypted before the credentials are sent."
    STARTTLS
    "Port 465: TLS before anything else, the way HTTPS is."
    TLS
}

"How requests to the service are authenticated."
enum AuthType {
    NONE
    API_KEY
    BEARER_TOKEN
    BASIC
}

"An extra HTTP header sent with every request."
type HttpHeader {
    name: String!
    value: String!
}

input HttpHeaderInput {
    name: String!
    value: String!
}

"An admin-level default connection."
type Connection {
    id: ID!
    name: String!
    type: ConnectionType!
    url: String!
}

type ConnectionPage {
    content: [Connection!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

input ConnectionInput {
    name: String!
    type: ConnectionType!
    "Required, except for the types that have one address: Slack is filled in."
    url: String
    "Also hand the connection to the workspaces that already exist. Ignored on update."
    addToExistingWorkspaces: Boolean
}

"""
One certificate authority this installation trusts, beyond the JVM's own.

Nothing here is a secret and nothing is masked: a certificate authority's
certificate is what a server hands every client that connects, and being able to
read back which one was added is the point of the screen.
"""
type TrustedCertificate {
    id: ID!
    "What an administrator called it, since PEM blocks all look alike."
    name: String!
    pem: String!
    "What the certificate says about itself, read once when it was added."
    subject: String!
    "ISO-8601 offset date-time, or null where the certificate carries no expiry."
    expiresAt: String
    addedAt: String!
    addedBy: String!
    "Whether it has already run out, so the row says so rather than quietly not working."
    expired: Boolean!
}

"""
One installation-wide answer to "does this address need a proxy".

Installation-wide because the reason a proxy exists is the network this process
sits in rather than the team whose workflow made the call, and because it is the
only scope covering the calls made for nobody in particular - a provider's token
grant, the sweep that asks whether connections still answer.
"""
type ProxyRule {
    id: ID!
    name: String!
    """
    A regular expression, matched against the whole request URL - scheme and
    path included - found anywhere in it rather than end to end, ignoring case.
    Anchor it with `^` and `$` to match the whole URL.
    """
    pattern: String!
    "A host name, without a scheme: a proxy is spoken to over plain HTTP."
    proxyHost: String!
    proxyPort: Int!
    username: String
    "Whether a password is stored. The password itself is never returned."
    passwordSet: Boolean!
    enabled: Boolean!
    "Ascending. The first enabled rule that matches a URL is the one used."
    position: Int!
    createdAt: String!
    lastModifiedAt: String!
}

input ProxyRuleInput {
    name: String!
    pattern: String!
    proxyHost: String!
    proxyPort: Int!
    username: String
    "Null leaves the stored password alone; an empty string clears it."
    password: String
    "Defaults to on for a new rule; omitting it on an update leaves it as it is."
    enabled: Boolean
}

"What would happen to one URL, for the box on the Networking page that asks."
type ProxyRoute {
    url: String!
    "The rule that answers, or null for a request that goes out directly."
    matched: ProxyRule
    """
    Rules that also match but never get the chance, in the order they are
    consulted. A rule appearing here is one that will never fire for this URL,
    which is the whole answer to "why does my rule do nothing".
    """
    beaten: [ProxyRule!]!
    """
    Why the address guard would refuse this URL outright, before any rule
    mattered. A proxied request is still vetted exactly as an unproxied one is.
    """
    refusedBecause: String
    "What the same guard thinks of the matched rule's own proxy address."
    proxyProblem: String
}

"""
A machine this installation can run commands on, over SSH.

Installation-wide and administrators only, because a host belongs to the
infrastructure this process sits in rather than to the team whose agent asked
about it.

What contains a shell is the machine on the other end and nothing in this
application. There is no list of forbidden commands and no classifier deciding
which are safe: reading a shell command and saying what it will do is not a
solvable problem, and a denylist that is nearly right is worse than none because
it says an administrator is protected when they are not. The design is a virtual
machine or a container the administrator chose, an account with exactly the
privileges they meant to give away, and an audit entry for every command run.
"""
enum ShellKind { SSH, MCP }

type Shell {
    id: ID!
    name: String!
    "SSH or MCP - which list it appears in and what carries its commands."
    kind: ShellKind!
    "The MCP server an MCP shell speaks through, or null for an SSH shell."
    mcpServerId: ID
    "Blank for an MCP shell, whose reach is the server's, not a host of its own."
    host: String!
    port: Int!
    """
    The account on the far side, or null when none was given.

    Optional in the way it is optional at `ssh build.internal`: leaving it out
    means the account this server itself runs as. See `account` for what that
    resolves to.
    """
    username: String
    """
    The account commands actually run as: `username` when there is one, and the
    account this server process runs as when there is not.

    Here rather than worked out by whatever is showing it, because nothing
    outside this process knows what account it runs as, and a screen that
    guessed would be guessing about privilege.
    """
    account: String!
    "Whether a private key is stored. The key itself is never returned."
    privateKeySet: Boolean!
    "Whether the key has a passphrase. It is never returned either."
    passphraseSet: Boolean!
    """
    The host key this shell was first seen with, as a `SHA256:` fingerprint, or
    null until the first connection succeeds.

    Trust on first use: what answered the first time is what has to answer from
    now on, and a different key is refused rather than accepted quietly. Compare
    it by eye with `ssh-keygen -lf` on the machine itself.
    """
    hostKey: String
    enabled: Boolean!
    """
    How long one command on this machine may run, in seconds, or null when it
    has no limit of its own and runs on `defaultCommandTimeoutSeconds`.

    Per machine because the right number is a property of the machine. A
    container built to compile things and a router that answers `show
    interfaces` want opposite answers, and an installation with both had to pick
    one.
    """
    commandTimeoutSeconds: Int
    "How much of a command's output this machine keeps, per stream, in bytes. Null for the default."
    maxOutputBytes: Int
    """
    What a shell with no limit of its own actually runs on.

    Here for the same reason `account` is: the number lives in this
    installation's configuration and nothing outside the process can work it
    out. A screen showing an empty box and nothing beside it would be telling an
    administrator that no limit applies, which is never true.
    """
    defaultCommandTimeoutSeconds: Int!
    "The same, for the output allowance."
    defaultMaxOutputBytes: Int!
    status: ShellStatus!
    "What the last check found, in words worth showing."
    lastCheckMessage: String
    lastCheckedAt: String
    createdAt: String!
    lastModifiedAt: String!
}

"What the last check of a shell found."
enum ShellStatus {
    "No private key is stored, so there is nothing to connect with."
    NOT_CONFIGURED
    "Configured, but nothing has reached the machine yet."
    NOT_CHECKED
    CONNECTED
    FAILED
}

input ShellInput {
    name: String!
    "SSH or MCP. Absent is SSH, unchangeable after creation."
    kind: ShellKind
    "Required for an MCP shell, ignored for SSH."
    mcpServerId: ID
    "Required for an SSH shell, ignored for MCP."
    host: String
    port: Int! = 22
    """
    The account on the far side. Optional, and blank is the same as absent:
    either way commands run as the account this server itself runs as, which is
    what `ssh build.internal` does with no user in front of it.
    """
    username: String
    """
    The private key, in OpenSSH or PEM form. Null leaves the stored one alone;
    an empty string clears it. Never read back.
    """
    privateKey: String
    "The key's passphrase, if it has one. Same rule as the key."
    keyPassphrase: String
    "Defaults to on for a new shell; omitting it on an update leaves it as it is."
    enabled: Boolean
    """
    How long one command on this machine may run, in seconds, or null to use
    this installation's own limit.

    Absent and null are the same thing, the way they are for `username` and
    unlike the key: there is nothing secret about a timeout, so the screen always
    has the current value to send back and an empty box is how somebody says
    "whatever the installation says".

    Between 1 and 86400. Outside that it is refused rather than clamped: a
    number quietly moved to the nearest one this accepts is a form claiming to
    have saved something it did not.
    """
    commandTimeoutSeconds: Int
    "How much of a command's output to keep, per stream, in bytes. Between 1024 and 16777216. Same rule as above."
    maxOutputBytes: Int
    """
    Forgets the host key this shell was first seen with, so the next connection
    trusts whatever answers and records that instead.

    What to tick after rebuilding a machine, and the only way past a key
    mismatch - which is the point of having one.
    """
    forgetHostKey: Boolean
}

"A connection as one workspace holds it, with that workspace's credentials."
type WorkspaceConnection {
    id: ID!
    workspaceId: ID!
    name: String!
    type: ConnectionType!
    "The admin default, or the workspace's own URL for a connection it added."
    url: String!
    urlOverride: String
    "Where requests actually go: the override when set, the default otherwise."
    effectiveUrl: String!
    authType: AuthType!
    headers: [HttpHeader!]!
    "True while the workspace follows an admin default, which locks name, type and URL."
    inherited: Boolean!
    "Whether the connection holds a credential of its own; it is never listed."
    secretSet: Boolean!
    """
    The workspace variable secret this credential is read from, or null when the
    connection keeps its own copy. Those are the two, and they are exclusive.

    Per field, not per connection: `appTokenVariableId` answers the same
    question separately, because a Slack connection's bot token and app-level
    token are two credentials and one switch above both could not say which.
    """
    secretVariableId: ID
    """
    What that variable is called and which catalog holds it, for showing the
    reference without a second round trip. Null when there is no reference, and
    also when there is one pointing at nothing — see `secretVariableMissing`.
    """
    secretVariableName: String
    secretVariableCatalog: String
    """
    A reference pointing at nothing. A variable a connection reads cannot be
    deleted, so this should not happen — but a restore or a database edited by
    hand can produce one, and a connection that cannot say why it has no token
    is the failure worth reporting rather than assuming away.
    """
    secretVariableMissing: Boolean!
    "Whether an app-level token of the connection's own is stored, which is what lets orknux listen for events."
    appTokenSet: Boolean!
    "The app-level token's own answers to the same four questions."
    appTokenVariableId: ID
    appTokenVariableName: String
    appTokenVariableCatalog: String
    appTokenVariableMissing: Boolean!
    "Whether a user token of the connection's own is stored, which is what lets Slack search be asked."
    userTokenSet: Boolean!
    "The user token's own answers to the same four questions."
    userTokenVariableId: ID
    userTokenVariableName: String
    userTokenVariableCatalog: String
    userTokenVariableMissing: Boolean!
    "Where a mail connection sends: the port it will use, which is the default when none was chosen."
    smtpPort: Int
    "Who a mail connection logs in as; null sends without authenticating."
    smtpUsername: String
    "The address a mail connection sends from."
    smtpFrom: String
    smtpSecurity: MailSecurity!
    "What the last check found; CONNECTED only once the service has answered."
    status: ConnectionStatus!
    "What the last check reported."
    lastCheckMessage: String
    "ISO-8601 offset date-time, or null when no check has run."
    lastCheckedAt: String
}

"What the workspace screen reports about a connection."
enum ConnectionStatus {
    "No credentials stored, so there is nothing to check."
    NOT_CONFIGURED
    "Configured, but no check has reached the service yet."
    NOT_CHECKED
    CONNECTED
    FAILED
}

"What asking a Slack connection about a typed user or channel came back with."
enum SlackTargetOutcome {
    "Slack named it."
    FOUND
    """
    Slack answered, and nothing it can see goes by that.

    Advice and never a verdict. A private channel the bot was never invited to,
    and a member who joined a moment ago, both look like this from here.
    """
    NOT_FOUND
    """
    The question was never put, and `message` says why.

    Its own outcome rather than a failure, because "could not check" and "does
    not exist" want opposite things done about them: one is a scope to add to
    the Slack app, the other is a name to correct. The commonest case by far is
    a bot token carrying no read scope at all, which is what a token set up only
    to post looks like.

    A question asked without a `target` comes back like this when one of the two
    lookups answered and the other was refused: a name absent from the half that
    could be read is not a name that does not exist, and `message` names the
    scopes that are actually missing and no others.
    """
    UNCHECKED
}

"""
Whether a Slack action's User or Channel field names something the connection
can see.

Nothing here refuses anything. The field it describes stays free text: it is
still saved as typed whatever this says, because a `NOT_FOUND` can be a member
who joined a minute ago, an id pasted out of somebody else's message, or a
private channel this bot has not been invited to.
"""
type SlackTargetCheck {
    outcome: SlackTargetOutcome!
    """
    One line, ready to show under the field, and empty only when nothing has
    been typed yet. Never carries a credential.

    One line on purpose. This is drawn in a side panel with room for about that
    much, and what was written here as a paragraph arrived as eight lines with
    its own scrollbar and was read by nobody.
    """
    message: String!
    "Slack's own id, when it was found."
    id: String
    "What Slack calls it, when it was found: \"#general\", \"Alice Adams\"."
    label: String
    """
    Which of the two it turned out to be, when it was found, and null otherwise.

    The answer to a question asked without a `target`, which is how every caller
    asks: an action holds a name and no kind, so this is what a form draws a
    mark from rather than something it saves.
    """
    target: MessageTarget
}

"""
What a Slack connection has to offer against what somebody has typed into an
action's target field so far.

The outcomes are `SlackTargetCheck`'s and mean the same things here, so a form
can treat the two answers alike. Nothing in it is a verdict: `matches` is what
was worth offering, not what may be entered.
"""
type SlackSuggestions {
    outcome: SlackTargetOutcome!
    """
    One line, ready to show under the field, and empty when there is nothing
    worth saying - which is the usual answer. Never carries a credential.

    It says something in three cases: `UNCHECKED`, where it is the reason there
    are no suggestions; `NOT_FOUND`, where it is the caveat that keeps that
    advice rather than a verdict; and a `FOUND` whose list is not complete,
    where it says why.
    """
    message: String!
    """
    Best first: what the typing matches exactly, then what starts with it, then
    what contains it.

    One list whether one kind was asked for or both. Where a channel and a
    member match equally well the channel comes first, because a channel name
    means one thing in a Slack and a display name need not, so the row read
    first is the unambiguous one.
    """
    matches: [SlackSuggestion!]!
    """
    Whether `matches` is everything that matches.

    False when Slack was not read to the end - a rate limit, a workspace larger
    than one read gets through - and false when more matched than are returned.
    Both mean the same thing to somebody typing, which is that there may be more
    and that narrowing will find it. Never a reason to refuse what they type.

    When both lists were searched it is false unless both were read whole, so a
    token that can read channels and not members reports an incomplete list and
    says so in `message` rather than passing half a Slack off as all of it.
    """
    complete: Boolean!
}

"One user or channel a connection can see, offered for somebody to pick."
type SlackSuggestion {
    "Slack's own id: \"C0123456789\", \"U0123456789\". Unique, and what a list keys its rows by."
    id: String!
    """
    What the field is filled with when this is picked, and what a person
    recognises: "#general", "@alice".

    Exactly what somebody could have typed, which is what keeps picking a
    convenience rather than a second way of saying things.
    """
    name: String!
    """
    Which of the two this row is.

    On the row rather than on the list, because one list holds both when
    `slackSuggestions` was asked without a `target`, and a row that cannot say
    which it is can be neither drawn nor acted on. A mark beside the name and
    nothing more: picking a row fills in `targetName`, which is all an action
    holds.
    """
    target: MessageTarget!
    """
    The member's own name where Slack has one and it says something the handle
    does not: "Alice Adams".

    Always null for a channel, whose one name is `name`, and null for a member
    whose name only repeats their handle.
    """
    realName: String
}

input CreateWorkspaceConnectionInput {
    workspaceId: ID!
    name: String!
    type: ConnectionType!
    "Required, except for the types that have one address: Slack is filled in."
    url: String
    "Ignored for Slack, which is always a bearer token."
    authType: AuthType
    secret: String
    """
    A workspace variable secret to read the credential from, instead of keeping
    a copy here. Sending this and `secret` together is refused rather than
    resolved by precedence.

    The variable has to be this workspace's and has to be of kind SECRET — a
    VALUE is returned with the variable listing, and a key on a listing is a key
    on a screen. It is referenced by id, so renaming it or moving it to another
    catalog does not disturb the connection, and deleting it is refused while
    anything reads it.
    """
    secretVariableId: ID
    "Slack's app-level token. Optional: with one the connection also listens."
    appToken: String
    "The app-level token's own reference, chosen separately from `secretVariableId`."
    appTokenVariableId: ID
    "Slack's user token (xoxp-). Optional: with one the connection can also search."
    userToken: String
    "The user token's own reference, chosen separately again."
    userTokenVariableId: ID
    "Where the mail server listens; null takes the port the security implies."
    smtpPort: Int
    "Who to log in as; null sends without authenticating, and the password arrives as secret."
    smtpUsername: String
    smtpFrom: String
    smtpSecurity: MailSecurity
    headers: [HttpHeaderInput!]
}

input UpdateWorkspaceConnectionInput {
    "Ignored for inherited connections, which follow the admin default."
    name: String
    type: ConnectionType
    url: String
    urlOverride: String
    authType: AuthType
    """
    Null leaves the stored credential alone; empty clears it, reference and all.
    A value stores a copy on the connection and drops any reference it held.
    """
    secret: String
    """
    Points the credential at a workspace variable secret, dropping any copy it
    held. Null leaves it as it is. Sending it together with `secret` is refused:
    that is a caller who has not chosen between the two.
    """
    secretVariableId: ID
    "Slack's app-level token, with the same null and empty meaning."
    appToken: String
    "And the app-level token's own reference, chosen separately from `secretVariableId`."
    appTokenVariableId: ID
    "Slack's user token, with the same null and empty meaning."
    userToken: String
    "And the user token's own reference, chosen separately again."
    userTokenVariableId: ID
    smtpPort: Int
    smtpUsername: String
    smtpFrom: String
    smtpSecurity: MailSecurity
    headers: [HttpHeaderInput!]
}

"An MCP server a workspace's agents may connect to."
type McpServer {
    id: ID!
    workspaceId: ID!
    name: String!
    address: String!
    authType: AuthType!
    headers: [HttpHeader!]!
    "Whether the server holds a credential of its own. False for one reading a variable."
    secretSet: Boolean!
    """
    The workspace variable secret the credential is read from, or null when the
    server keeps its own copy. Those are the two, and they are exclusive.
    """
    secretVariableId: ID
    "What that variable is called and which catalog holds it, for drawing the reference."
    secretVariableName: String
    secretVariableCatalog: String
    "A reference pointing at nothing, reported rather than assumed away."
    secretVariableMissing: Boolean!
    """
    Whether the last check reached the server. Null until the first one, which
    the screen draws as neither reachable nor failed rather than as a failure.
    Kept up to date on a timer, so the list says which servers answer now.
    """
    reachable: Boolean
    "When that check was made, ISO-8601, or null before the first one."
    lastCheckedAt: String
    "The sentence that check came back with, the same the Check button shows."
    checkDetail: String
    "How many tools it offered on a check that got that far."
    toolCount: Int
}

"What pressing Check on an MCP server found."
type McpServerCheck {
    reachable: Boolean!
    "One sentence: what worked, or which part did not and what the server said about it."
    detail: String!
    "How many tools it offered, on a check that got that far."
    tools: Int
}

input CreateMcpServerInput {
    workspaceId: ID!
    name: String!
    address: String!
    authType: AuthType
    secret: String
    """
    A workspace variable secret to read the credential from, instead of keeping
    a copy here. This workspace's, kind SECRET, by id — and not together with
    `secret`, which is refused rather than resolved by precedence.
    """
    secretVariableId: ID
    headers: [HttpHeaderInput!]
}

input UpdateMcpServerInput {
    name: String!
    address: String!
    authType: AuthType
    "Null leaves the stored credential alone; empty clears it, reference and all."
    secret: String
    """
    Points the credential at a workspace variable secret, dropping any copy it
    held. Null leaves it as it is; sending it with `secret` is refused.
    """
    secretVariableId: ID
    headers: [HttpHeaderInput!]
}

"""
What the Models screen says about a provider. CONNECTED only once a check
reached it and it answered: a stored credential is not a working one.
"""
enum ProviderStatus {
    NOT_CONFIGURED
    NOT_CHECKED
    CONNECTED
    FAILED
}

"""
The services a provider can be; each brings its own settings and its own way in.

The type names the wire format, not the company: anything OpenAI-shaped at an
address of its own is `OPENAI`, whoever is answering at that address.
"""
enum ProviderType {
    OPENAI
    ANTHROPIC
    AZURE_OPENAI
    """
    Ollama. Give it the address it listens on, e.g. `http://host:11434` — the
    `/v1` its OpenAI-compatible surface lives under is added by the type, so
    nobody has to know it. An endpoint already written `.../v1` still works.
    """
    OLLAMA
}

"How a provider is authenticated. ENTRA_ID is Azure OpenAI only."
enum ProviderAuthMethod {
    API_KEY
    ENTRA_ID
}

"What a model is for."
enum ModelKind {
    CHAT
    EMBEDDING
    COMPLETION
    "Speech in, text out: what the microphone in a chat is handed to."
    TRANSCRIPTION
    "Text in, speech out: what reads an answer aloud."
    SPEECH
    """
    Text in, a picture out: what the picture button in a chat draws with.

    Its own endpoint rather than chat completions under another path, which is
    why a provider that has none is refused in a sentence rather than called.
    """
    IMAGE
}

"How often a token quota starts again; NEVER makes it a total rather than a rate."
enum ResetInterval {
    DAILY
    WEEKLY
    MONTHLY
    NEVER
}

"""
An LLM provider a workspace reaches models through. The credential is never returned
here — revealing one is a mutation, and it is audited.
"""
type ModelProvider {
    id: ID!
    workspaceId: ID!
    "The workspace's own name for it, e.g. \"Azure OpenAI Production\"."
    name: String!
    type: ProviderType!
    endpoint: String!
    authMethod: ProviderAuthMethod!
    "Azure OpenAI's own settings; null on every other type."
    apiVersion: String
    deploymentName: String
    region: String
    "Entra ID. The client secret is held with the keys and is not returned."
    tenantId: String
    clientId: String
    scope: String
    """
    Whether the timed sweep is allowed to call this provider. False is a
    provider nobody wants polled — a model server that is only sometimes
    running — and it is why the status beside it may stay `NOT_CHECKED`.
    Test Connection, and every chat and task the provider serves, ignore it.
    """
    checkEnabled: Boolean!
    status: ProviderStatus!
    "What the last check found, and when it ran."
    lastCheckMessage: String
    lastCheckedAt: String
    "Whether the provider holds a credential of its own. False for one reading a variable."
    secretSet: Boolean!
    """
    The workspace variable secret this provider reads its credential from, or
    null when it keeps its own copy. Those are the two, and they are exclusive.
    """
    secretVariableId: ID
    """
    What that variable is called and which catalog holds it, for showing the
    reference without a second round trip. Null when there is no reference, and
    also when there is one that points at nothing — see `secretVariableMissing`.
    """
    secretVariableName: String
    secretVariableCatalog: String
    """
    A reference pointing at nothing. A variable a provider reads cannot be
    deleted, so this should not happen — but a restore or a database edited by
    hand can produce one, and a provider that cannot say why it has no key is
    the failure worth reporting rather than assuming away.
    """
    secretVariableMissing: Boolean!
}

"""
A model a provider says it can run.

`added` rather than leaving the ones already in the catalogue out: a picker that
silently drops them looks like the provider stopped offering them.
"""
type DiscoveredModel {
    "What the provider's API is given."
    modelId: String!
    added: Boolean!
}

"One model the workspace may use, with the quotas the workspace put on it."
type Model {
    id: ID!
    providerId: ID!
    workspaceId: ID!
    providerName: String!
    "What a person calls it."
    name: String!
    "What the provider's API is given, e.g. claude-3-5-sonnet-20241022."
    modelId: String!
    kind: ModelKind!
    contextWindow: Int
    maxOutput: Int
    enabled: Boolean!
    "Null is no limit."
    tokenLimit: Float
    resetInterval: ResetInterval!
    requestsPerMinute: Int
    "What the provider charges per million tokens; null when it is not recorded."
    inputCostPerMillion: Float
    outputCostPerMillion: Float
    "Which voice a SPEECH model reads in; null sends none and takes the provider's."
    voice: String
    """
    Whether a SPEECH model is handed text with its empty lines taken out.

    A blank line is a thing the eye reads and the ear cannot, and readers differ
    on what to do with one. It governs the text handed over, never where an
    answer is cut.
    """
    skipEmptyLines: Boolean!
    """
    What one picture costs on an IMAGE model. Null means nobody recorded it,
    which is not the same as free - these models are billed per picture and
    report no tokens, so the per-million prices beside this would cost a month
    of drawing at nothing.
    """
    imageCostPerImage: Float
}

"One day of the usage chart."
type ModelUsageDay {
    "ISO-8601 date."
    day: String!
    requests: Int!
    "Whole tokens. Float because a busy day can outgrow a 32-bit Int."
    tokens: Float!
}

"""
What a model has been used for, summed over the days it was used on.

Every number here comes from recorded calls, so a model nothing has called
reports `empty` rather than a set of zeros dressed up as a result.
"""
type ModelUsage {
    modelId: ID!
    "The window, and what it covers, as ISO-8601 dates."
    days: Int!
    from: String!
    to: String!
    "True when nothing was recorded in the window."
    empty: Boolean!
    requests: Int!
    "Whole tokens, as Float for the range rather than for the precision."
    inputTokens: Float!
    outputTokens: Float!
    totalTokens: Float!
    averageLatencyMillis: Float!
    "Null when the model carries no prices to work it out from."
    costEstimate: Float
    "Change against the window before this one, as a fraction; null when there was no such window."
    requestsChange: Float
    tokensChange: Float
    latencyChange: Float
    "Only the days something happened on."
    series: [ModelUsageDay!]!
    "Where the quota is counting from, following the reset interval."
    periodStart: String!
    periodTokens: Float!
}

input CreateModelProviderInput {
    workspaceId: ID!
    name: String!
    endpoint: String!
    type: ProviderType
    authMethod: ProviderAuthMethod
    "The API key, or the Entra client secret. Not together with `secretVariableId`."
    secret: String
    """
    A workspace variable secret to read the credential from, instead of keeping
    a copy here. Every provider type supports both; sending this and `secret`
    together is refused rather than resolved by precedence.

    The variable has to be this workspace's and has to be of kind SECRET — a
    VALUE is returned with the variable listing, and a key on a listing is a key
    on a screen. It is referenced by id, so renaming it or moving it to another
    catalog does not disturb the provider, and deleting it is refused while a
    provider reads it.
    """
    secretVariableId: ID
    apiVersion: String
    deploymentName: String
    region: String
    tenantId: String
    clientId: String
    scope: String
    "Whether the timed sweep may call it. Null is true: a new provider is checked."
    checkEnabled: Boolean
}

input UpdateModelProviderInput {
    name: String!
    endpoint: String!
    type: ProviderType
    authMethod: ProviderAuthMethod
    """
    Null leaves the stored credential alone; empty clears it, reference and all.
    A value stores a copy on the provider and drops any reference it held.
    """
    secret: String
    """
    Points the provider at a workspace variable secret, dropping any copy it
    held. Null leaves the credential as it is. Sending it together with `secret`
    is refused: that is a caller who has not chosen between the two.

    Same rules as on create — this workspace's, kind SECRET, referenced by id.
    """
    secretVariableId: ID
    apiVersion: String
    deploymentName: String
    region: String
    tenantId: String
    clientId: String
    scope: String
    "Whether the timed sweep may call it. Null leaves it as it is."
    checkEnabled: Boolean
}


"The model's own details, all of them: the form that edits them sends every field."
input CreateModelInput {
    providerId: ID!
    name: String!
    modelId: String!
    kind: ModelKind
    contextWindow: Int
    maxOutput: Int
    tokenLimit: Float
    resetInterval: ResetInterval
    requestsPerMinute: Int
    inputCostPerMillion: Float
    outputCostPerMillion: Float
    "Which voice a SPEECH model reads in; the names are the provider's own."
    voice: String
    "Whether a SPEECH model is handed text with its empty lines taken out. Absent is off."
    skipEmptyLines: Boolean
    "What one picture costs on an IMAGE model; null is not recorded, which is not free."
    imageCostPerImage: Float
}

input UpdateModelInput {
    name: String!
    modelId: String!
    kind: ModelKind
    contextWindow: Int
    maxOutput: Int
    inputCostPerMillion: Float
    outputCostPerMillion: Float
    "Which voice a SPEECH model reads in; the names are the provider's own."
    voice: String
    "Whether a SPEECH model is handed text with its empty lines taken out. Absent is off."
    skipEmptyLines: Boolean
    "What one picture costs on an IMAGE model; null is not recorded, which is not free."
    imageCostPerImage: Float
}

"The Quotas and Limits card. Null is no limit, which is what an emptied box means."
input ModelQuotasInput {
    tokenLimit: Float
    resetInterval: ResetInterval
    requestsPerMinute: Int
}

"Where one node of the graph got to in a run."
enum StepStatus {
    "Never reached, because the run stopped or has not got there yet."
    PENDING
    RUNNING
    "Parked until a time passes or something the step waits on holds."
    WAITING
    COMPLETED
    FAILED
    SKIPPED
}

enum LogLevel {
    INFO
    SUCCESS
    ERROR
}

"One node of the graph as a run saw it."
type ExecutionStep {
    "Matches the workflow node it came from; what edges and logs refer to."
    key: String!
    kind: NodeKind!
    name: String!
    description: String
    status: StepStatus!
    "ISO-8601 offset date-time."
    startedAt: String
    finishedAt: String
    durationSeconds: Int
    "What the step was handed and what it produced, as the engine recorded it."
    input: String
    output: String
    error: String
    "The catalogue entry the step ran, so the run can link back to it."
    actionId: ID
    conditionId: ID
    "The agent an agent step ran, for the same link back to its definition."
    agentId: ID
    """
    Which way out this step sent the run; null where it answered nothing.
    FAILURE on a failed step means the run went on down its failure edge rather
    than stopping there.
    """
    branch: EdgeBranch
    "How many attempts the step spent; more than one only where its node was given a retry policy and needed it."
    attempts: Int!
    "Copied from an earlier run rather than performed here, which is what every step ahead of a re-run's starting point is."
    carriedOver: Boolean!
    x: Float!
    y: Float!
}

type ExecutionLogLine {
    id: ID!
    "Null for lines about the run itself rather than one step."
    nodeKey: String
    "ISO-8601 offset date-time."
    at: String!
    level: LogLevel!
    message: String!
}

type ExecutionDetail {
    id: ID!
    workspaceId: ID!
    workflowId: ID!
    workflowName: String!
    status: ExecutionStatus!
    trigger: ExecutionTrigger!
    startedAt: String!
    finishedAt: String
    durationSeconds: Int
    "The node that ended the run early, when a condition did not hold."
    stoppedAtNodeKey: String
    "What that node said; null for a run that went all the way through."
    stoppedReason: String
    "Why the run stopped, when it stopped badly."
    error: String
    """
    The run this one was started from, when somebody re-ran an earlier one -
    all of it, or from one of its steps. Null for a run nobody re-ran.
    """
    startedFrom: ID
    steps: [ExecutionStep!]!
    edges: [WorkflowEdge!]!
    logs: [ExecutionLogLine!]!
    "Temporal's own screen for this run; null when there is nowhere to send anybody."
    temporalUrl: String
    """
    Whether this workspace still lists the workflow this run named. False for a
    run whose workflow has been removed, which is why the page names it without
    linking to it.
    """
    workflowAssigned: Boolean!
    "The pictures this run's image nodes drew, each keyed to the step that drew it."
    pictures: [ExecutionPicture!]!
    """
    What this run said out loud, each keyed to the step that said it.

    Empty for a run that spoke nothing, which is most of them. A run produces
    audio where it reaches a node that speaks; sending it anywhere is a separate
    node, because keeping the file and sending it are two decisions.
    """
    speeches: [ExecutionSpeech!]!
}

"One thing a run said out loud, as the run graph plays it."
type ExecutionSpeech {
    id: ID!
    "Which step said it, so the graph plays it under that node."
    nodeKey: String!
    "Where the bytes are served: an <audio src> and the download."
    url: String!
    "The words it read, because audio cannot be read at a glance."
    said: String!
    filename: String!
    contentType: String!
}

"One picture an image node drew, as the run graph shows it."
type ExecutionPicture {
    id: ID!
    "Which step drew it, so the graph shows it under that node."
    nodeKey: String!
    "Where the bytes are served: an <img src> and the download."
    url: String!
    "What it was drawn from, its alt text."
    prompt: String!
    filename: String!
    contentType: String!
}

"What a variable holds. Scalars only: a shape belongs in the object catalogue."
enum VariableType {
    STRING
    NUMBER
    BOOLEAN
}

"""
Whether a variable is something to keep out of sight. Both are encrypted at
rest; what differs is the screen.
"""
enum VariableKind {
    "Read with the list: a channel name, a threshold, a URL."
    VALUE
    "Shown only when somebody asks, and the asking is recorded."
    SECRET
}

"A folder of variables."
type VariableCatalog {
    id: ID!
    workspaceId: ID!
    name: String!
    "What the count badge shows, so an empty catalog reads as empty."
    variableCount: Int!
    createdAt: String!
    createdBy: String!
}

"A named value a workspace keeps. The value itself never leaves the server."
type Variable {
    id: ID!
    workspaceId: ID!
    catalogId: ID!
    catalogName: String!
    name: String!
    "What it is for, since the name has to be an identifier."
    description: String
    type: VariableType!
    kind: VariableKind!
    "What it holds, on a value. Null on a secret, whatever is stored."
    value: String
    "Whether anything is stored, which is all a secret says about itself."
    valueSet: Boolean!
    createdAt: String!
    "Who put it there; the person who knows what it is for."
    createdBy: String!
    lastModifiedAt: String!
    lastModifiedBy: String!
}

type VariablePage {
    content: [Variable!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

input CreateVariableInput {
    workspaceId: ID!
    "Which catalog holds it; every variable is in one."
    catalogId: ID!
    name: String!
    description: String
    type: VariableType!
    "Whether it may be read with the list, or only on request."
    kind: VariableKind! = SECRET
    value: String
}

input UpdateVariableInput {
    "Moves it to another catalog; null leaves it where it is."
    catalogId: ID
    name: String
    description: String
    type: VariableType
    "Whether it may be read with the list, or only on request."
    kind: VariableKind
    "Null leaves the stored value alone."
    value: String
}

"How a webhook decides whether its caller may start anything."
enum WebhookAuthType {
    "Knowing the path and the shape is enough."
    NONE
    "One of the workspace's functions is asked, and answers yes or no."
    FUNCTION
}

"""
A plugin loaded into this installation.

The source is not here. A list of what is loaded does not need the text of it,
and a plugin is large enough that sending every one to draw a table would be
waste.

Nothing on this type describes what a plugin *does* — no entry point, no
capabilities, no grants. That is work still to come, and guessing at it here
would put fields in the schema that mean nothing yet.
"""
type Plugin {
    id: ID!
    """
    What the plugin calls itself.

    Its identity rather than the file's — loading this id again replaces what is
    loaded — and the prefix on every function it declares, so `isTeammate` arrives
    as `teammates_isTeammate`.
    """
    key: String!
    "Taken from the filename it was uploaded as, without the extension."
    name: String!
    filename: String!
    sizeBytes: Float!
    "The plugin API the plugin said it uses. Only versions this server knows are stored."
    apiVersion: Int!
    """
    The functions this plugin says it offers, as it declared them.

    The declaration, not the registration. These become callable once they are
    materialised as organisation-level functions; until then this is what the
    plugin claims it brings.
    """
    declaredFunctions: [PluginFunctionDeclaration!]!
    """
    What this plugin says it has to be told before it can work.

    The declaration only. What a workspace set them to is on `WorkspacePlugin`,
    because the answers belong to a workspace and the question does not.
    """
    declaredParameters: [PluginParameterDeclaration!]!
    """
    The JavaScript this plugin was granted: what it declared, and what a person
    accepted. The two are the same for a loaded plugin — it is refused otherwise.

    Shown to whoever reads the list rather than only to whoever accepted it. A
    decision about what somebody else's code may do that lives in a dialog
    somebody clicked through last month is a decision nobody can audit.
    """
    permissions: [PluginPermission!]!
    "ISO-8601 offset date-time. Null when the plugin asked for nothing."
    permissionsAcceptedAt: String
    "Null when the plugin asked for nothing, so nobody accepted anything."
    permissionsAcceptedBy: String
    "Of the source text, so an unchanged re-upload is recognisable."
    sha256: String!
    "ISO-8601 offset date-time."
    uploadedAt: String!
    uploadedBy: String!
    """
    Whether this plugin is switched on.

    A plugin switched off keeps everything — its rows, its edited functions,
    every workspace's answers to its parameters — and offers nothing: its
    functions are not callable and its tools leave the agents' menus. That is
    the difference from unloading, which takes the lot.
    """
    enabled: Boolean!
    """
    The library files it ships with, by path. Empty for a single-file plugin.

    What somebody allowed when it was loaded: these travel with the plugin and
    are evaluated ahead of it, so the list is part of what the plugin *is*.
    """
    libraries: [String!]!
    """
    The shapes this plugin exports, as it declared them.

    The declaration, not the registration — the same split the functions have.
    These become something a workspace can point at as `workflow_object` rows
    under the plugin's key, so `Issue` declared by `jira` is `jira_Issue`;
    `pluginObjects` is where those are read. The names here are the plugin's
    own, unprefixed, because this is what the plugin said.
    """
    objects: [PluginObject!]!
    """
    The instruction sets this plugin brings.

    A third surface beside its functions and its tools, and the one that does
    not run: markdown an agent reads before doing something, so the knowledge
    of how this plugin's work is meant to be done travels with the code that
    does it. They reach an agent as a catalog named after the plugin's key,
    granted from the same field every other catalog is. Nothing is automatic.
    """
    skills: [PluginSkill!]!
    """
    The marketplace key this was installed from, and the version at that
    moment — null for a plugin loaded from a file or a URL of somebody's own.

    Kept so a catalog listing and an installed row can be lined up: the screen
    compares this version against the catalog's to offer an update, and
    nothing here is re-checked against the marketplace on its own.
    """
    marketplaceKey: String
    marketplaceVersion: String
    """
    The face it wears: the SVG itself, or an emoji standing as itself.

    Copied in when it was installed rather than pointed at — the marketplace
    hosts the file, but a plugin loaded here has to draw on a screen whose
    installation may never reach the marketplace again. Null for a plugin
    loaded from a file, which brought no face.
    """
    icon: String
    """
    The same glyph in white, for a dark ground. Null where the plugin has only
    the one, and then `icon` is drawn on either.

    Two files rather than one that adapts: an SVG loaded through an `<img>` is
    its own document, inherits no colour from the page around it, and resolves
    `currentColor` to black — which on a dark screen is a square of nothing.
    """
    iconDark: String
    """
    What the plugin says it is for, in a line — from the `plugin.json` it
    ships beside itself. Null for one that ships no manifest.

    Prose, and only prose: what a plugin is allowed to do is read from the
    code at the moment somebody accepts it, never from what it says about
    itself here.
    """
    summary: String
    "Who wrote it, as its manifest says."
    author: String
    """
    What the plugin calls its own version — not `marketplaceVersion`, which
    is what the catalog offered it as. The two are usually equal and mean
    different things, and the update comparison uses the catalog's.
    """
    version: String
}

"""
One plugin the marketplace offers, as this installation sees it.

Everything down to `published` is the marketplace's own answer, passed
through; `installed`, `installedVersion` and `updatable` are this server's,
folded in so the catalog screen does not have to line two lists up itself.
"""
type MarketplaceListing {
    key: String!
    name: String!
    author: String!
    summary: String!
    "Markdown, from a public repository. Rendered sanitized by whoever shows it."
    description: String!
    version: String!
    """
    The drawing itself, or an emoji. Null where the catalog offers none.

    An icon hosted on the marketplace is fetched by this server and carried
    here as its markup, so the picture reaches a screen through the same proxy
    rules everything else does — a browser fetching it from the marketplace is
    a call those rules have no say over, and on an installation whose egress is
    a proxy it was a broken square on every row. A URL comes through unchanged
    where it is hosted somewhere this server will not fetch from.
    """
    icon: String
    "The same glyph for a dark ground; null where the catalog offers only one."
    iconDark: String
    downloads: Int!
    rating: Float
    reviews: Int!
    "ISO-8601 date."
    published: String!
    "Whether a plugin with this key is loaded here."
    installed: Boolean!
    """
    What is installed here, however it got here: the version recorded when it
    came from the catalog, or the plugin's own claim where it was loaded from
    a file.

    Null only for a plugin that records no version anywhere, which is one
    loaded before either was kept — and that one the screen offers to update
    rather than calling it current.
    """
    installedVersion: String
    """
    Installed, and the catalog is offering a version this one is not.

    Held against `installedVersion` rather than against what the catalog
    last handed over: those differ for a plugin loaded from a file, and
    comparing the wrong one offered an update from 0.13.1 to 0.13.1.
    """
    updatable: Boolean!
    """
    What the plugin is for, in its author's own words — `chat`, `files`,
    `search`. Lowercase, and empty for one that said nothing rather than null.

    A list rather than one word: a plugin is usually more than one thing, and
    filing it under whichever of those somebody picked hid it from the readers
    looking for the other two.
    """
    tags: [String!]!
    """
    Every release, newest first, or empty from a marketplace that does not
    keep them. See the note on `available`.
    """
    versions: [MarketplaceRelease!]!
}

"""
One version of a plugin, as the marketplace remembers it.

A listing answers with its whole history and not only what is current, which
is what lets a details pane say how long a plugin has been maintained rather
than showing one number and leaving somebody to guess.
"""
type MarketplaceRelease {
    version: String!
    "ISO-8601. When this version first appeared; it never moves again."
    published: String!
    "ISO-8601. When its bytes last changed — the same as `published` for most."
    replaced: String!
    "How many files it shipped with, the plugin and its libraries together."
    files: Int!
    """
    Whether its bytes are still held.

    The marketplace keeps the record of every release and the files of the ten
    newest, so an older version is real, nameable, and cannot be installed.
    A screen should say so on the row; the alternative is a failure at the
    moment somebody pressed Install.
    """
    available: Boolean!
    """
    What changed in this version, as the author wrote it when publishing.

    Markdown. Empty for a release published without any, and for a
    marketplace too old to be asked - see the ladder in `Marketplace`.
    """
    notes: String!
}

"""
What an install came to: the plugin, or the agreement it is waiting on.

A payload rather than an error, because a pending agreement is a decision
nobody has made yet — the same shape the upload endpoint answers a refused
load with. `plugin` is null exactly when the lists below are not empty, and
in that case nothing was installed.
"""
type MarketplaceInstall {
    plugin: Plugin
    needsPermissions: [PluginPermission!]!
    needsCapabilities: [PluginPermission!]!
    "Paths only; a screen keeps this list folded by default."
    needsLibraries: [String!]!
    "The refusal in a sentence, for a screen to print above the lists."
    message: String
}

"""
One function a plugin says it offers.

Types are reported as the server's own names rather than the plugin's spelling of
them: a declaration is only kept if every type in it resolved.
"""
type PluginFunctionDeclaration {
    name: String!
    description: String
    params: [PluginFunctionParam!]!
    returnType: String!
    """
    The plugin's own name for the shape it returns — `Issue`, not `jira_Issue`
    — where it returns one of the shapes it exports. Null otherwise, and then
    `returnType` is the whole answer.
    """
    returnObject: String
    "\"(key: string): Issue\", ready for the list. A shape reads as its name."
    signature: String!
}

type PluginFunctionParam {
    name: String!
    type: String!
    "The plugin's own name for the shape, where the type names one."
    objectName: String
    """
    Whether a call has to supply it. True for everything declared before a
    plugin could say otherwise, which is what every caller already assumed.
    """
    required: Boolean!
    """
    What arrives when an optional one is left out, as JSON — `20`, `"utc"`,
    `[]`. Null means null, which is what a function got before it could say.

    This is what a plugin used to spell as a sentinel: "0 for the default", in
    a sentence a model read on every call and sometimes got wrong.
    """
    default: String
}

"""
One tool a plugin offers to agents, for the grant list.

Named with the plugin's key prefix - the name here is exactly what goes into an
agent's grant list. Most tools front one of the plugin's own functions; those
carry the function's id so the list can offer the jump to its page.
"""
type PluginAgentTool {
    name: String!
    "Written for the model that will read it."
    description: String
    "The plugin that offers it, by its display name."
    plugin: String!
    "The function this tool fronts, when it fronts one. Null for a tool with its own run."
    functionId: ID
}

"""
One piece of JavaScript a plugin may be granted.

The list this server can grant is closed, and its being closed is the point of
it: there is no name for reading a file, opening a socket or reaching a Java
class, so a plugin cannot ask for one and nobody can grant one. Every entry only
switches on a language builtin, for the one plugin it was accepted for.
"""
type PluginPermission {
    name: String!
    "What it gives, in the words the person accepting it was shown."
    summary: String!
}

"""
One thing a plugin says it has to be told before it can work.

Not a function's parameter. A function's is filled in by whoever calls it, node
by node; this is filled in once by a workspace and is the same for every call -
the address a plugin talks to, the token it talks with.
"""
type PluginParameterDeclaration {
    name: String!
    description: String
    "One of the types a workspace variable can hold: STRING, NUMBER or BOOLEAN."
    type: String!
    "Whether the plugin can work without it. A required one left unanswered is marked."
    required: Boolean!
    """
    Whether the plugin says it is asking for something that should not be typed
    into a form. One of these can only be answered by pointing at a variable.
    """
    secret: Boolean!
    """
    The values this may take, where the plugin knows them all. Empty where
    anything typed will do.

    A set makes the settings field a picker rather than a text box — which is
    what saves a plugin checking the string by hand and writing the sentence
    that lists the choices, and means a value that is not on the list cannot
    be typed rather than being discovered at the first call.
    """
    options: [String!]!
}

"""
A plugin as one workspace sees it: what it asked for, and what this workspace
answered.
"""
type WorkspacePlugin {
    plugin: Plugin!
    parameters: [PluginParameterSetting!]!
    """
    The required parameters this workspace has not answered, by name.

    Empty when the plugin has everything it asked for. Non-empty is what the red
    mark beside it in the list is drawn from, and it holds exactly the names the
    parameters below are marked on.
    """
    missing: [String!]!
}

"One of a plugin's parameters, and what this workspace set it to."
type PluginParameterSetting {
    name: String!
    description: String
    type: String!
    "Which kind of connection a `connection` parameter takes; null for every other type."
    connectionType: String
    required: Boolean!
    secret: Boolean!
    """
    The values this may take, where the plugin knows them all; empty where
    anything typed will do.

    Here as well as on the declaration because this is the view the settings
    form reads, and a picker is drawn from what a parameter may be.
    """
    options: [String!]!
    """
    What somebody typed. Null when this points at a variable, is unanswered, or
    is a secret — a secret typed here is stored encrypted and never returned,
    and `secretSet` is how a screen learns there is one.
    """
    literal: String
    """
    Whether a secret has been typed into this parameter, which is all this
    says.

    Never the value. The point of keeping a typed secret in an encrypted column
    is that nothing carries it back out — not to this screen, not to a
    screenshot of it. What a person needs from the page is whether the thing is
    answered, and that is one boolean.
    """
    secretSet: Boolean!
    "Which of the workspace's variables this reads. Null when it was typed in."
    variableId: ID
    """
    The name of that variable, and never what it holds.

    A workspace's secrets are read on the variables screen, where reading one is
    recorded as something somebody did. This page is not a way around that.
    """
    variableName: String
    "Required, and nothing usable is set for it. What the mark against it is drawn from."
    missing: Boolean!
}

"A file somebody attached to a chat. The bytes are wherever the storage put them."
type ChatAttachment {
    id: ID!
    filename: String!
    contentType: String!
    sizeBytes: Float!
    uploadedBy: String!
}

"""
What this installation allows, as the configuration file and the screen agree
it. The file is the floor: what it forbids cannot be switched back on here.
The exception is `metricsAnonymous`, whose floor would be its own ceiling; the
field says why.
"""
type InstallationSettings {
    attachmentsEnabled: Boolean!
    "False when the configuration file has said no, and the switch is not offered."
    attachmentsConfigurable: Boolean!
    "Where the bytes go; FILESYSTEM is the only one today."
    attachmentStorage: String!
    "The directory they are written under, shown so it can be checked."
    attachmentLocation: String!
    attachmentMaxFileSizeMb: Int!
    "Whether this installation has a chat at all."
    chatEnabled: Boolean!
    "False when the configuration file has said no, and the switch is not offered."
    chatConfigurable: Boolean!
    """
    Whether `/actuator/prometheus` answers a caller who has not signed in.

    The one field here the file does not put a floor under, because for this one
    the file's default is already the closed answer and a floor would mean the
    switch could never be pressed. ORKNUX_METRICS_ANONYMOUS is what a fresh
    installation starts at; what an administrator stored is the answer after
    that, and it takes effect on the next scrape rather than the next restart.
    """
    metricsAnonymous: Boolean!
    "What a fresh installation would have answered: ORKNUX_METRICS_ANONYMOUS."
    metricsAnonymousConfigured: Boolean!
    "How many days of component history are kept. 14 unless somebody has said otherwise."
    revisionRetentionDays: Int!
    "What a fresh installation would keep - ORKNUX_REVISION_RETENTION_DAYS."
    revisionRetentionDaysConfigured: Int!
    executionRetentionDays: Int!
    executionRetentionDaysConfigured: Int!
    """
    How many minutes a task may sit queued before something hands it over again.

    The net under the hand-over: a task whose start was lost - to a process
    killed at the wrong moment, or a workflow that could not run - would
    otherwise say QUEUED for ever. 5 unless somebody has said otherwise.
    """
    taskSweepMinutes: Int!
    "What a fresh installation would wait - ORKNUX_TASK_SWEEP_MINUTES."
    taskSweepMinutesConfigured: Int!
    """
    How large one of a plugin's source files may be, in KB - the plugin itself,
    each library it ships, and each file a load-from-URL fetches. 5120 unless
    somebody has said otherwise.
    """
    pluginMaxSourceKb: Int!
    "How long a plugin may take to load, in seconds."
    pluginTimeoutSeconds: Int!
    "What a fresh installation waits, before anybody changed it."
    pluginTimeoutSecondsConfigured: Int!
    "What a fresh installation allows: the built-in default."
    pluginMaxSourceKbConfigured: Int!
    """
    How many rounds of tool calls an agent gets before it must answer.

    One call to the model is a round: it answers, or it asks for tools and what
    it asks for is run and handed back. An agent may carry its own number; this
    is what the rest of them follow.
    """
    chatMaxRounds: Int!
    "What a fresh installation allows - ORKNUX_CHAT_MAX_ROUNDS."
    chatMaxRoundsConfigured: Int!
    """
    The longest one of an agent's own waits may be, in seconds.

    An agent may end its turn with a wake-up instead of an answer: the step parks
    and the run comes back to that node when the time is up. A model asking for
    longer than this is given this instead and told so.
    """
    agentSleepSeconds: Int!
    "What a fresh installation allows - ORKNUX_CHAT_SLEEP_SECONDS."
    agentSleepSecondsConfigured: Int!
    """
    How many times in a row one step's agent may wait; zero is never.

    The bound that stops a run going round for a week, because waiting is a
    decision the model takes again every time it wakes.
    """
    agentSleepTimes: Int!
    "What a fresh installation allows - ORKNUX_CHAT_SLEEP_TIMES."
    agentSleepTimesConfigured: Int!
    """
    Whether a conversation may be thrown away.

    A session is the record of what an agent was asked and what it answered, and
    on some installations that is the only account of a decision anybody has.
    True until an operator turns it off, which is how this has always worked.
    """
    sessionsRemovable: Boolean!
    """
    False where the installation runs Temporal, and the field is not offered.

    The sweep itself runs either way. What is not an administrator's decision on
    Temporal is how long it waits, so the control is drawn only for the engine
    that carries tasks in this process.
    """
    taskSweepConfigurable: Boolean!
}

"What a component reports about itself."
enum ComponentStatus {
    "Answering, and everything it depends on is answering too."
    HEALTHY
    "Answering, but something it depends on is not."
    DEGRADED
    "Not answering."
    DOWN
}

"The service, as the monitoring screen shows it."
type Component {
    name: String!
    description: String!
    status: ComponentStatus!
    version: String
    "What the check saw, ready to show."
    detail: String!
    "ISO-8601 offset date-time."
    lastCheckedAt: String!
    "What it needs to be up, and whether each of them was."
    dependencies: [Dependency!]!
}

"Something the service needs to be up."
type Dependency {
    name: String!
    description: String!
    reachable: Boolean!
    "What the check saw, ready to show."
    detail: String!
    "Its own interface, for the ones that have one."
    url: String
}

"What starts a workflow."
enum TriggerType {
    "An event arriving on one of the workspace's connections."
    INCOMING_CONNECTION
    "The clock, on a cron expression."
    SCHEDULED
    "A request arriving at a URL this installation answers on."
    WEBHOOK
}

"The event on a connection that starts the workflow."
enum TriggerAction {
    "The bot was named in a message: `@orknux deploy please`."
    MENTION
    """
    A thread reply to a message one of the workspace's own bots wrote.

    Which bots is `watchedConnectionIds`, and a reply trigger needs at least one:
    a reply carries `parent_user_id`, the author of the message its thread hangs
    under, and a bot token is a Slack user, so that id against those users is the
    whole of the match. Replies from bots never fire it - a workflow answering in
    a thread it watches would otherwise start itself for ever.
    """
    REPLY
    """
    Anything anybody types in a channel the bot is a member of.

    Far more traffic than a mention, and the same message can raise two events: a
    reply is a message, and Slack sends a mention as a message as well. Needs
    `channels:history` on the bot token, and `groups:`, `im:` or `mpim:` for the
    other kinds of conversation.
    """
    MESSAGE
    ISSUE_CREATED
    ISSUE_UPDATED
}

"Whether a connection's bot token was able to say which Slack user it posts as."
enum SlackBotUserOutcome {
    "Slack named the user, and `userId` is it."
    FOUND
    "No token, the app-level token in the bot token's place, a credential Slack refused, or Slack out of reach."
    UNCHECKED
}

"""
Which Slack user one of a workspace's connections posts as.

A bot token is a Slack user, which is why a reply trigger picks connections and
matches user ids. Two connections holding the same token are one Slack user twice
over and cannot be told apart by anything on an arriving event; `message` says so
where it is true rather than leaving a list of two rows to imply otherwise.

It never fails and never gates. A connection that could not be asked comes back
`UNCHECKED` with one line saying why, because a picker that empties itself in
silence reads as a broken installation. `createTrigger` and `updateTrigger` are
where a choice is refused.
"""
type SlackBotUser {
    connectionId: ID!
    "What the connection is called, so a list of these needs no second lookup."
    name: String!
    outcome: SlackBotUserOutcome!
    """
    One line, ready to show, and empty when there is nothing worth saying.

    Never carries a credential. What it says, in this order: why the token could
    not be asked; that this connection is the same Slack user as another; that
    messages will not arrive because the token carries no history scope.
    """
    message: String!
    "Slack's own id for the bot user, \"U0123456789\", when it was found. What `parent_user_id` is matched against."
    userId: String
    "What Slack calls that user, \"@orknux\", when it was found."
    handle: String
    """
    Whether the token carries a scope a channel's messages arrive under.

    Null where Slack did not say: a response carrying no scope header has
    reported no absence, and drawing one would send somebody to fix a token that
    is fine.
    """
    receives: Boolean
}

"One entry in a workspace's trigger catalogue. It names no workflow: a workflow instances it with a trigger node."
type Trigger {
    "The workflow this belongs to, where it is that workflow's own."
    workflowId: ID
    "How a webhook decides whether its caller may start anything."
    authType: WebhookAuthType!
    "The function that answers that, when one does."
    authFunctionId: ID
    authFunctionName: String
    "Where a webhook answers, relative to this installation: `build/finished`."
    webhookPath: String
    "The shape a webhook's request has to have; anything else is answered 404."
    objectId: ID
    "What that shape is called, for the list."
    objectName: String
    id: ID!
    workspaceId: ID!
    name: String!
    type: TriggerType!
    connectionId: ID
    action: TriggerAction
    """
    Whose messages a `REPLY` watches for replies to; empty on every other event.

    Not the connection it listens on. That one is the socket - the Slack app
    whose app-level token this installation receives events over. These are the
    bot tokens whose own messages count as a thread's parent, and they are
    usually other apps entirely.
    """
    watchedConnectionIds: [ID!]!
    cron: String
    timezone: String
    "JSON object handed to the runs this starts; null when it says nothing."
    payload: String
    "Asked of the event before anything starts; null fires on everything."
    conditionId: ID
    "The condition's name, for the list."
    conditionName: String
    "The most recent thing this trigger did; null when it has never been asked."
    lastFiring: TriggerFiring
    enabled: Boolean!
    "Where the event comes from, ready to show: the connection, or \"Cron\"."
    source: String!
    "What the event is, ready to show: \"Mention\", or the cron expression."
    event: String!
    "Which icon a node drawn from this starts with; null draws the kind's own."
    icon: String
}

"""
One thing a trigger did. The entries worth having are mostly the ones no run
came of: those appear nowhere else, which is what makes a working trigger and a
silent one look alike.
"""
type TriggerFiring {
    "Which trigger did it; null where the list is one trigger's own."
    triggerId: ID
    triggerName: String
    id: ID!
    "ISO-8601."
    at: String!
    outcome: FiringOutcome!
    "Worded as the screen shows it."
    detail: String
    runsStarted: Int!
}

enum FiringOutcome {
    "Runs were started."
    STARTED
    "No workflow points a trigger node at this definition."
    NO_INSTANCE
    "The trigger's condition turned the event down."
    CONDITION_DID_NOT_HOLD
    "The condition could not be decided, so nothing was started."
    UNDECIDED
    "Something went wrong starting a run."
    FAILED
    "A webhook call that could not prove it was allowed to make one."
    UNAUTHENTICATED
    "Every workflow this trigger reaches is switched off in its workspace."
    WORKFLOW_DISABLED
    "A reply arrived under a message none of the watched bots wrote. Written once, while the trigger has no other line."
    NOT_WATCHED
}

type TriggerFiringPage {
    content: [TriggerFiring!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

type TriggerPage {
    content: [Trigger!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

input CreateTriggerInput {
    "The workflow this belongs to, where it is that workflow's own."
    workflowId: ID
    "How a webhook decides whether its caller may start anything."
    authType: WebhookAuthType
    "The function that answers that; null when nothing does."
    authFunctionId: ID
    "Where a webhook answers, relative to this installation: `build/finished`."
    webhookPath: String
    "The shape a webhook's request has to have; anything else is answered 404."
    objectId: ID
    workspaceId: ID!
    name: String!
    type: TriggerType!
    "Required for an incoming connection trigger."
    connectionId: ID
    action: TriggerAction
    """
    Whose messages a `REPLY` watches for replies to. Required on one, ignored on
    every other event.

    Slack connections in the same workspace, and each has to be able to say which
    Slack user it posts as - a token that will not authenticate is refused here
    rather than making a trigger that is enabled, instanced and permanently deaf.
    `slackBotUsers` is what a picker draws from and what says why one cannot.
    """
    watchedConnectionIds: [ID!]
    "Required for a scheduled trigger; five or six cron fields."
    cron: String
    timezone: String
    "JSON object handed to the runs this starts."
    payload: String
    "Asked of the event before anything starts; null asks nothing."
    conditionId: ID
    "Which icon a node drawn from this starts with; null draws the kind's own."
    icon: String
    "Whether it fires at all. Omitted makes one that does."
    enabled: Boolean
}

input UpdateTriggerInput {
    """
    What kind of trigger it is; null leaves it alone.

    Honoured only for a definition a workflow owns: a shared trigger's kind is
    what it is, because several workflows may point at one and changing it
    under them rewrites every one of them.
    """
    type: TriggerType
    "How a webhook decides whether its caller may start anything."
    authType: WebhookAuthType
    "The function that answers that; null when nothing does."
    authFunctionId: ID
    "Where a webhook answers, relative to this installation: `build/finished`."
    webhookPath: String
    "The shape a webhook's request has to have; anything else is answered 404."
    objectId: ID
    name: String!
    connectionId: ID
    action: TriggerAction
    "Whose messages a `REPLY` watches; omitted or empty watches nobody, which only a reply minds."
    watchedConnectionIds: [ID!]
    cron: String
    timezone: String
    payload: String
    "Asked of the event before anything starts; null asks nothing."
    conditionId: ID
    "Which icon a node drawn from this starts with; null draws the kind's own."
    icon: String
    "Whether it fires at all; omitted leaves it as it stands."
    enabled: Boolean
}

"The shape of a value crossing between a workflow and a script."
enum ValueType {
    STRING
    NUMBER
    BOOLEAN
    "One of the workspace's objects, named by the objectId beside it."
    OBJECT
    "Keys and values with no defined shape. What OBJECT meant before objects could be named."
    MAP
    ARRAY
    """
    One of the workspace's connections.

    What crosses is the connection's id - a payload carries text, so a trigger
    publishes the one its event arrived on as a string. The type is about saying
    what the value is for: the panel offers the workspace's connections rather
    than a free box, and a call that takes one accepts it.
    """
    CONNECTION
    "Nothing at all: a function that acts rather than answers."
    NONE
}

"A variable a function is handed, after the parameters it declares."
type FunctionExternal {
    variableId: ID!
    name: String!
    type: VariableType!
}

"Where a function came from, and therefore whether a workspace may change it."
enum FunctionScope {
    "Written in a workspace, editable there."
    WORKSPACE
    """
    Declared by a plugin and available in every workspace. Usable from actions,
    triggers and conditions; not editable, because the plugin defines it.

    Named for where it came from rather than how far it reaches: a picker should
    say which plugin brought a function, not that it is "organisation-wide".
    """
    PLUGIN
}

"""
The plugin a function came from.

Enough to name it and link to it. Reported on the function because listing
plugins is an administrator's query, while picking a function is not — so a
picker can say "from Teammates" without being allowed to see what is loaded.
"""
type FunctionPlugin {
    id: ID!
    name: String!
}

"A named piece of JavaScript a workspace wrote, run in a sandbox with no host, files or network."
type Function {
    "The workspace's variables it is handed, after the parameters it declares."
    externals: [FunctionExternal!]!
    id: ID!
    "Null for a plugin's function: it belongs to no single workspace."
    workspaceId: ID
    scope: FunctionScope!
    "False for anything a plugin declared. The editor hides its controls on this."
    editable: Boolean!
    "Which plugin brought it, for anything a plugin declared. Null for a workspace's own."
    plugin: FunctionPlugin
    name: String!
    description: String
    "The JavaScript that runs, compiled from the TypeScript below."
    source: String!
    "What it was written in. Null for a plugin's function, which was not written here."
    typescript: String
    returnType: ValueType!
    "Which object it returns, when the return type is OBJECT."
    returnObjectId: ID
    returnObjectName: String
    params: [FunctionParam!]!
    "How long one call may run, in seconds. Null means the workspace decides."
    timeoutSeconds: Int
    """
    The workspace's other functions it calls, under the names it calls them.

    Not arguments. An import is reached through `imports` rather than through the
    signature, so adding one does not change what the code has to accept.
    """
    imports: [ScriptImport!]!
    "The installation's libraries it uses, under the names it uses them by."
    libraries: [ScriptLibraryImport!]!
    "\"(input: object, format: string)\", ready for the list."
    signature: String!
    "ISO-8601 offset date-time."
    lastModifiedAt: String!
    lastModifiedBy: String!
    """
    When somebody edited a plugin's function, and who. Null on every workspace
    function, and on a plugin function nobody has touched. Set, the row's code
    is the implementation, a reload leaves it alone, and the plugin's export
    carries it.
    """
    editedAt: String
    editedBy: String
}

type FunctionParam {
    name: String!
    type: ValueType!
    "Which object, when the type is OBJECT. Null otherwise."
    objectId: ID
    "What that object is called, resolved for the editor's annotations."
    objectName: String
}

type FunctionPage {
    content: [Function!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

"What parsing the source found; valid with no message when it parsed."
type FunctionValidation {
    valid: Boolean!
    message: String
    line: Int
    column: Int
}

"""
One argument for a test run: which parameter, and the value as JSON.

JSON rather than text, because that is what crosses into the sandbox and because
not every parameter is a scalar — a map or an array has no spelling as a plain
string. The editor writes it from the control it drew, so a string field sends
`"kraków"` and a number field sends `3`.
"""
input FunctionArgumentInput {
    name: String!
    "The value, as a JSON document. Anything that is not one is refused by name."
    json: String!
}

input RunFunctionInput {
    """
    Which workspace is asking.

    Not derived from the function: a plugin's function belongs to none, and its
    settings and the permissions somebody agreed to are per workspace. For a
    workspace's own function this has to be the workspace that owns it.
    """
    workspaceId: ID!
    functionId: ID!
    """
    What to pass, by parameter name.

    A name the function does not declare is ignored, and a parameter nobody
    filled in arrives as `null` — which is what a node passes for a mapping it
    does not have.
    """
    arguments: [FunctionArgumentInput!]
    """
    What to hand a granted variable instead of what the workspace holds, by the
    variable's name.

    Only a test run fills this in. Nothing that runs on its own — a node, a
    trigger, a workflow — can pass it, so an unattended run is handed exactly
    what the workspace says. A name this function was not granted is ignored,
    and one left out means the stored value. The workspace's audit says which
    were given by hand, so such a run is never mistaken for the real one.
    """
    externals: [FunctionArgumentInput!]
}

"""
What one test run came to.

One shape rather than two, because the panel showing it has the same job either
way: say how long it took, and show what came back.
"""
type FunctionRun {
    ok: Boolean!
    "The JSON it returned. Null when it failed, and also when it returned nothing."
    returned: String
    "What went wrong, with the function's name in front of it. Null when it answered."
    error: String
    durationMillis: Int!
    """
    Whether asking again could ever answer differently.

    False is the interesting one: the run was stopped by the clock or by how busy
    the machine was rather than by anything about the code.
    """
    settled: Boolean!
    """
    The workspace variables it was handed, by name.

    Names only, never values. They are here so a run can be seen to have resolved
    them: a function that reads a secret and answers wrongly looks exactly like
    one that was handed nothing, and this is the difference.
    """
    grants: [String!]!
}

input FunctionParamInput {
    name: String!
    type: ValueType!
    "Required when the type is OBJECT, and ignored otherwise."
    objectId: ID
}

input CreateFunctionInput {
    "Which of the workspace's variables it is handed, in order."
    externalVariableIds: [ID!]
    workspaceId: ID!
    name: String!
    description: String
    "The compiled JavaScript. Left out for a new function, which starts from a stub that runs."
    source: String
    "The TypeScript the source was compiled from. The two are sent together or not at all."
    typescript: String
    returnType: ValueType
    "Required when the return type is OBJECT, and ignored otherwise."
    returnObjectId: ID
    params: [FunctionParamInput!]
    "The workspace's other functions it calls, under the names it calls them."
    imports: [ScriptImportInput!]
    "The installation's libraries it uses, under the names it uses them by."
    libraries: [ScriptLibraryImportInput!]
}

input UpdateFunctionInput {
    "Which of the workspace's variables it is handed, in order."
    externalVariableIds: [ID!]
    name: String
    description: String
    "The compiled JavaScript. Sent together with the TypeScript it came from."
    source: String
    "The TypeScript the source was compiled from. Neither moves without the other."
    typescript: String
    returnType: ValueType
    "Required when the return type is OBJECT, and ignored otherwise."
    returnObjectId: ID
    params: [FunctionParamInput!]
    "Null leaves them alone; an empty list takes them all off."
    imports: [ScriptImportInput!]
    "Null leaves them alone; an empty list takes them all off."
    libraries: [ScriptLibraryImportInput!]
}

"""
One thing a script imports, and the name it imports it under.

Two halves, and they are not the same fact. `functionId` is the reference, held
as an id because a reference held by name is one that goes stale the first time
somebody renames what it points at. `name` is the importer's own word for it,
written into the importer's own code — so renaming the imported function changes
nothing about the code that calls it, which is the whole point of storing them
apart.

Shared by functions and tools. A tool importing a function is the same
arrangement, and two types saying the same thing would drift.
"""
type ScriptImport {
    functionId: ID!
    "What the code calls it. Unaffected by anything happening to the function."
    name: String!
    "What was imported. Null only if it went away behind the delete guard's back."
    function: ImportedFunction
}

"""
What an imported function is, as far as the importer needs to know.

Enough to annotate `imports` in the editor and to say in a panel what was
imported. Not the source: whoever is reading this is writing the call, not the
callee, and the callee has an editor of its own.
"""
type ImportedFunction {
    name: String!
    description: String
    "\"(city: string, days: number)\", ready for the list."
    signature: String!
    returnType: ValueType!
    "What its returned object is called, when it returns one."
    returnObjectName: String
}

input ScriptImportInput {
    "Which of the workspace's own functions. A plugin's cannot be imported."
    functionId: ID!
    "What the importing code calls it. An identifier, unique within the importer."
    name: String!
}

"""
A library loaded into this installation: JavaScript a script may import.

A stored artefact rather than a name from a registry, and it has to be. The only
two ways to honour a registry name are both shut: fetching one at run time would
mean giving the sandbox a network, which is the thing it exists to withhold, and
fetching it at upload would mean this server reaching out to a registry, which
makes an offline installation unusable and makes what a workspace runs depend on
what a registry served that afternoon.

It belongs to the installation rather than to a workspace because the question an
installation has to be able to answer is what code is running inside it. `usedBy`
is the other half of that question, and no workspace-level screen could answer it.
"""
type ScriptLibrary {
    id: ID!
    "Its identity, taken from the filename. Loading this key again replaces it."
    key: String!
    name: String!
    filename: String!
    sizeBytes: Float!
    "Of the source text, so an unchanged re-upload is recognisable."
    sha256: String!
    "Whether its export is itself something to call, rather than an object."
    callable: Boolean!
    """
    Which spelling the stored file is written in: `ESM` or `COMMONJS`.

    Says how the stored text is run and nothing about where it came from. A
    CommonJS file is given the `module` and `exports` its code expects on the way
    into the sandbox, every time; the column holds the file as it arrived, so the
    hashes beside it stay claims about what was fetched.
    """
    format: String!
    """
    What its default export turned out to hold, read once when it was loaded.

    Not a type declaration. Nothing in a bundle says what its arguments are, so
    this claims only that a member is something to call or something to read —
    which is what the editor annotates `imports` from.
    """
    members: [LibraryMember!]!
    """
    Every function and tool that imports it, across every workspace.

    Empty on the workspace query, which is not a claim that nothing uses it: who
    else imports a library is an administrator's question, and the people writing
    functions are not administrators. `componentDependants` is the way to ask it
    from anywhere else, and it counts what it may not name.
    """
    usedBy: [Dependant!]!
    "ISO-8601 offset date-time."
    uploadedAt: String!
    uploadedBy: String!
    """
    Where it was fetched from, or null when somebody uploaded the file.

    Null is the honest answer for an upload rather than an awkward one: an
    uploaded file has no provenance this installation can vouch for, and a row of
    blanks would read as though it had.
    """
    registry: LibraryRegistry
    """
    What went into it, or null where it is one file.

    Null rather than a list of one: "this is the file" and "this is a bundle of
    one thing" are different claims and only the first is true of an ordinary
    library. Where it is a list, it is the bill of materials - every package at
    the version its range resolved to, or every file that was uploaded - because
    the columns beside it describe the package the bundle was entered by rather
    than the whole of what is in it.
    """
    bundledFrom: [LibraryPart!]
}

"""
What an install came to: the library, or the question it has to ask first.

Exactly one of the two is set. A package that is one file installs and there is
nothing to ask; one that is several is answered with what bundling it would mean,
which is a question rather than an error.
"""
type ScriptLibraryInstall {
    "The library, where nothing had to be asked."
    installed: ScriptLibrary
    "What would be bundled, where it does. Say yes with `bundle: true`."
    proposed: LibraryBundlePlan
}

"What would go into a bundle, so somebody can say yes to it."
type LibraryBundlePlan {
    "What was typed, so the question names what was asked for."
    spec: String!
    """
    Why one file was not enough, in the sentence the install refused with: it
    names the file and the specifier that made this more than one file.
    """
    why: String!
    "How many files would end up inside it - reached, rather than fetched."
    files: Int!
    parts: [LibraryPart!]!
}

"""
One thing that went into a bundle.

`version` and `integrity` are null for a file somebody uploaded, which has
neither: an upload has no provenance this installation can vouch for, and a blank
where a version would be is the honest way to say so.
"""
type LibraryPart {
    name: String!
    version: String
    "Which file in it the bundle enters it by."
    entry: String
    "The registry's own hash of the file it served."
    integrity: String
}

"""
What a registry served, and what it claimed about it.

The point of recording a fetch is that somebody can check it: the same package at
the same version fetched anywhere else carries the same integrity string, and a
row that disagrees is worth knowing about.
"""
type LibraryRegistry {
    "The npm package, scope and all."
    packageName: String!
    "Exactly one version. Never a range and never a tag."
    version: String!
    "The file that was downloaded, so the fetch can be repeated and compared."
    url: String!
    "The registry's own hash of the file it served, verified on arrival."
    integrity: String!
    "Which file inside the package is the one that runs."
    entry: String!
}

"Whether this installation can fetch a package, and from where."
type LibraryRegistryStatus {
    "False where no registry is configured: the screen offers the upload alone."
    configured: Boolean!
    "Where packages would come from. Empty when there is none."
    url: String!
}

type LibraryMember {
    name: String!
    "Whether it is something to call, rather than something to read."
    callable: Boolean!
}

"""
One library a script imports, and the name it imports it under.

The same two halves an imported function has, and apart for the same reason: the
id is the reference and the name is the importer's own word for it, so replacing
a library under the same key disturbs neither.
"""
type ScriptLibraryImport {
    libraryId: ID!
    name: String!
    "What was imported. Null only if it went away behind the delete guard's back."
    library: ImportedLibrary
}

"What an imported library is, as far as the importer needs to know."
type ImportedLibrary {
    key: String!
    callable: Boolean!
    members: [LibraryMember!]!
}

input ScriptLibraryImportInput {
    libraryId: ID!
    "What the importing code calls it. An identifier, unique within the importer."
    name: String!
}

"What an action does when a workflow reaches it."
enum ActionType {
    EXECUTE
    WAIT
}

"How it does it; each subtype belongs to one type."
enum ActionSubtype {
    OUTGOING_CONNECTION
    "Sends a mail through one of the workspace's SMTP connections."
    SEND_EMAIL
    HTTP_REQUEST
    FUNCTION
    "Waits until an expression written into the action holds."
    INLINE_CONDITION
    "Waits until one of the workspace's conditions holds."
    CONDITION
    TIME
}

enum ConnectionActionKind {
    SEND_MESSAGE
    REPLY_IN_THREAD
    CREATE_ISSUE
    UPDATE_ISSUE
}

"""
Which of Slack's two kinds of name this is: a channel, or a person.

Nothing stores it. An action holds `targetName` and no kind beside it, because
a send resolves the name it is given to Slack's own id before it posts - so
whether that name belongs to a channel or to a person is something found out at
the time and never something filled in on a form. This is what is left of it: a
mark beside a row, optional on `slackTarget` and `slackSuggestions` where it
narrows which endpoint is read, and returned on their answers to say what a
name turned out to be.
"""
enum MessageTarget {
    CHANNEL
    USER
}

"One function argument, and what the action hands it."
type ArgumentMapping {
    argument: String!
    expression: String!
}

"Read off the action's settings rather than stored."
type ActionParam {
    name: String!
    type: ValueType!
    "\"message: string\", as the list and the form show it."
    display: String!
}

""" What made an artifact. One value today; the page is built to grow a second. """
enum ArtifactKind {
    IMAGE
    TASK
    SAVED
}

""" One thing a run produced: today a picture an image node drew. """
type Artifact {
    id: ID!
    kind: ArtifactKind!
    "Where it came from, named the way the page says it: \"Run #12\", \"Task #4\"."
    source: String!
    "The rest of the address of that, under the workspace."
    sourcePath: String!
    "What was asked for - the picture's caption."
    prompt: String!
    filename: String!
    contentType: String!
    sizeBytes: Float!
    "Where the bytes are: the same address the run graph's img uses."
    url: String!
    drawnAt: String!
    """
    Where the same bytes can be read rather than saved, or null for a file
    nothing here renders.

    Its own address, so what a link is does not depend on what the file inside
    it turns out to be: `url` hands the file over, always, and this one opens.
    """
    previewUrl: String
}

type ArtifactPage {
    content: [Artifact!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

"A reusable block a workflow is built from; an action node instances one."
type Action {
    id: ID!
    workspaceId: ID!
    """
    The workflow this belongs to, where it is that workflow's own.

    Null is the ordinary case - a definition the workspace shares. Set is
    "Custom": made from a node, left out of the workspace's list, and shown in
    no other workflow's picker.
    """
    workflowId: ID
    name: String!
    type: ActionType!
    subtype: ActionSubtype!
    "\"Outgoing Connection\", for the Subtype column."
    subtypeLabel: String!
    connectionId: ID
    connectionName: String
    connectionAction: ConnectionActionKind
    content: String
    """
    Where a send goes, exactly as it was typed: "#general", "general",
    "@alice", "alice", an address, or an id pasted out of Slack.

    One field and no kind beside it, because sending resolves what is in it:
    the connection is asked what the name is at the moment the message goes,
    and Slack is posted to the id that comes back. So none of the six shapes
    above needs a sigil to work and none of them needs a setting saved
    alongside. `slackTarget` answers the same question while somebody types,
    and nothing stores its answer.

    Free text, and never gated. A private channel this bot is in, a member who
    joined a minute ago and an id pasted out of somebody else's message are all
    valid and none of them can be looked up, so what cannot be resolved is sent
    exactly as typed and Slack's own answer about it is what is reported.
    """
    targetName: String
    "A mail's recipients and copy list, comma-separated."
    emailTo: String
    emailCc: String
    emailSubject: String
    "Where answers go, when that is not the connection's from-address."
    emailReplyTo: String
    "What a SPEAK action reads out; a node may say something else instead."
    speechText: String
    "Which voice, where the provider offers more than one; null is its own."
    speechVoice: String
    "Which model speaks it; null follows the workspace's own choice."
    speechModelId: ID
    url: String
    method: String
    """
    The headers it sends, as the column holds them: a JSON array of rows, or the
    JSON object every action saved before rows existed still holds.

    Kept on the type because an import writes it and because a form has to be
    able to show the text back when nobody can read it as rows. A row that reads
    a variable holds that variable's id here and never its value.
    """
    headers: String
    "The same headers as rows, each naming the variable it reads and never what that variable holds."
    headerRows: [ActionHeader!]!
    "Whether `headers` could be read as rows at all. False is a blob somebody has to mend by hand."
    headersReadable: Boolean!
    functionId: ID
    functionName: String
    mappings: [ArgumentMapping!]!
    conditionExpression: String
    conditionId: ID
    conditionName: String
    timeoutSeconds: Int
    retryIntervalSeconds: Int
    durationSeconds: Int
    "What the action has to be given, read off its settings."
    inputParams: [ActionParam!]!
    "What it hands on, which follows from what it does."
    outputParams: [ActionParam!]!
    "Which icon a node drawn from this starts with; null draws the kind's own."
    icon: String
}

"""
One header an HTTP request action sends, and where its value comes from.

Exactly one of `value` and `variableId` is set. `value` is text somebody typed
and is stored as typed; `variableId` names one of this workspace's variables and
what that variable holds is read when the action runs, never when it is saved and
never on this type.
"""
type ActionHeader {
    name: String!
    "What it is set to, used exactly as written. Null when this reads a variable."
    value: String
    "Which of the workspace's variables it reads. Null when it was typed in."
    variableId: ID
    "The name of that variable, and never what it holds."
    variableName: String
}

"One header row: a name, and exactly one of a value and a variable to read."
input ActionHeaderInput {
    name: String!
    value: String
    variableId: ID
}

type ActionPage {
    content: [Action!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

input ArgumentMappingInput {
    argument: String!
    expression: String!
}

input CreateActionInput {
    workspaceId: ID!
    name: String!
    """
    The workflow this belongs to, where it is that workflow's own.

    Null is the ordinary case: a definition the workspace shares. Set is what a
    node's "Custom" makes — reachable from that node and left out of every list
    meant for choosing from, so making one does not add a name to a library
    nobody asked to grow.
    """
    workflowId: ID
    type: ActionType!
    subtype: ActionSubtype!
    connectionId: ID
    connectionAction: ConnectionActionKind
    content: String
    """
    Where a send goes, as typed: "#general", "general", "@alice", "alice", an
    address, or an id. No kind goes with it - sending resolves the name itself.
    """
    targetName: String
    "A mail's recipients and copy list, comma-separated."
    emailTo: String
    emailCc: String
    emailSubject: String
    "Where answers go, when that is not the connection's from-address."
    emailReplyTo: String
    "What a SPEAK action reads out; a node may say something else instead."
    speechText: String
    "Which voice, where the provider offers more than one; null is its own."
    speechVoice: String
    "Which model speaks it; null follows the workspace's own choice."
    speechModelId: ID
    url: String
    method: String
    "The headers as one JSON string. What an import carries; `headerRows` is what a form sends."
    headers: String
    "The headers as rows. Wins over `headers` when both arrive."
    headerRows: [ActionHeaderInput!]
    functionId: ID
    mappings: [ArgumentMappingInput!]
    conditionExpression: String
    conditionId: ID
    timeoutSeconds: Int
    retryIntervalSeconds: Int
    durationSeconds: Int
    "Which icon a node drawn from this starts with; null draws the kind's own."
    icon: String
}

input UpdateActionInput {
    name: String
    subtype: ActionSubtype
    connectionId: ID
    connectionAction: ConnectionActionKind
    content: String
    """
    Where a send goes, as typed: "#general", "general", "@alice", "alice", an
    address, or an id. No kind goes with it - sending resolves the name itself.
    """
    targetName: String
    "A mail's recipients and copy list, comma-separated."
    emailTo: String
    emailCc: String
    emailSubject: String
    "Where answers go, when that is not the connection's from-address."
    emailReplyTo: String
    "What a SPEAK action reads out; a node may say something else instead."
    speechText: String
    "Which voice, where the provider offers more than one; null is its own."
    speechVoice: String
    "Which model speaks it; null follows the workspace's own choice."
    speechModelId: ID
    url: String
    method: String
    "The headers as one JSON string. What an import carries; `headerRows` is what a form sends."
    headers: String
    "The headers as rows. Wins over `headers` when both arrive."
    headerRows: [ActionHeaderInput!]
    functionId: ID
    mappings: [ArgumentMappingInput!]
    conditionExpression: String
    conditionId: ID
    timeoutSeconds: Int
    retryIntervalSeconds: Int
    durationSeconds: Int
    "Which icon a node drawn from this starts with; null draws the kind's own."
    icon: String
}

"What a condition asks about."
enum ConditionType {
    SLACK
    JIRA
    TIME
    "One of the workspace's functions, which has to return a boolean."
    FUNCTION
    ANY_OF
    ALL_OF
}

"Which part of what arrived is being asked about."
enum ConditionProperty {
    MESSAGE_AUTHOR
    MESSAGE_CHANNEL
    MESSAGE_TEXT
    ISSUE_PRIORITY
    ISSUE_STATUS
    ISSUE_TYPE
    CURRENT_TIME
}

"How the property is tested."
enum ConditionCheck {
    IN_LIST
    EQUALS
    CONTAINS
    MATCHES
    BETWEEN
    WORKSPACEMATE
}

"""
One argument a function condition passes.

The same three fields a node's mapping has, because it is the same decision: a
value written in, or the name of a field the run is carrying, and which of the
two it is.
"""
type ConditionArgument {
    name: String!
    expression: String!
    mode: MappingMode!
}

input ConditionArgumentInput {
    name: String!
    expression: String!
    mode: MappingMode!
}

"A question a workspace asks about what a run is carrying, defined once."
type Condition {
    id: ID!
    workspaceId: ID!
    """
    The workflow this belongs to, where it is that workflow's own.

    Null is the ordinary case - a definition the workspace shares. Set is
    "Custom": made from a node, left out of the workspace's list, and shown in
    no other workflow's picker.
    """
    workflowId: ID
    name: String!
    type: ConditionType!
    "\"Any Of\", for the badge and the form."
    typeLabel: String!
    property: ConditionProperty
    check: ConditionCheck
    "Answers the opposite; what makes \"is external\" the negation of \"is a workspacemate\"."
    negate: Boolean!
    functionId: ID
    functionName: String
    "What the check compares against."
    values: [String!]!
    "What a function condition passes, one per parameter, in the function's order."
    arguments: [ConditionArgument!]!
    "The conditions a composite is made of."
    members: [ID!]!
    memberNames: [String!]!
    "What it asks, in words; read off the definition rather than stored."
    description: String!
    "Which icon a node drawn from this starts with; null draws the kind's own."
    icon: String
}

type ConditionPage {
    content: [Condition!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

input CreateConditionInput {
    workspaceId: ID!
    name: String!
    """
    The workflow this belongs to, where it is that workflow's own.

    Null is the ordinary case: a definition the workspace shares. Set is what a
    node's "Custom" makes — reachable from that node and left out of every list
    meant for choosing from, so making one does not add a name to a library
    nobody asked to grow.
    """
    workflowId: ID
    type: ConditionType!
    property: ConditionProperty
    check: ConditionCheck
    negate: Boolean
    functionId: ID
    values: [String!]
    """
    What a function condition passes, one per parameter, in the function's order.

    Empty is what every condition written before this holds, and it means what it
    always meant: the function is handed what the run is carrying, as one
    argument, then the workspace values it declared. A condition only starts
    passing arguments once somebody fills them in.
    """
    arguments: [ConditionArgumentInput!]
    members: [ID!]
    "Which icon a node drawn from this starts with; null draws the kind's own."
    icon: String
}

input UpdateConditionInput {
    name: String
    type: ConditionType
    property: ConditionProperty
    check: ConditionCheck
    negate: Boolean
    functionId: ID
    values: [String!]
    """
    What a function condition passes, one per parameter, in the function's order.

    Empty is what every condition written before this holds, and it means what it
    always meant: the function is handed what the run is carrying, as one
    argument, then the workspace values it declared. A condition only starts
    passing arguments once somebody fills them in.
    """
    arguments: [ConditionArgumentInput!]
    members: [ID!]
    "Which icon a node drawn from this starts with; null draws the kind's own."
    icon: String
}

"""
A named data structure the workspace can point at.

Fields only. Deliberately not called a record: an object with members can grow
methods later without the concept having to be renamed.
"""
type WorkflowObject {
    id: ID!
    """
    The workspace that drew this shape.

    Null for one a plugin exports: a plugin belongs to the installation, so
    what it exports belongs to every workspace at once. Exactly one of this
    and `pluginId` is set.
    """
    workspaceId: ID
    """
    The plugin that exports this shape, or null for a workspace's own.

    Set means the row is the plugin's: replaced wholesale the next time the
    plugin is loaded, gone when it is unloaded, and there is nowhere to edit
    it — `updateObject` and `deleteObject` refuse one, saying so.
    """
    pluginId: ID
    name: String!
    description: String
    properties: [ObjectProperty!]!
    "What the list's badge shows."
    propertyCount: Int!
    createdAt: String!
    createdBy: String!
    lastModifiedAt: String!
    lastModifiedBy: String!
}

type ObjectProperty {
    name: String!
    kind: PropertyKind!
    "The object this points at, when the kind is one or an array of them."
    refObjectId: ID
    "What an array holds when it holds scalars."
    elementKind: PropertyKind
    """
    What this field means, for whoever - or whatever - reads it.

    A name says what a field is called and nothing about what belongs in it.
    This is where that goes, so a person and a model read the same sentence
    rather than each inferring their own from one word.
    """
    description: String
    "Ready to show: `string`, `ApiResponse`, `array<FileObject>`."
    display: String!
}

enum PropertyKind {
    STRING
    NUMBER
    BOOLEAN
    OBJECT
    ARRAY
}

input ObjectPropertyInput {
    name: String!
    kind: PropertyKind!
    refObjectId: ID
    elementKind: PropertyKind
    "What the field means, at most 500 characters. Blank says nothing."
    description: String
}

input CreateObjectInput {
    workspaceId: ID!
    name: String!
    description: String
    properties: [ObjectPropertyInput!]
}

input UpdateObjectInput {
    name: String
    description: String
    "Null leaves the properties alone; a list replaces them wholesale."
    properties: [ObjectPropertyInput!]
}

type ObjectValidation {
    valid: Boolean!
    message: String!
}

type ObjectPage {
    content: [WorkflowObject!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

"""
What can be exported and imported as JSON.

The whole catalogue. The first five reach only each other and travel whole; the
last four reach outward as well — an agent names a model, an action and a trigger
name a connection — and what they reach out to is kept beside a credential, so it
cannot be carried. That is what `ExternalKind` is, and answering it is the binding
step: everything in an envelope is still written by name, and the import still
creates all of it or none of it.

The order is the order things are written in, which is the order they depend on
each other in: nothing here reaches anything below it.
"""
enum ComponentKind {
    OBJECT
    FUNCTION
    CONDITION
    TOOL
    SKILL
    ACTION
    TRIGGER
    AGENT
    WORKFLOW
}

"""
What an envelope points at and can never carry.

Each of these is a row with an encrypted column in it, so what travels is the
name and the type. An import that finds nothing of that name here is refused
until it is told what the name means — a connection invented from a name would be
a connection to nowhere, and one invented from a name and somebody else's token
would be worse.
"""
enum ExternalKind {
    "One model, reached through one provider; both are named in the file."
    MODEL
    "One of the workspace's connections to a service."
    CONNECTION
    "One MCP server the workspace has registered."
    MCP_SERVER
}

"""
One answer to something an envelope could not carry.

`name` is the file's, exactly as the plan gave it back — for a model, the
provider's name and the model's with a slash between them. `targetId` is what it
means here: an id rather than a name, because a binding is a statement about this
installation made from a list this installation drew.
"""
input ComponentBindingInput {
    kind: ExternalKind!
    "The name in the file, as the plan gave it."
    name: String!
    "Which of this workspace's rows it means."
    targetId: ID!
}

"""
One component of an envelope that an import is to leave out.

Named as the file names it — the name the plan gave back, not whatever a rename
would land it under here. Only a component the file *carries* can be named: a
plan lists what the envelope points at beside what it holds, and the first sort
is a mention rather than a thing, so removing it would leave whatever mentioned
it pointing at nowhere. One of those is refused rather than ignored.
"""
input ComponentExclusionInput {
    kind: ComponentKind!
    "The name in the file, as the plan gave it."
    name: String!
}

"How much of what a component reaches travels with it."
enum ExportDepth {
    "The one component. For a workspace that already has what it points at."
    SHALLOW
    "Everything it reaches, so the file lands somewhere it can be opened."
    DEEP
}

"One file, ready to download."
type ComponentExport {
    "What to call it: `normaliseOrder.orkx.json`."
    fileName: String!
    "The envelope itself, formatted."
    json: String!
}

"What the import will do about one thing the envelope mentions."
enum ImportDisposition {
    "Created here under the name the file gave it."
    CREATE
    """
    Created under a different name, because that one was taken. Never a
    replacement: everything else in the same file that pointed at it points at
    the new name instead.
    """
    RENAME
    "Already here by that name, and pointed at rather than created."
    REUSE
    """
    Pointed at, not carried, and not here. The import is refused while any of
    these remain.
    """
    MISSING
    """
    Carried by the file and not created, because it was named in `exclude` — or
    because something it needs was, and this workspace has nothing to take that
    one's place. Still listed and still named: `detail` says which of the two it
    is, so unticking one row cannot quietly take three with it.
    """
    EXCLUDE
}

type ComponentImportEntry {
    "The kind, for something the file carries or would have carried."
    kind: ComponentKind
    """
    The kind, for something no file could carry. Set only where `kind` is not,
    and what a binding names. Both are null for a variable, which is neither: it
    is pointed at, never created, and never bound.
    """
    external: ExternalKind
    """
    Whether the envelope holds this one, rather than pointing at it.

    The one fact that says what may be offered against a row. Only what the file
    carries can be left out of an import; everything else listed is a reference —
    a name that has to be matched against this workspace, or bound — and there is
    nothing in the file to remove. True exactly when `disposition` is `CREATE`,
    `RENAME` or `EXCLUDE`; never for a variable or an external.
    """
    carried: Boolean!
    "The name in the file; for a model, the provider's name and the model's."
    name: String!
    "The name it will have here; different from `name` when it was renamed or bound."
    targetName: String!
    disposition: ImportDisposition!
    "Why, in words to show unchanged."
    detail: String!
}

"""
What an import would do, shown before it is done — and answered again afterwards.

A button that silently creates nine things is worse than one that lists them
first, so the dialog reads this and the mutation returns the same shape.
"""
type ComponentImportPlan {
    "The version the file claims. One it does not know is refused, not read."
    formatVersion: Int!
    "What wrote it. Quoted in messages; nothing branches on it."
    producedBy: String
    depth: ExportDepth!
    "False while anything is MISSING, or while nothing is left to create."
    importable: Boolean!
    entries: [ComponentImportEntry!]!
    "Empty when importable; otherwise what has to be fixed here first."
    problems: [String!]!
}

"""
An export this installation keeps under a name, for anybody to use.

A template *is* the envelope `exportComponent` writes — there is no second
format and no second table of components — so everything the file already
settled holds here too: no ids, no secrets, a name already taken is renamed
rather than replaced, and a version this installation does not read is refused.

It holds a copy taken when it was published, and follows nothing. Editing the
function a template was made from does not change the template; replacing its
file is the only thing that does.

Every field below `description` is read out of the stored envelope rather than
stored beside it, which is why they can be null: a template published under a
newer Orknux and then rolled back is still listed, with `usable` false and
`problem` saying so in words.
"""
type ComponentTemplate {
    id: ID!
    name: String!
    description: String
    "The version the stored file claims. Null when it could not be read."
    formatVersion: Int
    "What wrote it. Quoted in messages; nothing branches on it."
    producedBy: String
    depth: ExportDepth
    "Which kinds are inside, each once — the summary a list shows."
    kinds: [ComponentKind!]!
    componentCount: Int!
    "Everything inside, as the file names it."
    contents: [TemplateComponent!]!
    "False when this installation cannot read the stored envelope."
    usable: Boolean!
    "Why not, in the format's own words, when `usable` is false."
    problem: String
    createdAt: String!
    createdBy: String!
    lastModifiedAt: String!
    lastModifiedBy: String!
}

"One thing inside a template, as the stored file names it."
type TemplateComponent {
    kind: ComponentKind!
    name: String!
}

"What the New Template and Edit Template forms send."
input ComponentTemplateInput {
    name: String!
    description: String
    """
    The exported file.

    Required when publishing an upload. On an update, leaving it out keeps the
    stored one. Ignored by `saveComponentAsTemplate`, which exports the component
    itself.
    """
    envelope: String
}

"What a role lets somebody do, beyond the workspaces it is assigned to."
enum RoleScope {
    "Sees the Admin section and every workspace, whatever else is assigned."
    ADMIN
    "Signs in, and sees the workspaces this role is assigned to."
    USER
}

"""
A role this installation defines.

Not a group from a directory: a provider's group or an OIDC claim is mapped onto
one of these, so everything past the front door deals only in roles.
"""
type Role {
    id: ID!
    name: String!
    description: String
    scopes: [RoleScope!]!
    "True for the administrator role, which cannot be edited or removed."
    builtin: Boolean!
    "ISO-8601 offset date-time."
    lastModifiedAt: String!
    lastModifiedBy: String!
}

input RoleInput {
    name: String!
    description: String
    "Empty or absent means an ordinary role: USER."
    scopes: [RoleScope!]
}

"Where a user is true: at the identity provider, or here."
enum UserType {
    "Made and managed in this application. An identity, not a login."
    INTERNAL
    "Vouched for by LDAP or OIDC; recorded when they sign in."
    EXTERNAL
}

type AppUser {
    id: ID!
    username: String!
    displayName: String!
    "Where to write to them. Null where neither the provider nor anybody here has said."
    email: String
    "True where the address was typed here, so sign-in leaves it alone."
    emailChosen: Boolean!
    """
    Whether the news that rings their bell is posted to their address as well.
    True unless they have turned it off; nothing is sent at all on an
    installation with no mail server configured.
    """
    emailNotifications: Boolean!
    """
    Whether their chats print what an answer cost beside how long it took.
    False unless they have turned it on.
    """
    chatCostShown: Boolean!
    """
    The language they read the product in, as a BCP-47 tag. Null where they have
    not chosen, which is not the same as English: it is what lets the browser
    open in the language it is already set to.
    """
    language: String
    type: UserType!
    roles: [RoleRef!]!
    "False for anybody the identity provider defines."
    editable: Boolean!
    "Whether they can sign in, which is not the same as existing."
    hasPassword: Boolean!
    "ISO-8601 offset date-time."
    lastModifiedAt: String!
    lastModifiedBy: String!
}

"A role as a user's row names it."
type RoleRef {
    id: ID!
    name: String!
}

"What kind of thing happened on an issue."
enum NotificationKind {
    "It was filed, and you are one of the people it concerns."
    OPENED
    ASSIGNED
    STATUS
    COMMENT
    MENTIONED
    "You were made an observer of it, and will hear about it from now on."
    OBSERVING
    """
    It was linked to another issue - `says` holds which relation and which
    issue, read from this one's side, as "BLOCKS #4".

    Only the making of a link. One taken off is most often a correction, and a
    bell that rings for corrections is a bell people learn to ignore.
    """
    LINKED
    """
    A task stopped and is waiting for a person - `says` holds what it asked for.

    The one kind that is not about an issue, and the one where a notification is
    the mechanism rather than a courtesy: a parked task does nothing at all until
    somebody looks at it.
    """
    TASK_WAITING
    """
    A task reached an end, and `says` holds which one and what came of it.

    One kind rather than three. What the reader wants to know is that it is over
    and how it went.
    """
    TASK_FINISHED
}

"""
One thing that happened, as the bell shows it.

The subject is an issue or a task, and exactly one of the two pairs below is
filled in. It widened when a task learnt to stop and ask for permission: there is
one desk where an event becomes news for somebody, so the subject widened rather
than a second desk appearing beside it.
"""
type Notification {
    id: ID!
    workspaceId: ID!
    "The issue it is about, and null when it is about a task."
    issueNumber: Int
    issueTitle: String
    "The task it is about, and null when it is about an issue."
    taskId: ID
    taskTitle: String
    kind: NotificationKind!
    "Whoever did it."
    actor: String!
    "What was said, or the status it moved to."
    says: String
    "ISO-8601 offset date-time."
    at: String!
    "Whether it was still unread when it was asked for. The bell counts these; the panel shows everything." 
    unread: Boolean!
}

enum IssueStatus {
    OPEN
    "Somebody has picked it up. Open means nobody has yet."
    IN_PROGRESS
    CLOSED
}

"""
What kind of thing an issue is: a bug, a feature, or whatever else a workspace
decides it files.

A catalogue of its own rather than a label with a reserved prefix. A label is a
set, so nothing could stop an issue being two types at once; a label exists only
while an issue carries it, so there would be nothing to administer before the
first issue is filed; and a label cannot be renamed without rewriting every row
that holds the word. Labels are what a workspace says about an issue; the type
is what the issue is.

Per workspace, because one team files bugs and features and the next files
incidents and requests. Whoever administers the workspace changes the list;
anybody who can see it reads it.
"""
type IssueType {
    id: ID!
    workspaceId: ID!
    name: String!
    "How many issues here carry it. What the settings page shows, and what deleting it is refused with."
    issues: Int!
}

"What a list of issues is ordered by."
enum IssueOrder {
    "By number, which is the order they were filed in."
    NUMBER
    "By title, so a name can be found without reading every row."
    TITLE
    "By when it last changed, which is what \"what is happening\" means."
    UPDATED
    """
    By when somebody last said something on it. Not the same as UPDATED, which
    closing, relabelling and assigning all move. An issue nobody has replied to
    has no answer here and sorts last, whichever way round.
    """
    LAST_COMMENT
    """
    By what the issues are, alphabetically by the type's name. An untyped issue
    sorts last whichever way round: having no kind is not being the first kind.
    """
    TYPE
}

"What kind of thing an issue is assigned to."
enum AssigneeKind {
    USER
    AGENT
    MODEL
}

"Something an issue can be assigned to, as the box shows it."
type Assignee {
    kind: AssigneeKind!
    id: ID!
    name: String!
    "The second line: a username, a provider, or what kind of thing it is."
    hint: String!
}

"""
A file on an issue or on one of its comments. The bytes are wherever the
installation's attachment storage put them, under the workspace that owns them.
"""
type IssueAttachment {
    id: ID!
    filename: String!
    contentType: String!
    sizeBytes: Float!
    uploadedBy: String!
    "ISO-8601 offset date-time."
    uploadedAt: String!
    "Whether the person reading this attached it, and so may remove it."
    mine: Boolean!
}

"""
A web address hung on an issue - the pull request that caused it, the dashboard
that showed it. Only http and https are ever stored.
"""
type IssueLink {
    id: ID!
    url: String!
    "What whoever added it called it, or null when they let the address speak."
    title: String
    """
    The address as GitHub reads it: owner/repo, owner/repo#123 for an issue or
    pull request, owner/repo@abc1234 for a commit. Null when it is not a GitHub
    address, or is one of a shape this does not read. Worked out from the
    address alone - nothing asks GitHub whether it exists.
    """
    github: String
    addedBy: String!
    "ISO-8601 offset date-time."
    addedAt: String!
    "Whether the person reading this added it, and so may remove it."
    mine: Boolean!
}

"""
What one issue has to do with another.

Three relations and five names, because two of the three read differently from
each end: BLOCKS and BLOCKED_BY are one fact seen from its two sides, and so are
DUPLICATES and DUPLICATED_BY. RELATES_TO is its own opposite. Only one row is
ever stored for a link, facing whichever way reads actively, and it is turned
round for whichever issue is being read.

Parent and child are deliberately absent. A parent is a promise about
aggregation - a status read off its children, a tree to walk - and this tracker
has a flat list and a number.
"""
enum IssueRelationKind {
    "Read that one too, and nothing more than that."
    RELATES_TO
    "Nothing can be done about the other one until this is finished."
    BLOCKS
    "Nothing can be done about this until the other one is finished."
    BLOCKED_BY
    "This is the second report of what the other one already describes."
    DUPLICATES
    "The other one is a second report of what this describes."
    DUPLICATED_BY
}

"""
Another issue this one is linked to, read from this one's side.

The far issue's number, title and status travel with it, because whether the
thing blocking this one is closed is the whole question somebody has when they
read the word "blocked".
"""
type IssueRelation {
    "The link's own id, which is what taking it off again needs."
    id: ID!
    "The relation as the issue being read sees it."
    kind: IssueRelationKind!
    "The issue at the far end."
    issueId: ID!
    number: Int!
    title: String!
    status: IssueStatus!
    linkedBy: String!
    "ISO-8601 offset date-time."
    linkedAt: String!
}

"""
An issue as something to pick out of a list: enough to recognise it by, and the
id a mutation is given.
"""
type IssueRef {
    id: ID!
    number: Int!
    title: String!
    status: IssueStatus!
}

"""
Somebody who asked to hear about an issue without being given it. A person or
an agent; never a model, which has nowhere to read its news. Explicit only - the
reporter and the assignee already hear about everything and are shown in their
own places.
"""
type IssueObserver {
    kind: AssigneeKind!
    id: ID!
    name: String!
    "The second line: a username, or what kind of thing it is."
    hint: String!
    "Themselves, in the ordinary case, or the administrator who decided."
    addedBy: String!
    "ISO-8601 offset date-time."
    addedAt: String!
    "Whether this is the person reading, so the page knows which button to draw."
    mine: Boolean!
}

type IssueComment {
    id: ID!
    author: String!
    content: String!
    "ISO-8601 offset date-time."
    createdAt: String!
    "When it was last changed, or null if it never was."
    editedAt: String
    "What came with the comment."
    attachments: [IssueAttachment!]!
    "Whether the person reading this wrote it, and so may change it."
    mine: Boolean!
    """
    Whether they may take it off: whoever wrote it, or an administrator of the
    workspace. Wider than `mine`, so it is answered separately rather than
    worked out from it.
    """
    mayRemove: Boolean!
}

type Issue {
    id: ID!
    workspaceId: ID!
    "Its number in this workspace: what \"#3\" means."
    number: Int!
    title: String!
    description: String
    status: IssueStatus!
    "What kind of thing it is, or null for untyped - which is a real state, not a gap."
    type: IssueType
    reporter: String!
    "Null when nobody is looking at it."
    assignee: Assignee
    labels: [String!]!
    "What is attached to the issue itself; a comment's files are on the comment."
    attachments: [IssueAttachment!]!
    "Addresses hung on the issue, oldest first."
    links: [IssueLink!]!
    "Other issues this one is linked to, oldest first, each read from this one's side."
    related: [IssueRelation!]!
    "Whoever asked to hear about it, oldest first. Only the ones explicitly added."
    observers: [IssueObserver!]!
    comments: [IssueComment!]!
    "When somebody last said something here, or null if nobody has. Not lastModifiedAt, which closing and relabelling also move."
    lastCommentAt: String
    "ISO-8601 offset date-time."
    createdAt: String!
    lastModifiedAt: String!
    lastModifiedBy: String!
}

type IssuePage {
    totalElements: Int!
    content: [Issue!]!
}

"""
What kind of change one line in an issue's history is.

All but two of these are stored when they happen; OPENED is read off the issue
itself and COMMENT off the comments table, because both were already recorded
faithfully and a second copy of a comment is a copy that goes stale the moment
somebody edits it. COMMENT_REMOVED is stored for the opposite reason: once a
comment is gone there is no table left to read it from.
"""
enum IssueEventKind {
    "It was filed."
    OPENED
    """
    From here on, changes were written down.

    Only on issues that existed before the history did. A record that began
    yesterday and says nothing about it would be claiming an issue opened last
    week had a quiet week.
    """
    RECORDING
    "It was closed, reopened, or picked up."
    STATUS
    "A label was put on or taken off - one entry for each."
    LABEL
    """
    It was typed, retyped, or untyped.

    Both sides are the name the type had at the time, not its id: a type can be
    renamed, and a history read live would rewrite March to say what the word
    became in June. Null on either side is untyped.
    """
    TYPE
    "It changed hands, was handed out, or was put back down."
    ASSIGNEE
    "Somebody started or stopped hearing about it."
    OBSERVER
    """
    It was linked to another issue, or the link was taken off.

    Written on both issues, phrased from each one's own side. `was` and
    `became` hold the relation and the other issue's number at the time, as
    "BLOCKS #4".
    """
    LINK
    "Somebody said something."
    COMMENT
    """
    A comment was taken off, and this line is all that is left of it.

    `was` is who wrote it and `became` is null. What it said is deliberately
    nowhere: a record of the removal that reproduced the text would defeat the
    removal. The only kind here written because a row went away - every other
    one describes a change some other table still holds.
    """
    COMMENT_REMOVED
}

type IssueEvent {
    "Unique across all three sources: an event and a comment can both be row 5."
    id: ID!
    kind: IssueEventKind!
    "Who did it. Every entry names somebody."
    actor: String!
    "ISO-8601 offset date-time."
    at: String!
    "What it was: the old status, who it was taken from, the label removed."
    was: String
    "What it became: the new status, who it went to, the label added."
    became: String
    "What a comment said, shortened. Null for everything that is not one."
    said: String
    "Whether that comment has been changed since it was written."
    edited: Boolean!
    "Which comment it is, so the page can go and show it in full."
    commentId: ID
}

"""
An issue's history, and what was left out of it.

The count is not decoration: a list that simply stops is a list implying the
issue was quiet before that, which is the one thing a history must never say.
"""
type IssueHistory {
    "Oldest first."
    entries: [IssueEvent!]!
    "How many older entries were not returned."
    earlier: Int!
}

input IssueInput {
    "Required when creating; ignored afterwards."
    workspaceId: ID
    title: String
    "Empty clears it; absent leaves it alone."
    description: String
    status: IssueStatus
    "Which type. Empty means untyped; absent leaves it alone."
    typeId: ID
    labels: [String!]
    """
    Both together, or neither. Absent leaves the assignee alone; an empty
    assigneeId clears it, whatever kind is sent beside it; a kind on its own
    names nobody and is ignored; an id without a kind is refused.
    """
    assigneeKind: AssigneeKind
    assigneeId: ID
}

type UserToken {
    id: ID!
    "What it is for, in the words of whoever made it."
    name: String!
    "ISO-8601 offset date-time."
    createdAt: String!
    "Null until something uses it."
    lastUsedAt: String
}

"A token and its secret, which is returned exactly once."
type NewUserToken {
    token: UserToken!
    secret: String!
}

input UserInput {
    "Only read when creating; a username is who somebody is, not a field to edit."
    username: String
    displayName: String
    roleIds: [ID!]
}

"What a configuration check concluded."
enum DoctorVerdict {
    OK
    "Works, but is probably not what was meant."
    WARN
    "Something is going to fail, and it is worth fixing before it does."
    FAIL
}

type DoctorCheck {
    name: String!
    verdict: DoctorVerdict!
    "One sentence: what is true, and what to do where something is not."
    detail: String!
}
