# Documents: rich text written in the Design perspective, in pages, filed in
# catalogs, by hand in the editor and by a chat model through the orknux_*
# document tools. Anybody who can see the workspace.

extend type Query {
    "A workspace's document catalogs, by name."
    documentCatalogs(workspaceId: ID!): [DocumentCatalog!]!
    "A workspace's documents, the one worked on last first; in one catalog, or holding some words in the name or the text."
    documents(workspaceId: ID!, catalogId: ID, search: String): [DesignDocument!]!
    "One document; null where there is none."
    document(id: ID!): DesignDocument
    "Documents holding some words, each with the words around where they were found; names that match first."
    searchDocuments(workspaceId: ID!, text: String!, limit: Int): [DocumentHit!]!
    """
    How the sentence being written at the caret might go on, from the
    workspace's completion model: only the words that would follow `before`.
    `after` is what follows the caret and `page` the page it is on, from 1.
    Null where there is nothing to suggest. Nothing is written.
    """
    documentCompletion(id: ID!, before: String!, after: String, page: Int): String
    "The page a new document in the workspace starts on: A3, A4, A5, LETTER or LEGAL."
    documentPageSizeDefault(workspaceId: ID!): String!
}

"A document's page as laid out, in millimetres."
type DocumentPage {
    "Its width, turned the way it is."
    widthMm: Float!
    heightMm: Float!
    "The white round the text, each side."
    marginMm: Float!
}

extend type Mutation {
    createDocumentCatalog(workspaceId: ID!, name: String!): DocumentCatalog!
    renameDocumentCatalog(id: ID!, name: String!): DocumentCatalog!
    "Refused while the catalog holds documents."
    deleteDocumentCatalog(id: ID!): Boolean!
    """
    Makes a document, empty or holding `content` (ProseMirror JSON). Without a
    catalog it is filed in the workspace's first, which is made if there is none.
    `pageSize` is A4, the default, or LETTER.
    """
    createDocument(workspaceId: ID!, catalogId: ID, name: String!, content: String, pageSize: String): DesignDocument!
    renameDocument(id: ID!, name: String!): DesignDocument!
    "Files a document in another catalog of its workspace."
    moveDocument(id: ID!, catalogId: ID!): DesignDocument!
    """
    Writes a whole document over the one held. With `revision`, refused when the
    document has been saved since that revision - by somebody else or by a model.
    """
    saveDocument(
        id: ID!, content: String!, revision: Int,
        "A3, A4, A5, LETTER or LEGAL; left as it is when not given, as are the settings after it."
        pageSize: String,
        "PORTRAIT or LANDSCAPE."
        orientation: String,
        "NORMAL, NARROW or WIDE."
        margins: String,
        "en or pl; empty is the reader's own."
        language: String
    ): DesignDocument!
    "Sets the page a new document in the workspace starts on; its administrators'."
    setDocumentPageSizeDefault(workspaceId: ID!, pageSize: String!): String!
    deleteDocument(id: ID!): Boolean!
    """
    Asks a chat model to write in the document: the conversation so far, oldest
    first, ending with what is asked now. Whatever it writes is saved as it goes.
    """
    askDocument(
        id: ID!, modelId: ID!, messages: [DocumentChatTurnInput!]!,
        "True to ask about the document rather than in it - Explain, Summarise: the model is offered only the tools that read it, and nothing is saved."
        readOnly: Boolean
    ): DocumentAnswer!
    """
    A selection of the document put into another language by a chat model, and
    answered: nothing is written, the editor puts it in place of the selection.
    `language` is en, pl, de, fr, es, it, pt, nl, cs or uk; `before` and `after`
    are the words around the selection, sent as context.
    """
    translateDocumentText(id: ID!, modelId: ID!, text: String!, language: String!, before: String, after: String): String!
    """
    Reads a file into the document's vocabulary - PDF, Markdown (or Export's
    zip of it), ODT, DOCX, HTML or text - for the editor to put on the page,
    in place of what is there or at the caret. Nothing is saved: the import is
    an unsaved change like any other. The pictures it carries are kept as
    Design pictures of the workspace. `file` is base64 or a data URL.
    """
    importDocumentFile(id: ID!, filename: String!, file: String!): DocumentImport!
}

"What a model said, and the document as it stands after it."
type DocumentAnswer {
    answer: String!
    "Whether it saved anything."
    changed: Boolean!
    document: DesignDocument!
}

"One turn of the editor's conversation."
input DocumentChatTurnInput {
    "user or assistant."
    role: String!
    content: String!
    "Files uploaded to the attachments endpoint and sent with this turn: pictures go to the model as pictures, other files as their text."
    attachmentIds: [ID!]
}

"A folder of documents."
type DocumentCatalog {
    id: ID!
    workspaceId: ID!
    name: String!
    documentCount: Int!
    createdBy: String!
    "ISO-8601."
    createdAt: String!
}

"A document and its content."
type DesignDocument {
    id: ID!
    workspaceId: ID!
    catalogId: ID!
    catalogName: String!
    name: String!
    """
    The content, as ProseMirror JSON: {"type":"doc","content":[...]}. A picture
    is an image node naming its artifact (attrs.artifact, such as DESIGN-12);
    a pageBreak node starts a new page.
    """
    content: String!
    "A3, A4, A5, LETTER or LEGAL."
    pageSize: String!
    "PORTRAIT or LANDSCAPE."
    orientation: String!
    "NORMAL, NARROW or WIDE."
    margins: String!
    "en or pl, what its grammar is checked in; null is the reader's own."
    language: String
    page: DocumentPage!
    "Counts the saves; what saveDocument is checked against."
    revision: Int!
    words: Int!
    "The first words, on one line."
    excerpt: String!
    "The artifact ids of the pictures it shows."
    images: [String!]!
    createdBy: String!
    "ISO-8601."
    createdAt: String!
    updatedBy: String!
    "ISO-8601."
    updatedAt: String!
}

"A document a search found."
type DocumentHit {
    document: DesignDocument!
    "The words around where it was found, on one line."
    snippet: String!
}

"A file read into a document, not yet on its page."
type DocumentImport {
    "ProseMirror JSON, checked as a save is."
    content: String!
    "What it was read as: PDF, Markdown, ODT, DOCX, HTML or Text."
    format: String!
    "How many pictures it brought, now Design pictures of the workspace."
    pictures: Int!
    "How many it carried that were not kept."
    picturesLeftOut: Int!
}
