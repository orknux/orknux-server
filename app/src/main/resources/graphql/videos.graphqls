# Design's Videos page. Issue #658.

extend type Query {
    """
    What one VIDEO model takes beyond a prompt, asked of its server now: only
    these may be sent with a video. Empty with a reason where the server could
    not be asked or makes no video.
    """
    designVideoSettings(workspaceId: ID!, modelId: ID!): DesignVideoSettings!
    "This workspace's videos, newest first: made, on their way, failed or stopped."
    designVideos(workspaceId: ID!, search: String, catalogId: ID): [DesignVideo!]!
    "One video, in whatever state it is; null for one not here."
    designVideo(workspaceId: ID!, id: ID!): DesignVideo
}

extend type Mutation {
    """
    Queues a video to be made by one video model, and answers at once; it is
    made in turn and kept on Design's Videos page. Refused where the model is
    not a video model of this workspace, a setting is one it does not take, or
    the installation keeps no attachments.
    """
    queueDesignVideo(input: QueueDesignVideoInput!): DesignVideo!
    """
    Queues a finished video to be made larger by an UPSCALE model: every frame
    through the model's Stable Diffusion WebUI, put back together at the same
    rate with its sound. Kept as a new version; the video stays as it was. Waits
    in the image queue, under the same limit as pictures. Refused where the
    video is not finished or the result would be larger than the installation
    allows.
    """
    queueDesignVideoUpscale(input: UpscaleDesignVideoInput!): DesignVideo!
    "Stops a video waiting or being made; nothing is kept of it."
    stopDesignVideo(workspaceId: ID!, id: ID!): DesignVideo!
    "Takes a video off the page, its file with it. Refused for one being made."
    removeDesignVideo(workspaceId: ID!, id: ID!): Boolean!
    """
    Converts a finished video to another format - a GIF without its sound, an
    MP4 or an MKV with it - and answers where to download it. Converted now,
    while the caller waits; refused for a video not finished, or an export
    over the installation's time or size limit.
    """
    exportDesignVideo(workspaceId: ID!, id: ID!, format: DesignVideoExportFormat!): DesignVideoExport!
}

"How a video setting is asked for."
enum VideoSettingKind {
    "One of choices."
    CHOICE
    "A whole number between least and most."
    NUMBER
    "A picture of the workspace's, sent as the first frame."
    PICTURE
}

"One thing a video model takes beyond the prompt."
type DesignVideoSetting {
    "seconds, size, frames, fps, width, height, seed or startImage."
    name: String!
    kind: VideoSettingKind!
    "What a CHOICE may be, as the server spells it."
    choices: [String!]!
    "A NUMBER's bounds, as text: a seed is wider than an Int."
    least: String
    most: String
    "What the server uses when it is left out, where it says."
    preset: String
}

type DesignVideoSettings {
    settings: [DesignVideoSetting!]!
    "Why nothing could be learnt, where nothing could."
    reason: String
}

enum DesignVideoStatus {
    QUEUED
    GENERATING
    DONE
    FAILED
    "Stopped by somebody while it waited or was made: neither made nor failed."
    STOPPED
}

"A video asked for on Design's Videos page, and where it is on its way to being made."
type DesignVideo {
    id: ID!
    status: DesignVideoStatus!
    name: String!
    prompt: String!
    "Null once that model is removed; model still names it."
    modelId: ID
    model: String!
    seconds: Int
    "WIDTHxHEIGHT, for a server that takes a size as one word."
    size: String
    frames: Int
    fps: Int
    width: Int
    height: Int
    seed: String
    "The picture it starts from, by its artifact id."
    startImageId: ID
    startImageUrl: String
    requestedBy: String!
    requestedAt: String!
    startedAt: String
    finishedAt: String
    "Why it was not made, on a FAILED one."
    reason: String
    "How far it has got, in percent, where its server says."
    progress: Int
    "Whether progress counts only the sampling steps, as stable-diffusion.cpp's does: the decode after the last step is not in it."
    progressSamplingOnly: Boolean!
    "This server's clock when the video was read, to count from startedAt on the same clock."
    asOf: String!
    "How many queued videos are made before this one; null unless QUEUED."
    ahead: Int
    "The file, once DONE."
    url: String
    "A picture to show before it plays, where there is one."
    posterUrl: String
    contentType: String
    sizeBytes: Int
    durationSeconds: Float
    "The video this is a version of; null for one a video model made."
    versionOf: ID
    "The video an upscale took its frames from; null for anything else."
    upscaledFrom: ID
    "The WebUI's algorithm an upscale uses; null for the model's own."
    upscaler: String
    "How many times larger an upscale makes it."
    scale: Float
    "How many of an upscale's frames are done, of framesTotal; null until they are counted."
    framesDone: Int
    framesTotal: Int
}

"A video to make on Design's Videos page, straight from one video model. Each setting is one designVideoSettings names, or left out."
input QueueDesignVideoInput {
    workspaceId: ID!
    "A VIDEO model of this workspace."
    modelId: ID!
    prompt: String!
    "Null or blank names it after its prompt's first words."
    name: String
    seconds: Int
    size: String
    frames: Int
    fps: Int
    width: Int
    height: Int
    "A whole number, as text."
    seed: String
    "A picture of the workspace's to start from, by its artifact id."
    startImageId: ID
}

"A finished video to make larger, frame by frame, through an UPSCALE model's WebUI."
input UpscaleDesignVideoInput {
    workspaceId: ID!
    "A finished video of this workspace."
    videoId: ID!
    "An UPSCALE model of this workspace."
    modelId: ID!
    "One of the WebUI's algorithms, as designUpscaleAlgorithms names them; null or blank is the model's own."
    algorithm: String
    "How many times larger, 1 to 8."
    scale: Float!
}

"What a finished video may be exported as."
enum DesignVideoExportFormat {
    "An animated GIF, without sound, in a palette made for the video."
    GIF
    "H.264 and AAC in an MP4."
    MP4
    "H.264 and AAC in a Matroska file."
    MKV
}

"A video converted for download."
type DesignVideoExport {
    "Where the file is downloaded from, as an attachment named after the video."
    url: String!
    filename: String!
    contentType: String!
    "In bytes; a Float, since an Int stops at 2 GB."
    sizeBytes: Float!
}
